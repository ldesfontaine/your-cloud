# Production
# ---------------------------------------------------------------------------


def produce(output_dir: Path, *, force: bool) -> dict[str, str]:
    """Produit les quatre artefacts déterministes dans un répertoire vide."""

    if output_dir.exists() and not output_dir.is_dir():
        fail(f"{output_dir} exists and is not a directory")
    if output_dir.is_dir():
        existing = sorted(entry.name for entry in output_dir.iterdir())
        if existing and not force:
            fail(
                f"{output_dir} is not empty ({', '.join(existing[:5])}); refusing "
                "to overwrite silently. Pass --force to produce into it anyway."
            )

    # Tout est lu et assemblé avant qu'un octet ne soit écrit : un refus ne
    # laisse ni fichier partiel, ni répertoire créé pour rien.
    revision = read_revision()
    toolchains = read_toolchains()
    path = module_path()
    sbom = build_sbom(revision, path)
    provenance = build_provenance(revision, toolchains)

    output_dir.mkdir(parents=True, exist_ok=True)

    # L'ordre est celui des dépendances d'empreinte : le SBOM et la provenance
    # d'abord, le manifeste qui les empreint, puis les sommes qui empreignent
    # le manifeste.
    write_json(output_dir / SBOM_NAME, sbom)
    write_json(output_dir / PROVENANCE_NAME, provenance)
    write_json(
        output_dir / MANIFEST_NAME,
        build_manifest(
            revision,
            {
                SBOM_NAME: output_dir / SBOM_NAME,
                PROVENANCE_NAME: output_dir / PROVENANCE_NAME,
            },
        ),
    )
    write_checksums(
        output_dir / CHECKSUMS_NAME,
        output_dir,
        (MANIFEST_NAME, PROVENANCE_NAME, SBOM_NAME),
    )
    return revision


def command_produce(arguments: argparse.Namespace) -> int:
    output_dir = Path(arguments.output_dir).resolve()
    revision = produce(output_dir, force=arguments.force)
    print(f"REVISION={revision['id']}")
    print(f"TREE={revision['tree']}")
    for name in PRODUCED:
        print(f"{name.upper().replace('.', '_')}={output_dir / name}")
    if revision["tree"] == "modified":
        print(
            "\nLIMIT: these artifacts name an unpublished tree. `+worktree` names "
            "a state no one else can fetch, and closes no line of the palier.",
            file=sys.stderr,
        )
    return 0


def command_check_determinism(arguments: argparse.Namespace) -> int:
    """Produit deux fois et compare octet pour octet, puis vérifie au tiers.

    La preuve de déterminisme n'est pas une intention écrite dans un commentaire :
    elle est cette commande, et elle échoue si un seul octet diffère.
    """

    workspace = Path(tempfile.mkdtemp(prefix="release-artifacts-determinism-"))
    keep = bool(arguments.keep)
    try:
        first, second = workspace / "run-1", workspace / "run-2"
        produce(first, force=False)
        produce(second, force=False)

        left = sorted(entry.name for entry in first.iterdir())
        right = sorted(entry.name for entry in second.iterdir())
        print(f"run-1: {first}")
        print(f"run-2: {second}")
        if left != right:
            print(f"FAILED: the two runs produced different files: {left} vs {right}")
            return 1
        differing = [
            name
            for name in left
            if (first / name).read_bytes() != (second / name).read_bytes()
        ]
        for name in left:
            state = "differs" if name in differing else "identical"
            print(f"  {name:<18} {state}  {digest_file(first / name)}")
        if differing:
            print(f"FAILED: {', '.join(differing)} differ between two runs")
            return 1
        print("DETERMINISM=identical (byte for byte, both runs)")

        # La vérification par un tiers n'est pas une promesse : elle est le
        # même outil du commerce qu'un tiers utiliserait, exécuté ici.
        if shutil.which("sha256sum") is None:
            print("THIRD-PARTY=not run (sha256sum is absent from this host)")
            return 1
        completed = subprocess.run(
            ("sha256sum", "-c", CHECKSUMS_NAME),
            cwd=first,
            env=dict(os.environ, LC_ALL="C", LANG="C"),
            capture_output=True,
            text=True,
            check=False,
        )
        sys.stdout.write(completed.stdout)
        if completed.returncode != 0:
            sys.stderr.write(completed.stderr)
            print(f"FAILED: sha256sum -c {CHECKSUMS_NAME} refused the artifacts")
            return 1
        print(f"THIRD-PARTY=sha256sum -c {CHECKSUMS_NAME} passed")
        return 0
    finally:
        if keep:
            print(f"kept: {workspace}")
        else:
            shutil.rmtree(workspace, ignore_errors=True)


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(
        prog="release-artifacts",
        description=(
            "Produit les artefacts vérifiables de la révision courante, sans "
            "réseau et sans horodatage."
        ),
    )
    subcommands = parser.add_subparsers(dest="command", required=True)

    produce_parser = subcommands.add_parser(
        "produce",
        help="écrit manifest.json, checksums.txt, sbom.json et provenance.json",
    )
    produce_parser.add_argument("output_dir", help="répertoire de sortie, vide")
    produce_parser.add_argument(
        "--force",
        action="store_true",
        help="autorise un répertoire non vide ; sans lui, la production refuse",
    )
    produce_parser.set_defaults(handler=command_produce)

    determinism_parser = subcommands.add_parser(
        "check-determinism",
        help="produit deux fois, compare octet pour octet, vérifie au sha256sum",
    )
    determinism_parser.add_argument(
        "--keep", action="store_true", help="conserve les deux répertoires produits"
    )
    determinism_parser.set_defaults(handler=command_check_determinism)

    arguments = parser.parse_args(argv)
    try:
        return int(arguments.handler(arguments))
    except Refusal as refusal:
        print(f"FAILED: {refusal}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
