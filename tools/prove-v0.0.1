#!/usr/bin/env bash
# Orchestrate the complete v0.0.1 proof; product execution stays inside the LAB.
set -euo pipefail

[[ $# -eq 0 ]] || { echo "usage: prove-v0.0.1" >&2; exit 2; }
root=$(cd -- "$(dirname -- "$0")/.." && pwd)
labctl="$root/tools/labctl"
workdir=$(mktemp -d)
archive="$workdir/your-cloud-v0.0.1-src.tgz"
local_artifact="$workdir/your-cloud"
remote_source=/tmp/your-cloud-v0.0.1-src
remote_archive=/tmp/your-cloud-v0.0.1-src.tgz
remote_deploy=/tmp/your-cloud-v0.0.1
remote_artifact=/tmp/your-cloud-v0.0.1-artifact
relay_url=http://192.168.242.103:8443
relay_listen=192.168.242.103:8443
targets=(lab-coordinateur lab-machine-1 lab-machine-2)
mutated=0

step() { printf '\n==> %s\n' "$1"; }
fail() { echo "FAILED: $*" >&2; exit 1; }

finish() {
  local status=$? cleanup_failed=0 target
  trap - EXIT
  set +e
  if [[ $status -ne 0 && $mutated -eq 1 ]]; then
    echo "Proof failed after mutation; selecting and verifying the absent state" >&2
    for target in "${targets[@]}"; do
      if "$labctl" ssh "$target" test -x "$remote_deploy/remove-agent"; then
        "$labctl" ssh "$target" "$remote_deploy/remove-agent" || cleanup_failed=1
        "$labctl" ssh "$target" "$remote_deploy/assert-agent-runtime" absent || cleanup_failed=1
      else
        cleanup_failed=1
      fi
    done
  fi
  for target in "${targets[@]}"; do
    "$labctl" ssh "$target" /bin/rm -rf "$remote_deploy" "$remote_artifact" \
      || cleanup_failed=1
  done
  "$labctl" ssh lab-console /bin/rm -rf "$remote_source" "$remote_archive" \
    || cleanup_failed=1
  /bin/rm -rf "$workdir" || cleanup_failed=1
  if [[ $cleanup_failed -ne 0 ]]; then
    echo "LAB temporary cleanup or final-state verification failed" >&2
    exit 1
  fi
  exit "$status"
}
trap finish EXIT

step "Read-only LAB inventory guard"
inventory=$("$labctl" list --format=tsv) || fail "labctl list guard failed"
printf '%s\n' "$inventory"

require_vm() {
  local name=$1 expected_template=$2 row state ips template topology origin
  row=$(awk -F '\t' -v name="$name" 'NR > 1 && $1 == name {print}' <<<"$inventory")
  [[ -n "$row" && $(wc -l <<<"$row") -eq 1 ]] || fail "inventory row missing or duplicated for $name"
  IFS=$'\t' read -r _ state ips template topology origin <<<"$row"
  [[ "$state" == running ]] || fail "$name is not running"
  [[ "$ips" != - && -n "$ips" ]] || fail "$name has no LAB address"
  [[ "$template" == "$expected_template" && "$topology" == v1-full \
    && "$origin" == your-cloud/labctl ]] \
    || fail "$name is outside the approved v1-full inventory"
  [[ ",$ips," != *",192.168.122.123,"* && ",$ips," != *",10.66.66.1,"* ]] \
    || fail "$name resolves to a forbidden address"
}

require_vm lab-gateway passerelle
require_vm lab-console console
require_vm lab-coordinateur coordinateur
require_vm lab-machine-1 machine
require_vm lab-machine-2 machine
coordinateur_row=$(awk -F '\t' '$1 == "lab-coordinateur" {print $3}' <<<"$inventory")
[[ "$coordinateur_row" == 192.168.242.103 ]] \
  || fail "v0.0.1 Relay address drifted: $coordinateur_row"

revision=$(git -C "$root" rev-parse HEAD)
source_id=$revision
if ! git -C "$root" diff --quiet \
  || ! git -C "$root" diff --cached --quiet \
  || [[ -n $(git -C "$root" ls-files --others --exclude-standard) ]]; then
  source_id="$revision+worktree"
fi
printf 'source_revision=%s\n' "$source_id"

step "Package the complete non-sensitive source lot"
tar -C "$root" \
  --exclude='./.git' --exclude='./.agents' --exclude='./.codex' \
  --exclude='./.claude' --exclude='./.cursor' \
  --exclude='./AGENTS.md' --exclude='./AGENTS.proposal.md' \
  --exclude='./CLAUDE.md' --exclude='./keys.txt' \
  --exclude='./dist' --exclude='./build' \
  -czf "$archive" .
if tar -tzf "$archive" | grep -Eq '(^|/)(keys\.txt|\.git|\.agents|\.codex|\.claude|\.cursor)(/|$)'; then
  fail "source lot contains a forbidden local or sensitive path"
fi
source_sha=$(sha256sum "$archive"); source_sha=${source_sha%% *}
printf 'source_lot_sha256=%s\n' "$source_sha"

"$labctl" ssh lab-console /bin/rm -rf "$remote_source" "$remote_archive"
"$labctl" copy-to lab-console "$archive" "$remote_archive"
"$labctl" ssh lab-console mkdir -p "$remote_source"
"$labctl" ssh lab-console tar -xzf "$remote_archive" -C "$remote_source"

step "Single source-side gate and build in lab-console"
"$labctl" ssh lab-console "$remote_source/tools/test-v0.0.1"
"$labctl" copy-from lab-console "$remote_source/dist/your-cloud" "$local_artifact"
[[ -f "$local_artifact" && -x "$local_artifact" ]] || fail "LAB artifact was not retrieved"
artifact_sha=$(sha256sum "$local_artifact"); artifact_sha=${artifact_sha%% *}
printf 'artifact_sha256=%s\n' "$artifact_sha"

step "Prepare the three v1-full targets"
for target in "${targets[@]}"; do
  "$labctl" ssh "$target" /bin/rm -rf "$remote_deploy" "$remote_artifact"
  "$labctl" copy-to "$target" "$root/deploy/v0.0.1" "$remote_deploy"
  "$labctl" copy-to "$target" "$local_artifact" "$remote_artifact"
  "$labctl" ssh "$target" chmod 0755 \
    "$remote_artifact" \
    "$remote_deploy/install-agent" "$remote_deploy/enable-relay" \
    "$remote_deploy/disable-relay" "$remote_deploy/remove-agent" \
    "$remote_deploy/prove-hostile-relay" \
    "$remote_deploy/assert-agent-runtime" "$remote_deploy/assert-relay-state"
done

mutated=1
step "Known absent starting state"
for target in "${targets[@]}"; do
  "$labctl" ssh "$target" "$remote_deploy/remove-agent"
  "$labctl" ssh "$target" "$remote_deploy/assert-agent-runtime" absent
done

step "Transactional refusal of an invalid first artifact"
if "$labctl" ssh lab-machine-1 "$remote_deploy/install-agent" \
  /bin/false lab-machine-1 "$relay_url"; then
  fail "invalid first artifact was reported as installed"
fi
"$labctl" ssh lab-machine-1 "$remote_deploy/assert-agent-runtime" absent

install_final_state() {
  "$labctl" ssh lab-coordinateur "$remote_deploy/install-agent" \
    "$remote_artifact" lab-coordinateur "$relay_url"
  "$labctl" ssh lab-coordinateur "$remote_deploy/enable-relay" "$relay_listen"
  "$labctl" ssh lab-machine-1 "$remote_deploy/install-agent" \
    "$remote_artifact" lab-machine-1 "$relay_url"
}

step "Install one artifact with isolated parallel roles"
install_final_state
"$labctl" ssh lab-coordinateur "$remote_deploy/assert-agent-runtime" daemon-relay
"$labctl" ssh lab-machine-1 "$remote_deploy/assert-agent-runtime" daemon
"$labctl" ssh lab-machine-2 "$remote_deploy/assert-agent-runtime" absent
"$labctl" ssh lab-coordinateur "$remote_deploy/assert-relay-state" \
  lab-coordinateur=recent lab-machine-1=recent

remote_hash() {
  local output
  output=$("$labctl" ssh "$1" sha256sum /usr/local/lib/your-cloud/your-cloud) \
    || return
  printf '%s\n' "${output%% *}"
}
[[ $(remote_hash lab-coordinateur) == "$artifact_sha" \
  && $(remote_hash lab-machine-1) == "$artifact_sha" ]] \
  || fail "deployed artifacts do not match the LAB build"

step "Reject Relay activation on the non-candidate machine"
if "$labctl" ssh lab-machine-1 /usr/local/lib/your-cloud/your-cloud \
  relay --listen="$relay_listen"; then
  fail "non-candidate machine accepted the Relay role"
fi
"$labctl" ssh lab-machine-1 "$remote_deploy/assert-agent-runtime" daemon

step "Live hostile POST and QUERY matrix"
"$labctl" ssh lab-coordinateur "$remote_deploy/prove-hostile-relay" "$relay_url"

step "Presence transitions and independent restarts"
"$labctl" ssh lab-machine-1 systemctl stop your-cloud-daemon.service
"$labctl" ssh lab-coordinateur "$remote_deploy/assert-relay-state" \
  lab-coordinateur=recent lab-machine-1=old
"$labctl" ssh lab-machine-1 systemctl start your-cloud-daemon.service
"$labctl" ssh lab-coordinateur "$remote_deploy/assert-relay-state" \
  lab-coordinateur=recent lab-machine-1=recent

"$labctl" ssh lab-coordinateur systemctl stop your-cloud-daemon.service
"$labctl" ssh lab-machine-1 systemctl stop your-cloud-daemon.service
"$labctl" ssh lab-coordinateur systemctl restart your-cloud-relay.service
"$labctl" ssh lab-coordinateur "$remote_deploy/assert-relay-state" \
  lab-coordinateur=absent lab-machine-1=absent
"$labctl" ssh lab-coordinateur systemctl start your-cloud-daemon.service
"$labctl" ssh lab-machine-1 systemctl start your-cloud-daemon.service
"$labctl" ssh lab-coordinateur "$remote_deploy/assert-relay-state" \
  lab-coordinateur=recent lab-machine-1=recent

"$labctl" ssh lab-coordinateur systemctl restart your-cloud-daemon.service
"$labctl" ssh lab-machine-1 systemctl restart your-cloud-daemon.service
"$labctl" ssh lab-coordinateur "$remote_deploy/assert-agent-runtime" daemon-relay
"$labctl" ssh lab-machine-1 "$remote_deploy/assert-agent-runtime" daemon

step "Transactional rollback after an invalid shared artifact"
before_rollback_hash=$(remote_hash lab-coordinateur)
if "$labctl" ssh lab-coordinateur "$remote_deploy/install-agent" \
  /bin/false lab-coordinateur "$relay_url"; then
  fail "invalid replacement artifact was reported as installed"
fi
[[ $(remote_hash lab-coordinateur) == "$before_rollback_hash" ]] \
  || fail "transactional rollback did not restore the artifact"
"$labctl" ssh lab-coordinateur "$remote_deploy/assert-agent-runtime" daemon-relay
"$labctl" ssh lab-coordinateur "$remote_deploy/assert-relay-state" \
  lab-coordinateur=recent lab-machine-1=recent

step "Independent Relay disable and re-enable"
"$labctl" ssh lab-coordinateur "$remote_deploy/disable-relay"
"$labctl" ssh lab-coordinateur "$remote_deploy/assert-agent-runtime" daemon
"$labctl" ssh lab-coordinateur "$remote_deploy/enable-relay" "$relay_listen"
"$labctl" ssh lab-coordinateur "$remote_deploy/assert-agent-runtime" daemon-relay
"$labctl" ssh lab-coordinateur "$remote_deploy/assert-relay-state" \
  lab-coordinateur=recent lab-machine-1=recent

step "Complete removal and verified absence"
for target in "${targets[@]}"; do
  "$labctl" ssh "$target" "$remote_deploy/remove-agent"
  "$labctl" ssh "$target" "$remote_deploy/assert-agent-runtime" absent
done

step "Reinstall the documented final state"
install_final_state
"$labctl" ssh lab-coordinateur "$remote_deploy/assert-agent-runtime" daemon-relay
"$labctl" ssh lab-machine-1 "$remote_deploy/assert-agent-runtime" daemon
"$labctl" ssh lab-machine-2 "$remote_deploy/assert-agent-runtime" absent
"$labctl" ssh lab-coordinateur "$remote_deploy/assert-relay-state" \
  lab-coordinateur=recent lab-machine-1=recent
[[ $(remote_hash lab-coordinateur) == "$artifact_sha" \
  && $(remote_hash lab-machine-1) == "$artifact_sha" ]] \
  || fail "final installed artifacts do not match the LAB build"

printf '\nPASS: complete v0.0.1 proof; final state installed; source=%s artifact=%s\n' \
  "$source_id" "$artifact_sha"
