#!/usr/bin/env bash
# Provision the `quick` topology's machines with the toolchains this palier needs.
#
# `labctl topology create` gives bare Debian machines. Everything the proofs
# compile with is installed here, and a topology destroyed by a closure is
# reprovisioned by re-running this — which is the whole reason it exists as a
# file rather than as a paragraph someone has to retype.
#
# **The versions are not written here.** They are read from the hosted gate's
# own workflow, so a LAB machine and a hosted runner cannot drift apart. A
# recipe that repeated the numbers would be a second place to update, and the
# one that gets forgotten is always the one nobody runs.
#
# Every step is idempotent: what is already in place is left alone and named as
# such. Nothing here is a proof — it is the ground a proof stands on.
set -euo pipefail
export LC_ALL=C.UTF-8

usage() {
  cat >&2 <<'EOF'
usage: provision-lab [lab-console | lab-machine-1 | lab-vps | all]

  lab-console    swap, GTK build dependencies, the pinned Rust, Node and
                 tauri-driver toolchains, and the warmed cargo and npm caches
  lab-machine-1  the pinned Go toolchain and the rootless container ground
  lab-vps        the same ground plus slirp4netns, for the public profile
  all            the three above, in that order (default)

The machines must already exist and be running:

  tools/labctl topology create quick
EOF
  exit 2
}

target=${1:-all}
[[ $# -le 1 ]] || usage
case "$target" in
  lab-console | lab-machine-1 | lab-vps | all) ;;
  *) usage ;;
esac

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
labctl="$root/tools/labctl"
workflow="$root/.github/workflows/ci.yml"
expected_origin=your-cloud/labctl
swap_bytes=4G

fail() { echo "FAILED: $*" >&2; exit 1; }
step() { printf '\n==> %s\n' "$*"; }
note() { printf '  %-46s %s\n' "$1" "$2"; }

[[ -f "$workflow" ]] || fail "the hosted gate's workflow is absent: $workflow"

# The single source of truth for both toolchains. A version that cannot be read
# is a hard stop: guessing one would provision a LAB that proves something about
# a compiler the gate never runs.
rust_version=$(sed -n 's/^ *RUSTUP_TOOLCHAIN: *"\([0-9.]*\)".*/\1/p' "$workflow" | head -1)
go_version=$(sed -n 's/^ *go-version: *"\([0-9.]*\)".*/\1/p' "$workflow" | head -1)
node_version=$(sed -n 's/^ *node-version: *"\([0-9.]*\)".*/\1/p' "$workflow" | head -1)
tauri_driver_version=$(sed -n 's/.*install tauri-driver --version \([0-9.]*\).*/\1/p' "$workflow" | head -1)
[[ "$rust_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] \
  || fail "cannot read the pinned Rust toolchain from the workflow"
[[ "$go_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] \
  || fail "cannot read the pinned Go toolchain from the workflow"
[[ "$node_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] \
  || fail "cannot read the pinned Node toolchain from the workflow"
[[ "$tauri_driver_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] \
  || fail "cannot read the pinned tauri-driver from the workflow"

# The mandatory inventory guard: read the LAB before mutating any of it.
guard() {
  local vm=$1 line state ips template topology origin
  line=$("$labctl" list --format=tsv | awk -v vm="$vm" -F'\t' '$1 == vm')
  [[ -n "$line" ]] || fail "$vm is not part of the LAB inventory"
  IFS=$'\t' read -r _ state ips template topology origin <<<"$line"
  [[ "$origin" == "$expected_origin" ]] || fail "$vm carries the origin $origin"
  [[ "$state" == running ]] || fail "$vm is $state"
  [[ "$topology" == quick ]] || fail "$vm belongs to the topology $topology"
  [[ "$ips" != *,* ]] || fail "$vm holds several addresses: $ips"
  [[ "$ips" != 192.168.122.123 && "$ips" != 10.66.66.1 ]] \
    || fail "$vm holds an address this project never mutates"
}

remote() { "$labctl" ssh "$1" -- "$2"; }

provision_console() {
  step "lab-console — swap, GTK build dependencies, Rust $rust_version, Node $node_version"
  guard lab-console

  # The crate depends on `gtk`, whose compilation is killed by the OOM reaper
  # with this machine's memory. The swapfile is deliberately left out of
  # `/etc/fstab`: `tests/lab/v0.1.0/prove` re-enables it after every start, and
  # that path stays exercised rather than becoming dead code.
  if remote lab-console "test -f /swapfile"; then
    note swapfile "already present"
  else
    remote lab-console "fallocate -l $swap_bytes /swapfile && chmod 600 /swapfile \
      && mkswap /swapfile >/dev/null"
    note swapfile "created ($swap_bytes)"
  fi
  if [[ -z "$(remote lab-console 'swapon --noheadings --show' || true)" ]]; then
    remote lab-console "swapon /swapfile"
    note swap "enabled"
  else
    note swap "already enabled"
  fi

  # The guard names the newest dependency, not the first one: a machine
  # provisioned before the list grew passes the old guard and would silently
  # keep its old surface, which is exactly the drift this file exists to
  # prevent.
  if remote lab-console "test -x /usr/bin/patchelf"; then
    note "build dependencies" "already installed"
  else
    # The WebKit and rsvg lines are what the console crate itself links
    # against; without them only the Assistant crate compiles here, and the
    # console crate's own tests have no ground to run on.
    #
    # The display server and its two probes are here for a reason that took a
    # destroyed topology to see. An earlier reading of this file kept them out,
    # on the grounds that a virtual screen belongs to a hosted runner and not to
    # a compilation ground. That was wrong about what this machine does: the
    # personal-access proof opens the product's own native window and drives it,
    # so `xvfb-run` is not a runner's convenience here but the floor that proof
    # stands on. A topology alive for days had them from an earlier hand; the
    # first run from nothing stopped on `xvfb-run: command not found`.
    #
    # `webkit2gtk-driver` is the same WebDriver the hosted gate installs, and it
    # brings the engine the Linux Console actually paints with. The reflow proof
    # measures the frontend's geometry in that engine rather than in a second
    # one, because a layout that reflows in Chromium and not in WebKitGTK would
    # be a green that says nothing about the product.
    # `patchelf` is what the Tauri bundler runs on the binary it packages: the
    # reflow proof now builds the installable `.deb` on this machine, and a
    # bundling step that cannot rewrite the loader path stops the build.
    remote lab-console "DEBIAN_FRONTEND=noninteractive apt-get update -qq \
      && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \
        build-essential pkg-config libgtk-3-dev gdb \
        libwebkit2gtk-4.1-dev libayatana-appindicator3-dev librsvg2-dev \
        webkit2gtk-driver \
        xvfb dbus-x11 xdotool imagemagick lsof \
        patchelf \
        >/dev/null"
    note "build dependencies" "installed"
  fi
  # Each of these is named rather than assumed, because every one of them was
  # once present by an accident of history and absent from this recipe: `gdb`
  # because the secret-crash suite runs `gcore`, `xvfb-run` because the
  # personal-access proof drives a real native window, `xdotool` and `import`
  # because that proof probes and photographs it, `WebKitWebDriver` because the
  # reflow proof drives the frontend in the engine the product ships with.
  for tool in gdb xvfb-run xdotool import WebKitWebDriver patchelf; do
    remote lab-console "command -v $tool >/dev/null" \
      || fail "$tool is absent after installation"
  done

  # The Node toolchain the frontend builds with, pinned to the hosted gate's
  # own number for the same reason Rust and Go are. The reflow proof builds the
  # installable `.deb` on this machine, and that build begins with the
  # frontend: no Node, no candidate. Installed like Go: unpacked under
  # /usr/local, then linked where a plain ssh command looks.
  if remote lab-console "/usr/local/node/bin/node --version 2>/dev/null | grep -qx 'v$node_version'"; then
    note "Node $node_version" "already installed"
  else
    remote lab-console "curl -fsSL -o /tmp/node.txz \
        https://nodejs.org/dist/v$node_version/node-v$node_version-linux-x64.tar.xz \
      && rm -rf /usr/local/node /tmp/node-unpack \
      && install -d /tmp/node-unpack \
      && tar -C /tmp/node-unpack -xJf /tmp/node.txz \
      && mv /tmp/node-unpack/node-v$node_version-linux-x64 /usr/local/node \
      && rm -rf /tmp/node.txz /tmp/node-unpack"
    note "Node $node_version" "installed"
  fi
  remote lab-console "ln -sfn /usr/local/node/bin/node /usr/local/bin/node \
    && ln -sfn /usr/local/node/bin/npm /usr/local/bin/npm \
    && ln -sfn /usr/local/node/bin/npx /usr/local/bin/npx"
  remote lab-console "command -v node >/dev/null && command -v npm >/dev/null" \
    || fail "node is absent from the PATH of a plain command"
  note observed "$(remote lab-console 'node --version') / npm $(remote lab-console 'npm --version')"

  # The WebDriver bridge the installed-candidate measurement drives the `.deb`
  # with, pinned to the exact version the hosted gate installs. It is a cargo
  # install, so it uses the network here at provision time, exactly like rustup
  # above — never at proof time.
  # `tauri-driver` answers no `--version`; the version cargo installed is read
  # from cargo's own ledger instead.
  if remote lab-console ". /root/.cargo/env \
      && cargo install --list 2>/dev/null | grep -q '^tauri-driver v$tauri_driver_version:'"; then
    note "tauri-driver $tauri_driver_version" "already installed"
  else
    remote lab-console ". /root/.cargo/env \
      && cargo +$rust_version install tauri-driver --version $tauri_driver_version --locked --quiet"
    note "tauri-driver $tauri_driver_version" "installed"
  fi
  note observed "$(remote lab-console ". /root/.cargo/env && cargo install --list | grep '^tauri-driver '")"

  if remote lab-console ". /root/.cargo/env 2>/dev/null && cargo +$rust_version --version >/dev/null 2>&1"; then
    note "Rust $rust_version" "already installed"
  else
    remote lab-console "curl -fsSL https://sh.rustup.rs -o /root/rustup.sh \
      && sh /root/rustup.sh -y --profile minimal --default-toolchain $rust_version \
        --no-modify-path >/dev/null \
      && rm -f /root/rustup.sh"
    note "Rust $rust_version" "installed"
  fi
  note observed "$(remote lab-console ". /root/.cargo/env && cargo +$rust_version --version")"

  # The registry of crates the proofs build against, warmed here and not by the
  # proofs themselves.
  #
  # Every harness that compiles the console builds with `--offline`, so that the
  # build proves it pulls nothing from a network at the moment it runs. That
  # flag is worth having and it says nothing about where the crates came from:
  # they have to be on the machine already. Until the first complete proof, they
  # always were — a topology that had been alive for days carried a registry
  # warmed by an earlier build, and no one had to name it. The first run from a
  # topology really destroyed and recreated found the machine bare and stopped
  # on `no matching package named serde`, fifty-five seconds in.
  #
  # So the registry is ground, exactly like the toolchain above, and it is
  # placed by the recipe: the workspace is copied here, `cargo fetch --locked`
  # resolves it from the lock the repository versions, and the copy is removed.
  # What stays is `~/.cargo/registry`, which is what a later `--offline` build
  # reads.
  if remote lab-console "test -d /root/.cargo/registry/cache"; then
    note "crate registry" "already warmed"
  else
    local warm=/root/cargo-warm archive
    archive=$(mktemp -t provision-lab-workspace-XXXXXX.tgz)
    tar czf "$archive" -C "$root/console" --exclude=target --exclude=node_modules src-tauri
    remote lab-console "rm -rf $warm && install -d -m 0700 $warm"
    "$labctl" copy-to lab-console "$archive" /root/cargo-warm-workspace.tgz >/dev/null
    rm -f "$archive"
    remote lab-console "tar xzf /root/cargo-warm-workspace.tgz -C $warm \
      && rm -f /root/cargo-warm-workspace.tgz"
    remote lab-console ". /root/.cargo/env \
      && cd $warm/src-tauri \
      && cargo +$rust_version fetch --locked >/dev/null 2>&1"
    remote lab-console "rm -rf $warm"
    note "crate registry" "warmed from the versioned lock"
  fi
  note observed "$(remote lab-console "ls /root/.cargo/registry/cache/*/ | wc -l") crates cached"

  # The npm cache the frontend build reads, warmed here for the reason the
  # crate registry is: every harness that builds the candidate runs
  # `npm ci --offline`, so the build proves it pulls nothing from a network at
  # the moment it runs — which requires the packages to be on the machine
  # already. `npm ci` resolves them from the lock the repository versions into
  # `~/.npm`, the copy of the manifest is removed, and what stays is the cache
  # a later `--offline` install reads.
  if remote lab-console "test -d /root/.npm/_cacache"; then
    note "npm cache" "already warmed"
  else
    local npm_warm=/root/npm-warm
    remote lab-console "rm -rf $npm_warm && install -d -m 0700 $npm_warm"
    "$labctl" copy-to lab-console "$root/console/package.json" "$npm_warm/package.json" >/dev/null
    "$labctl" copy-to lab-console "$root/console/package-lock.json" "$npm_warm/package-lock.json" >/dev/null
    remote lab-console "cd $npm_warm \
      && npm ci --no-audit --no-fund --loglevel=error >/dev/null"
    remote lab-console "rm -rf $npm_warm"
    note "npm cache" "warmed from the versioned lock"
  fi
  note observed "$(remote lab-console "du -sh /root/.npm/_cacache 2>/dev/null | cut -f1") npm cache"
}

# ensure_go places the pinned toolchain a proof compiles the product with. It is
# written once and called by both container machines, because a second copy of
# these four lines is a second place a version could be read from.
ensure_go() {
  local vm=$1
  if remote "$vm" "/usr/local/go/bin/go version 2>/dev/null | grep -q 'go$go_version '"; then
    note "Go $go_version" "already installed"
  else
    remote "$vm" "curl -fsSL -o /tmp/go.tgz \
        https://go.dev/dl/go$go_version.linux-amd64.tar.gz \
      && rm -rf /usr/local/go \
      && tar -C /usr/local -xzf /tmp/go.tgz \
      && rm -f /tmp/go.tgz"
    note "Go $go_version" "installed"
  fi
  # The toolchain is placed where every shell looks, and not only where this
  # recipe put it.
  #
  # `go` unpacks under /usr/local/go/bin, which is on no default PATH. A command
  # run over ssh is neither a login shell nor an interactive one, so it reads no
  # profile: a harness that calls `go` plainly does not find it. The newer
  # harnesses export the path themselves; the older ones ask `command -v go` and
  # were answered, for months, by a line someone had added by hand to a machine
  # that has since been destroyed. Two links cost nothing and make the toolchain
  # findable by whoever asks, which is what installing it was supposed to mean.
  remote "$vm" "ln -sfn /usr/local/go/bin/go /usr/local/bin/go \
    && ln -sfn /usr/local/go/bin/gofmt /usr/local/bin/gofmt"
  remote "$vm" "command -v go >/dev/null" \
    || fail "go is absent from the PATH of a plain command on $vm"
  note observed "$(remote "$vm" '/usr/local/go/bin/go version')"
}

# ensure_container_ground places the packages a rootless managed service needs,
# and nothing beyond them.
#
# The caller passes the whole package list and the file that guards it, because
# the two machines do not ask the same thing of their engine and a guard that
# named a package common to both would let the wider machine keep the narrower
# surface. Each name below is a capability the Auxiliary asks for, and none of
# them is a dependency of the others — `apt-get` pulls the engine's own runtime
# (crun, conmon, netavark, passt, catatonit, fuse-overlayfs) by itself, while
# these had to be asked for:
#
#   podman             the engine `Capabilities` looks up and `PullImage` runs
#   uidmap             newuidmap/newgidmap, without which a rootless engine
#                      cannot map more than the account's own identifier
#   dbus-user-session  the per-account bus at $XDG_RUNTIME_DIR/bus, which is
#                      the address the Auxiliary hands `systemctl --user`
#   slirp4netns        the network stack the entrypoint's sheet names by hand in
#                      `Network=slirp4netns:allow_host_loopback=true`. Debian's
#                      podman recommends `passt` and would leave this one out,
#                      and the sheet does not fall back to pasta: an entrypoint
#                      on a machine without it fails to start rather than
#                      reaching the host loopback by another route.
#
# The guard always names the *newest* member of the list rather than the first:
# a machine provisioned before the list grew answers an older guard and would
# silently keep its older surface, which is exactly the drift this file exists
# to prevent.
ensure_container_ground() {
  local vm=$1 guard_file=$2
  shift 2
  local packages=("$@")
  if remote "$vm" "test -e $guard_file"; then
    note "rootless container ground" "already installed"
  else
    remote "$vm" "DEBIAN_FRONTEND=noninteractive apt-get update -qq \
      && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \
        ${packages[*]} \
        >/dev/null"
    note "rootless container ground" "installed"
  fi
  remote "$vm" "command -v podman >/dev/null" \
    || fail "podman is absent after installation on $vm"
  remote "$vm" "command -v newuidmap >/dev/null" \
    || fail "newuidmap is absent after installation on $vm"
  note observed "$(remote "$vm" 'podman --version')"
}

# ensure_passage_ground places what the two machines of the private passage need
# beyond the container ground, and says honestly which half of it is
# provisioning and which half was already there.
#
# Three things are separated on purpose, because they are not the same kind of
# claim:
#
#   the kernel     WireGuard is in-tree on Debian 13, so nothing installs it.
#                  What is verified is that the module is really there, because a
#                  machine whose kernel has no WireGuard describes an interface
#                  that never appears, and the proof would read that as a product
#                  failure instead of as a missing kernel;
#   the product    `nftables` and `procps` carry `/usr/sbin/nft` and
#                  `/usr/sbin/sysctl`, and the oneshot unit a junction writes
#                  names both by their absolute paths. Debian's cloud image
#                  already ships them, so this installs nothing on a stock
#                  machine — the two paths are checked rather than assumed,
#                  because an absolute path a unit names is a promise about the
#                  machine and not about a package;
#   the harness    `wireguard-tools` is the one package this really adds, and it
#                  is added for the *proof* rather than for the product. Keys are
#                  generated by the product with the standard library's own
#                  X25519 and never by shelling out to `wg`; what needs `wg` is
#                  the harness, which reads back the peer, its AllowedIPs and the
#                  latest handshake from the kernel rather than from the file the
#                  product wrote.
#
# The guard names the newest dependency, `/usr/bin/wg`, for the reason every
# other guard of this file does: a machine provisioned before the list grew would
# answer an older guard and silently keep its older surface.
ensure_passage_ground() {
  local vm=$1
  if remote "$vm" "test -x /usr/bin/wg"; then
    note "private passage ground" "already installed"
  else
    remote "$vm" "DEBIAN_FRONTEND=noninteractive apt-get update -qq \
      && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \
        nftables wireguard-tools \
        >/dev/null"
    note "private passage ground" "installed (nftables, wireguard-tools)"
  fi
  remote "$vm" "test -x /usr/sbin/nft" \
    || fail "/usr/sbin/nft is absent on $vm: the unit a junction writes names that exact path"
  remote "$vm" "test -x /usr/sbin/sysctl" \
    || fail "/usr/sbin/sysctl is absent on $vm: the unit a junction writes names that exact path"
  remote "$vm" "test -x /usr/bin/wg" \
    || fail "wg is absent after installation on $vm: the harness reads the kernel's peers with it"
  # The key a preparation writes is 0640 root:systemd-network, and a machine
  # without that group keeps 0600 and never brings the interface up. systemd
  # always ships the group; it is read back rather than assumed, because the
  # whole mode decision of the contract's addendum rests on it.
  remote "$vm" "getent group systemd-network >/dev/null" \
    || fail "the systemd-network group is absent on $vm: the passage key could not be read by the network manager"
  remote "$vm" "modinfo wireguard >/dev/null 2>&1" \
    || fail "this kernel of $vm carries no WireGuard module"
  note observed "$(remote "$vm" '/usr/sbin/nft --version; /usr/bin/wg --version; getent group systemd-network' | paste -sd' ' -)"
}

provision_machine() {
  step "lab-machine-1 — Go $go_version, rootless container ground, passage ground"
  guard lab-machine-1
  ensure_go lab-machine-1
  ensure_container_ground lab-machine-1 /usr/lib/systemd/user/dbus.socket \
    podman uidmap dbus-user-session
  # The machine of the LAN is the initiator of the private passage and the one
  # that holds the bounded service, so it carries the passage ground too.
  ensure_passage_ground lab-machine-1
}

provision_vps() {
  step "lab-vps — Go $go_version, rootless container ground, slirp4netns, passage ground"
  guard lab-vps
  # The public machine compiles the product for the same reason lab-machine-1
  # does: the proof of the public profile runs the real Auxiliary binary, built
  # from the sources the run synchronised and from nothing already there.
  ensure_go lab-vps
  ensure_container_ground lab-vps /usr/bin/slirp4netns \
    podman uidmap dbus-user-session slirp4netns
  remote lab-vps "command -v slirp4netns >/dev/null" \
    || fail "slirp4netns is absent after installation"
  note observed "$(remote lab-vps 'slirp4netns --version | head -1')"
  ensure_passage_ground lab-vps
}

case "$target" in
  lab-console) provision_console ;;
  lab-machine-1) provision_machine ;;
  lab-vps) provision_vps ;;
  all)
    provision_console
    provision_machine
    provision_vps
    ;;
esac

printf '\nPROVISION_LAB_OK rust=%s go=%s node=%s tauri-driver=%s\n' \
  "$rust_version" "$go_version" "$node_version" "$tauri_driver_version"
