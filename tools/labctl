cmd_topology_destroy() {
  local topology="${1:?usage: labctl topology destroy <quick|v1-full>}"
  require_topology "$topology"
  local rows=() row name template networks network index
  mapfile -t rows < <(topology_domains "$topology")
  for ((index=${#rows[@]}-1; index>=0; index--)); do
    row="${rows[$index]}"
    IFS='|' read -r name template networks <<<"$row"
    if domain_exists "$name"; then
      [[ "$(metadata_attr "$name" topology)" == "$topology" ]] \
        || die "'$name' appartient à une autre topologie ; refus de destruction"
      destroy_domain "$name"
    fi
  done
  while IFS= read -r network; do destroy_network "$network" "$topology"; done < <(topology_networks "$topology")
}

cmd_topology() {
  local action="${1:-}"; [[ $# -gt 0 ]] && shift
  case "$action" in
    create) cmd_topology_create "$@" ;;
    inspect) cmd_topology_inspect "$@" ;;
    prepare) cmd_topology_prepare "$@" ;;
    destroy) cmd_topology_destroy "$@" ;;
    *) die "usage: labctl topology <create|inspect|prepare|destroy> <quick|v1-full>" ;;
  esac
}

cmd_list() {
  local format=human names name state origin template topology ip
  if [[ "${1:-}" == --format=tsv ]]; then
    format=tsv
    shift
  fi
  [[ $# -eq 0 ]] || die "usage: labctl list [--format=tsv]"
  names=$(list_domain_names)
  if [[ "$format" == human ]]; then
    printf '%-24s %-10s %-15s %-13s %-10s %s\n' VM ETAT IP GABARIT TOPOLOGIE ORIGINE
  else
    printf 'vm\tstate\tips\ttemplate\ttopology\torigin\n'
  fi
  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    state=$(LC_ALL=C "${VIRSH[@]}" domstate "$name")
    if [[ "$state" == "shut off" ]]; then
      ip=-
    elif ! ip=$(get_ips "$name" | paste -sd, -); then
      die "impossible d'inspecter les adresses de '$name'"
    else
      ip=${ip:--}
    fi
    origin=$(metadata_attr "$name" origin); origin=${origin:--}
    template=$(metadata_attr "$name" template); template=${template:--}
    topology=$(metadata_attr "$name" topology); topology=${topology:--}
    if [[ "$format" == human ]]; then
      printf '%-24s %-10s %-15s %-13s %-10s %s\n' "$name" "$state" "$ip" "$template" "$topology" "$origin"
    else
      printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$name" "$state" "$ip" "$template" "$topology" "$origin"
    fi
  done <<<"$names"
  return 0
}

cmd_assert_clean() {
  [[ $# -eq 0 ]] || die "usage: labctl assert-clean"
  local domains networks name origin xml description retained=0
  domains=$(list_domain_names)
  networks=$(list_network_names)

  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    origin=$(metadata_attr "$name" origin)
    if [[ "$origin" == "$ORIGIN" || "$name" == lab-* ]]; then
      printf 'VM LAB persistante : %s (origine=%s)\n' "$name" "${origin:--}" >&2
      retained=1
    fi
  done <<<"$domains"

  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    xml=$("${VIRSH[@]}" net-dumpxml "$name") \
      || die "impossible d'inspecter le réseau libvirt '$name'"
    description=$(sed -n 's:.*<description>\(.*\)</description>.*:\1:p' <<<"$xml")
    if [[ "$description" == "$ORIGIN topology="* || "$name" == lab-* ]]; then
      printf 'Réseau LAB persistant : %s (description=%s)\n' \
        "$name" "${description:--}" >&2
      retained=1
    fi
  done <<<"$networks"

  [[ $retained -eq 0 ]] \
    || die "LAB non fermé ; détruire chaque topologie avec labctl ou documenter explicitement sa conservation"
  echo "✔ aucune VM ni aucun réseau LAB persistant"
}

cmd_revert() {
  local name="${1:?usage: labctl revert <vm> [snapshot]}" snapshot="${2:-clean}"
  valid_name "$snapshot"
  guard_mutation "$name"
  "${VIRSH[@]}" snapshot-revert "$name" "$snapshot"
  if [[ "$(LC_ALL=C "${VIRSH[@]}" domstate "$name")" == "shut off" ]]; then
    "${VIRSH[@]}" start "$name" >/dev/null
    wait_ip "$name" >/dev/null || die "pas d'IP après retour au snapshot"
  fi
  guard_forbidden_ip "$name"
  echo "✔ '$name' revenue au snapshot '$snapshot'"
}

cmd_snap() {
  local name="${1:?usage: labctl snap <vm> <snapshot>}" snapshot="${2:?usage: labctl snap <vm> <snapshot>}"
  valid_name "$snapshot"
  guard_mutation "$name"
  "${VIRSH[@]}" snapshot-create-as "$name" "$snapshot" >/dev/null
  echo "✔ snapshot '$snapshot' posé sur '$name'"
}

cmd_ip() { require_managed_domain "$1"; get_ip "$1"; }

cmd_start() {
  local name="${1:?usage: labctl start <vm>}" state ip
  if ! domain_exists "$name"; then
    recover_known_domain "$name"
    return 0
  fi
  require_managed_domain "$name"
  ensure_persistent_domain "$name"
  state=$(LC_ALL=C "${VIRSH[@]}" domstate "$name")
  if [[ "$state" != "shut off" ]]; then
    guard_forbidden_ip "$name"
    echo "→ '$name' déjà démarrée"
    return 0
  fi
  "${VIRSH[@]}" start "$name" >/dev/null
  ip=$(wait_ip "$name") || die "pas d'IP après démarrage de '$name'"
  guard_forbidden_ip "$name"
  echo "✔ '$name' démarrée — $ip"
}

recover_known_domain() {
  local name="$1" topology row candidate template networks found=0
  valid_name "$name"
  for topology in "${TOPOLOGIES[@]}"; do
    while IFS='|' read -r candidate template networks; do
      [[ "$candidate" == "$name" ]] || continue
      found=$((found + 1))
      row="$template|$topology|$networks"
    done < <(topology_domains "$topology")
  done
  [[ "$found" -eq 1 ]] || die "'$name' absente et impossible à rattacher sans ambiguïté à une topologie connue"
  IFS='|' read -r template topology networks <<<"$row"
  require_template "$template"
  require_topology "$topology"
  volume_exists "$name.qcow2" && volume_exists "$name-seed.iso" \
    || die "volumes gérés incomplets pour restaurer la définition de '$name'"
  local network network_args=()
  IFS=',' read -r -a requested_networks <<<"$networks"
  for network in "${requested_networks[@]}"; do
    network_exists "$network" && network_is_managed "$network" "$topology" \
      || die "réseau géré '$network' absent ou incompatible"
    network_args+=(--network "network=$network,model=virtio")
  done
  info "Restauration de la définition persistante de '$name' depuis ses volumes gérés"
  virt-install --connect qemu:///system --name "$name" \
    --memory "${TEMPLATE_RAM[$template]}" --vcpus "${TEMPLATE_VCPUS[$template]}" \
    --disk "vol=$POOL/$name.qcow2" --disk "vol=$POOL/$name-seed.iso,readonly=on,bus=virtio" \
    --import --osinfo debian13 "${network_args[@]}" --noautoapp >/dev/null \
    || die "restauration de définition impossible pour '$name'"
  set_domain_metadata "$name" "$template" "$topology" \
    || die "métadonnées de garde impossibles après restauration de '$name'"
  ensure_persistent_domain "$name"
  local ip
  ip=$(wait_ip "$name") || die "pas d'IP après restauration de '$name'"
  guard_forbidden_ip "$name"
  echo "✔ '$name' redéfinie persistante et démarrée — $ip"
}

cmd_stop() {
  local name="${1:?usage: labctl stop <vm>}" state attempt
  guard_mutation "$name"
  ensure_persistent_domain "$name"
  state=$(LC_ALL=C "${VIRSH[@]}" domstate "$name")
  if [[ "$state" == "shut off" ]]; then
    echo "→ '$name' déjà arrêtée"
    return 0
  fi
  "${VIRSH[@]}" shutdown "$name" >/dev/null
  for attempt in $(seq 1 30); do
    state=$(LC_ALL=C "${VIRSH[@]}" domstate "$name")
    [[ "$state" == "shut off" ]] && { echo "✔ '$name' arrêtée proprement"; return 0; }
    sleep 2
  done
  die "arrêt propre de '$name' non confirmé ; aucune extinction forcée"
}

cmd_ssh() {
  local name="${1:?usage: labctl ssh <vm> [commande...]}" ip
  shift
  require_managed_domain "$name"
  guard_forbidden_ip "$name"
  ip=$(wait_ip "$name") || die "pas d'IP pour '$name'"
  exec ssh "${SSH_OPTS[@]}" "root@$ip" "$@"
}

safe_remote_path() {
  [[ "$1" =~ ^/[A-Za-z0-9._/+~-]+$ ]] \
    || die "chemin distant invalide '$1' : chemin absolu sans espace attendu"
}

refuse_sensitive_copy() {
  local source="$1"
  [[ "${source##*/}" != "keys.txt" && "$source" != /srv/infra/secrets/* ]] \
    || die "refus de copier une source sensible vers le LAB"
}

cmd_copy_to() {
  local name="${1:?usage: labctl copy-to <vm> <source> <chemin-distant>}" source ip remote
  source="${2:?usage: labctl copy-to <vm> <source> <chemin-distant>}"
  remote="${3:?usage: labctl copy-to <vm> <source> <chemin-distant>}"
  [[ $# -eq 3 ]] || die "usage: labctl copy-to <vm> <source> <chemin-distant>"
  [[ -e "$source" ]] || die "source absente : '$source'"
  refuse_sensitive_copy "$source"
  safe_remote_path "$remote"
  require_command scp
  ensure_ssh_key
  require_managed_domain "$name"
  guard_forbidden_ip "$name"
  ip=$(wait_ip "$name") || die "pas d'IP pour '$name'"
  local recursive=()
  [[ -d "$source" ]] && recursive=(-r)
  scp "${SSH_OPTS[@]:1}" "${recursive[@]}" -- "$source" "root@$ip:$remote"
}

cmd_copy_from() {
  local name="${1:?usage: labctl copy-from <vm> <chemin-distant> <destination>}" remote destination ip
  remote="${2:?usage: labctl copy-from <vm> <chemin-distant> <destination>}"
  destination="${3:?usage: labctl copy-from <vm> <chemin-distant> <destination>}"
  [[ $# -eq 3 ]] || die "usage: labctl copy-from <vm> <chemin-distant> <destination>"
  safe_remote_path "$remote"
  refuse_sensitive_copy "$remote"
  require_command scp
  ensure_ssh_key
  require_managed_domain "$name"
  guard_forbidden_ip "$name"
  ip=$(wait_ip "$name") || die "pas d'IP pour '$name'"
  scp "${SSH_OPTS[@]:1}" -r -- "root@$ip:$remote" "$destination"
}

cmd_app() {
  local name="${1:?usage: labctl app <vm>}"
  require_managed_domain "$name"
  echo "Sortie de la app : Ctrl+]"
  "${VIRSH[@]}" app "$name"
}

usage() {
  cat <<EOF
labctl v6 — LAB your-cloud borné

  labctl topology create  <quick|v1-full>
  labctl topology inspect <quick|v1-full>
  labctl topology prepare v1-full
  labctl topology destroy <quick|v1-full>
  labctl list [--format=tsv]
  labctl assert-clean
  labctl revert  <vm> [snapshot]
  labctl snap    <vm> <snapshot>
  labctl start   <vm>
  labctl stop    <vm>
  labctl ip      <vm>
  labctl ssh     <vm> [commande...]
  labctl copy-to <vm> <source> <chemin-distant>
  labctl copy-from <vm> <chemin-distant> <destination>
  labctl app <vm>

Gabarits :
$(template_table)

Les mutations refusent tout domaine sans métadonnées $ORIGIN et les adresses
192.168.122.123 et 10.66.66.1.
EOF
}

command="${1:-}"; [[ $# -gt 0 ]] && shift
case "$command" in
  topology) cmd_topology "$@" ;;
  list) cmd_list "$@" ;;
  assert-clean) cmd_assert_clean "$@" ;;
  revert) cmd_revert "$@" ;;
  snap) cmd_snap "$@" ;;
  start) cmd_start "$@" ;;
  stop) cmd_stop "$@" ;;
  ip) cmd_ip "$@" ;;
  ssh) cmd_ssh "$@" ;;
  copy-to) cmd_copy_to "$@" ;;
  copy-from) cmd_copy_from "$@" ;;
  app) cmd_app "$@" ;;
  help|-h|--help|'') usage ;;
  *) die "commande inconnue '$command' ; labctl help" ;;
esac
