[Unit]
Description=Your Cloud v0.0.2 observation Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
User=your-cloud-daemon
StateDirectory=your-cloud-daemon
StateDirectoryMode=0700
EnvironmentFile=/etc/your-cloud/daemon.env
LoadCredential=daemon.crt:/etc/your-cloud/daemon.crt
LoadCredential=daemon.key:/etc/your-cloud/daemon.key
LoadCredential=relay-ca.crt:/etc/your-cloud/relay-ca.crt
ExecStart=/usr/local/lib/your-cloud/your-cloud daemon --machine-id=${MACHINE_ID} --relay-url=https://relay.v0-0-2.your-cloud.test:8443
Restart=on-failure
RestartSec=1s
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
InaccessiblePaths=-/etc/your-cloud/relay.crt -/etc/your-cloud/relay.key -/etc/your-cloud/daemon-ca.crt -/etc/your-cloud/enrollment.json -/etc/your-cloud/relay-candidate.json

[Install]
WantedBy=multi-user.target
