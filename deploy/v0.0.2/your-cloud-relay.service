[Unit]
Description=Your Cloud v0.0.2 observation Relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
User=your-cloud-relay
StateDirectory=your-cloud-relay
StateDirectoryMode=0700
LoadCredential=relay.crt:/etc/your-cloud/relay.crt
LoadCredential=relay.key:/etc/your-cloud/relay.key
LoadCredential=daemon-ca.crt:/etc/your-cloud/daemon-ca.crt
ExecStart=/usr/local/lib/your-cloud/your-cloud relay --listen=192.168.242.103:8443
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=1s
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
ReadOnlyPaths=/etc/your-cloud/enrollment.json /etc/your-cloud/relay-candidate.json
InaccessiblePaths=-/etc/your-cloud/daemon.env -/etc/your-cloud/daemon.key

[Install]
WantedBy=multi-user.target
