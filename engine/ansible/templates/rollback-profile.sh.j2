#!/bin/sh
set -eu

restore_or_remove() {
  current=$1
  backup=$2
  if [ -e "$backup" ]; then
    cp -a "$backup" "$current"
  else
    rm -f "$current"
  fi
}

restore_or_remove /etc/ssh/sshd_config.d/10-your-cloud.conf "{{ rollback_dir }}/10-your-cloud.conf.before"
restore_or_remove /etc/nftables.conf "{{ rollback_dir }}/nftables.conf.before"
restore_or_remove /etc/sysctl.d/90-your-cloud.conf "{{ rollback_dir }}/90-your-cloud.conf.before"
rm -f /var/lib/your-cloud/profile/manifest.sha256

if command -v nft >/dev/null 2>&1; then
  nft flush ruleset
  if [ -s "{{ rollback_dir }}/ruleset.before" ]; then
    nft -f "{{ rollback_dir }}/ruleset.before"
  fi
fi

sysctl -w net.ipv4.conf.all.accept_redirects="$(sed -n '1p' "{{ rollback_dir }}/sysctl.before")" >/dev/null
sysctl -w net.ipv4.conf.default.accept_redirects="$(sed -n '2p' "{{ rollback_dir }}/sysctl.before")" >/dev/null
sysctl -w net.ipv6.conf.all.accept_redirects="$(sed -n '3p' "{{ rollback_dir }}/sysctl.before")" >/dev/null
sysctl -w net.ipv6.conf.default.accept_redirects="$(sed -n '4p' "{{ rollback_dir }}/sysctl.before")" >/dev/null

{% if nft_package_before.rc != 0 %}
systemctl disable --now nftables.service >/dev/null 2>&1 || true
{% else %}
{% if nft_enabled_before.stdout == 'enabled' %}
systemctl enable nftables.service >/dev/null 2>&1 || true
{% else %}
systemctl disable nftables.service >/dev/null 2>&1 || true
{% endif %}
{% if nft_active_before.stdout == 'active' %}
systemctl start nftables.service >/dev/null 2>&1 || true
{% else %}
systemctl stop nftables.service >/dev/null 2>&1 || true
{% endif %}
{% endif %}

/usr/sbin/sshd -t
systemctl reload ssh.service
