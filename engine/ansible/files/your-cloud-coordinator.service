[Unit]
Description=your-cloud coordinateur de télémétrie
After=local-fs.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=your-cloud-coordinator
Group=your-cloud-coordinator
ExecStart=/usr/libexec/your-cloud-coordinator --config /etc/your-cloud/coordinator.json run
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/your-cloud/coordinator
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
