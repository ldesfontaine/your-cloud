#!/usr/bin/env bash
# Minimal deterministic virsh double for the read-only labctl list contract.
set -euo pipefail

[[ "${1:-}" == --connect && "${2:-}" == qemu:///system ]] || exit 64
shift 2
command=${1:-}
shift || true
scenario=${FAKE_VIRSH_SCENARIO:-retained}

case "$command" in
  list)
    [[ "$*" == "--all --name" ]] || exit 64
    if [[ "$scenario" == error ]]; then
      echo "synthetic libvirt failure" >&2
      exit 1
    elif [[ "$scenario" == clean ]]; then
      printf '%s\n' gold
    else
      printf '%s\n' lab-managed lab-unmanaged lab-stopped
    fi
    ;;
  net-list)
    [[ "$*" == "--all --name" ]] || exit 64
    if [[ "$scenario" == error ]]; then
      echo "synthetic libvirt failure" >&2
      exit 1
    elif [[ "$scenario" == clean ]]; then
      printf '%s\n' default
    else
      printf '%s\n' default lab-v1-full
    fi
    ;;
  domstate)
    if [[ "${1:-}" == lab-stopped || "${1:-}" == gold ]]; then
      printf '%s\n' 'shut off'
    else
      printf '%s\n' running
    fi
    ;;
  domifaddr)
    [[ "${1:-}" != lab-stopped ]] || exit 1
    printf '%s\n' \
      ' Name       MAC address          Protocol     Address' \
      '-------------------------------------------------------------------------------' \
      ' vnet0      52:54:00:00:00:01    ipv4        192.0.2.10/24' \
      ' vnet1      52:54:00:00:00:02    ipv4        198.51.100.20/24'
    ;;
  metadata)
    name=${1:?}
    if [[ "$name" == lab-managed ]]; then
      printf '%s\n' '<lab:domain xmlns:lab="urn:your-cloud:lab" origin="your-cloud/labctl" template="machine" topology="v1-full"/>'
    else
      exit 1
    fi
    ;;
  net-dumpxml)
    case "${1:-}" in
      default)
        printf '%s\n' '<network><name>default</name></network>'
        ;;
      lab-v1-full)
        printf '%s\n' \
          '<network><name>lab-v1-full</name><description>your-cloud/labctl topology=v1-full</description></network>'
        ;;
      *)
        exit 1
        ;;
    esac
    ;;
  *)
    exit 64
    ;;
esac
