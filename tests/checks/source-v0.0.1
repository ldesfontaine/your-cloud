#!/usr/bin/env bash
# Run the same source-side v0.0.1 gate in an explicit LAB or CI runner.
set -euo pipefail

[[ $# -eq 1 ]] || { echo "usage: source-v0.0.1 <lab|ci>" >&2; exit 2; }
mode=$1
case "$mode" in
  lab)
    [[ $(hostname) == lab-app ]] \
      || { echo "source-v0.0.1 lab must run on lab-app" >&2; exit 1; }
    [[ $(id -u) -eq 0 ]] \
      || { echo "source-v0.0.1 lab requires the isolated root LAB runner" >&2; exit 1; }
    ;;
  ci)
    [[ ${CI:-} == true && ${GITHUB_ACTIONS:-} == true ]] \
      || { echo "source-v0.0.1 ci requires CI=true and GITHUB_ACTIONS=true" >&2; exit 1; }
    [[ $(id -u) -ne 0 ]] \
      || { echo "source-v0.0.1 ci refuses a root runner" >&2; exit 1; }
    ;;
  *)
    echo "usage: source-v0.0.1 <lab|ci>" >&2
    exit 2
    ;;
esac

root=$(cd -- "$(dirname -- "$0")/../.." && pwd)
workdir=$(mktemp -d)
trap 'rm -rf "$workdir"' EXIT
cd "$root"
[[ ! -e dist ]] || { echo "source-v0.0.1 $mode requires a source lot without dist/" >&2; exit 1; }
for forbidden_root_path in artifacts deploy; do
  [[ ! -e "$forbidden_root_path" && ! -L "$forbidden_root_path" ]] \
    || { echo "source-v0.0.1 refuses the obsolete root path: $forbidden_root_path" >&2; exit 1; }
done

step() { printf '\n==> %s\n' "$1"; }
fail() { echo "FAILED: $*" >&2; exit 1; }

step "Go formatting"
mapfile -d '' go_files < <(find cmd internal -type f -name '*.go' -print0)
[[ ${#go_files[@]} -gt 0 ]] || fail "no Go source found"
unformatted=$(gofmt -l "${go_files[@]}")
[[ -z "$unformatted" ]] || fail "gofmt required for: $unformatted"

step "Shell syntax"
shell_count=0
while IFS= read -r -d '' file; do
  if [[ $(sed -n '1p' "$file") == '#!/usr/bin/env bash' ]]; then
    bash -n "$file"
    shell_count=$((shell_count + 1))
  fi
done < <(find tests tools -type f -print0)
[[ $shell_count -gt 0 ]] || fail "no Bash script found"

step "Hostile HTTP harness liveness"
hostile_http=tests/lab/v0.0.1/remote/prove-hostile-relay
curl_calls=$(grep -Ec '^[[:space:]]*(actual=\$\()?curl[[:space:]]' "$hostile_http")
connect_bounds=$(grep -c -- '--connect-timeout' "$hostile_http")
total_bounds=$(grep -c -- '--max-time' "$hostile_http")
[[ $curl_calls -eq 3 && $connect_bounds -eq $curl_calls \
  && $total_bounds -eq $curl_calls ]] \
  || fail "every hostile HTTP curl call must carry connection and total bounds"
grep -Fq 'prove_bounded_unresponsive_destination' "$hostile_http" \
  || fail "hostile HTTP harness lacks the synthetic unresponsive destination"

step "Python renderer syntax"
PYTHONPYCACHEPREFIX="$workdir/pycache" python3 -m py_compile \
  tests/lab/v0.0.1/report/renderer.py \
  tests/checks/ci-workflow-policy.py \
  tests/checks/app-windows-ui-proof.py \
  tests/checks/render-v0.0.1-schema.py \
  tests/checks/plumber-report.py \
  tests/checks/test-plumber-report.py \
  tests/checks/test-app-ui-raster.py

step "CI trigger policy"
python3 -B tests/checks/ci-workflow-policy.py

step "Hostile structured-result boundary"
python3 -B tests/checks/render-v0.0.1-schema.py

step "Plumber structured-report boundary"
python3 -B tests/checks/test-plumber-report.py

step "Installed UI screenshot raster boundary"
python3 -B tests/checks/test-app-ui-raster.py

step "labctl list contract"
bash tests/checks/labctl-list

step "labctl clean-closure contract"
bash tests/checks/labctl-clean

step "Documentation contract"
tools/check-docs

step "Go tests without cache"
go test -count=1 ./...

step "Go vet"
go vet ./...

step "Single static Go artifact"
main_packages=$(go list -f '{{if eq .Name "main"}}{{.ImportPath}}{{end}}' ./cmd/... | sed '/^$/d')
[[ $(wc -l <<<"$main_packages") -eq 1 ]] \
  || fail "expected one main package, found: $main_packages"
if [[ "$mode" == lab ]]; then
  mkdir dist
  build_output=dist/your-cloud
  CGO_ENABLED=0 go build -trimpath -o "$build_output" ./cmd/your-cloud
  mapfile -d '' artifacts < <(find dist -maxdepth 1 -type f -print0)
  [[ ${#artifacts[@]} -eq 1 && ${artifacts[0]} == "$build_output" ]] \
    || fail "LAB build did not produce exactly dist/your-cloud"
else
  build_output="$workdir/your-cloud"
  CGO_ENABLED=0 go build -trimpath -o "$build_output" ./cmd/your-cloud
  [[ ! -e dist ]] || fail "CI mode created a forbidden dist/ directory"
  mapfile -d '' artifacts < <(find "$workdir" -maxdepth 1 -type f -print0)
  [[ ${#artifacts[@]} -eq 1 && ${artifacts[0]} == "$build_output" ]] \
    || fail "CI build did not produce exactly one temporary your-cloud artifact"
fi
[[ -x "$build_output" ]] || fail "built artifact is not executable"
sha256sum "$build_output"

printf '\nPASS: v0.0.1 source gate (%s) completed on %s as uid %s\n' \
  "$mode" "$(hostname)" "$(id -u)"
