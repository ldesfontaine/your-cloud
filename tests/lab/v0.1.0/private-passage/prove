#!/usr/bin/env bash
# Drive the private passage proof: mount the two sides of the link on the two
# machines the reference scenario names, play the four plans in the contract's
# order, and read every claim of `#16` from the place it is only true in.
#
# Three machines take part and none of them is interchangeable.
#
#   lab-machine-1  the machine of the LAN, the **initiator**. It holds the
#                  managed services the passage is asked to bound, it goes out to
#                  the listener, and it must gain no inbound port at all;
#   lab-vps        the public machine, the **listener**. It answers on the
#                  tunnel's UDP port and reaches exactly one service through it;
#   lab-app    a third machine with root, used as a hostile observer only. It
#                  is given, by hand, the routes an attacker would give itself,
#                  and both attempts must fail. Nothing of the product is ever
#                  installed on it and every route it is given is taken back.
#
# The pilot's own host is the fourth party and the one that judges from outside:
# it scans, it probes, and it never runs a command on either machine for a
# constat that is about what those machines expose.
#
# One VM plays every authority this palier separates, and that is honest rather
# than convenient: the Controller and the App are a synthetic fixture — the
# App window is not wired to this proof — while the Auxiliary is the real
# product binary, built from the synchronised sources, running as root against a
# real systemd, a real systemd-networkd, a real kernel WireGuard and a real
# nftables.
#
# The reboot is a real power cycle of **both** machines through the LAB
# controller, because the property under proof is that an interface, a peer, a
# route, a table and a host relaxation come back without an action, and a process
# restart does not exercise that.
set -euo pipefail
export LC_ALL=C.UTF-8

usage() {
  cat >&2 <<'EOF'
usage: prove [setup | run | reboot | verify | remove | all]

  setup   synchronise the sources, build the binary and the fixture on both
          machines, mount the two anchors and the two empty anti-replay
          positions, and audit both machines before anything exists
  run     the palier up to the power cycle: the managed services, the four plans
          in the contract's order, what the tunnel carries and what it refuses,
          the hostile readings from outside, the idempotence and the refusals
  reboot  really stop and start both machines through the LAB controller
  verify  what the reboot carried, the established flow across a departure, the
          departure and the withdrawal in the contract's order, and one
          controlled failure with its rollback
  remove  remove both perimeters and prove their absence
  all     the five above in order, removing even when a step fails (default)

This harness belongs to the palier of the private WireGuard passage (#16, proofs
#96 and #97, machine proof #98) and is deliberately not one of the passes of
tests/lab/v0.1.0/prove, whose sequence is the bootstrap and replacement palier
(#13, proof #41). It mounts and removes its own perimeter on lab-machine-1 and
lab-vps, borrows lab-app as a hostile observer without installing anything on
it, and creates no topology.
EOF
  exit 2
}

command=${1:-all}
[[ $# -le 1 ]] || usage
case "$command" in
  setup | run | reboot | verify | remove | all) ;;
  *) usage ;;
esac

root=$(cd -- "$(dirname -- "$0")/../../../.." && pwd)
labctl="$root/tools/labctl"
harness="$root/tests/lab/v0.1.0/private-passage"
initiator_vm=lab-machine-1
listener_vm=lab-vps
hostile_vm=lab-app
expected_origin=your-cloud/labctl
remote_harness=/root/your-cloud-lab-private-passage
remote_sources=/root/lab-private-passage-sources
result_root="$root/tests/artifacts/proofs/private-passage"
run_id=$(date -u +%Y%m%dT%H%M%SZ)-$$
workdir=$(mktemp -d)
# The three values `run` observes and `verify` needs live outside the run's
# temporary directory on purpose: the subcommands of this harness are meant to be
# usable one at a time while the passage stays mounted, and a driver that lost
# the two public keys between two of them would have to stop verifying. Not one
# of them is a secret — two public keys and a port number — and `remove` takes
# them away.
carried="${TMPDIR:-/tmp}/your-cloud-lab-private-passage"
mkdir -p "$carried"
trap 'rm -rf "$workdir"' EXIT

scripts=(common install audit play-service play-prepare play-presence play-junction
  play-tunnel play-idempotence play-modification play-persistence play-departure
  play-failure flow remove)

# fail is for the guards that run before anything is mounted: a LAB that does not
# look the way this harness requires must not be touched at all, so it stops the
# whole run.
fail() {
  echo "FAILED: $*" >&2
  exit 1
}

# refuse is for everything after the first mutation. It keeps the first red and
# returns, so that the removal at the end of `play` still runs: two machines left
# holding a tunnel are worse than a proof that stopped.
refuse() {
  echo "FAILED: $*" >&2
  return 1
}

# The mandatory inventory guard: read the LAB before mutating any of it.
inventory() {
  local vm=$1 line state ips template topology origin
  line=$("$labctl" list --format=tsv | awk -v vm="$vm" -F'\t' '$1 == vm')
  [[ -n "$line" ]] || fail "$vm is not part of the LAB inventory"
  IFS=$'\t' read -r _ state ips template topology origin <<<"$line"
  [[ "$origin" == "$expected_origin" ]] || fail "$vm carries the origin $origin"
  [[ "$state" == running ]] || fail "$vm is $state"
  [[ "$topology" == quick ]] || fail "$vm belongs to the topology $topology"
  [[ "$ips" != *,* ]] || fail "$vm holds several addresses: $ips"
  [[ "$ips" != 192.168.122.123 && "$ips" != 10.66.66.1 ]] \
    || fail "$vm holds an address this project never mutates"
  echo "$ips"
}

# The revision is named once and honestly. A modified tree is announced as such,
# because a report built on a state nobody can fetch closes no line of a palier.
revision() {
  local sha
  sha=$(git -C "$root" rev-parse HEAD)
  if ! git -C "$root" diff --quiet \
    || ! git -C "$root" diff --cached --quiet \
    || [[ -n $(git -C "$root" ls-files --others --exclude-standard) ]]; then
    sha="$sha+worktree"
  fi
  echo "$sha"
}

initiator_address=
listener_address=
bounded_port=

locate() {
  initiator_address=$(inventory "$initiator_vm")
  listener_address=$(inventory "$listener_vm")
  # The hostile observer is guarded like the other two even though nothing of the
  # product is installed on it: this harness gives it routes and takes them back,
  # which is a mutation and therefore needs the guard.
  inventory "$hostile_vm" >/dev/null
}

on() {
  local vm=$1
  shift
  "$labctl" ssh "$vm" -- "$remote_harness/$*"
}

# ask runs one script on one machine and returns the value it printed as
# NAME=value, so that an observation of one machine can enter the plan of the
# other exactly as a Controller would carry it. The whole stream is still shown,
# because a value read out of a step whose assertions nobody saw would be a value
# nobody can trust.
ask() {
  local vm=$1 name=$2
  shift 2
  local log="$workdir/ask-$vm-$name.log" status=0
  set +e
  # The stream goes to standard error so that the run log still shows every
  # assertion of the step, while the one value this function returns stays alone
  # on standard output where the caller captures it.
  "$labctl" ssh "$vm" -- "$remote_harness/$*" 2>&1 | tee "$log" >&2
  status=${PIPESTATUS[0]}
  set -e
  [[ $status -eq 0 ]] || return "$status"
  sed -n "s/^$name=//p" "$log" | tail -1
}

mount_perimeter() {
  local vm=$1 role=$2
  "$labctl" ssh "$vm" -- "rm -rf $remote_harness && install -d -m 0700 $remote_harness"
  local script
  for script in "${scripts[@]}"; do
    "$labctl" copy-to "$vm" "$harness/$script" "$remote_harness/$script" >/dev/null
    "$labctl" ssh "$vm" -- "chmod 0700 $remote_harness/$script"
  done

  # The product sources this run proves, and the synthetic fixture that stands in
  # for the Controller and the App. The fixture is placed *inside* the module
  # because it asks internal/plan for the canonical plan documents; it exists
  # only in this copy and is never a package of the product.
  "$labctl" copy-to "$vm" "$workdir/sources.tgz" /root/lab-private-passage-sources.tgz >/dev/null
  "$labctl" copy-to "$vm" "$harness/_fixture/main.go" /root/lab-private-passage-fixture-main.go >/dev/null
  "$labctl" ssh "$vm" -- \
    "rm -rf $remote_sources && install -d -m 0700 $remote_sources \
     && tar xzf /root/lab-private-passage-sources.tgz -C $remote_sources \
     && install -d -m 0700 $remote_sources/labfixture \
     && mv /root/lab-private-passage-fixture-main.go $remote_sources/labfixture/main.go \
     && rm -f /root/lab-private-passage-sources.tgz"

  "$labctl" ssh "$vm" -- \
    "export PATH=\$PATH:/usr/local/go/bin && $remote_harness/install $remote_sources $role $vm"
}

setup() {
  locate
  echo "perimeter: initiator $initiator_vm at $initiator_address, listener $listener_vm at $listener_address"
  echo "hostile observers: the pilot host and $hostile_vm (nothing of the product is installed on it)"
  echo "revision: $(revision)"

  tar czf "$workdir/sources.tgz" -C "$root" go.mod go.sum cmd internal
  mount_perimeter "$listener_vm" listener
  mount_perimeter "$initiator_vm" initiator
}

run() {
  locate || return 1
  on "$listener_vm" audit || return 1
  on "$initiator_vm" audit || return 1
  "$harness/outside" before "$initiator_address" "$listener_address" || return 1

  on "$initiator_vm" play-service || return 1

  # The four plans, in the order the contract sequences and the Controller would
  # follow. The two public keys travel between them and nothing else does.
  local listener_key initiator_key
  listener_key=$(ask "$listener_vm" LINK_PUBLIC_KEY play-prepare) || return 1
  [[ ${#listener_key} -eq 44 ]] || refuse "the listener reported no public key" || return 1
  initiator_key=$(ask "$initiator_vm" LINK_PUBLIC_KEY play-prepare) || return 1
  [[ ${#initiator_key} -eq 44 ]] || refuse "the initiator reported no public key" || return 1
  echo "the Controller now holds two observations: listener $listener_key, initiator $initiator_key"

  bounded_port=$(ask "$initiator_vm" BOUNDED_PORT \
    play-presence "$listener_key" "$listener_address") || return 1
  [[ -n "$bounded_port" ]] || refuse "the initiator named no port for the passage to bound" || return 1
  printf '%s\n' "$listener_key" >"$carried/listener-key"
  printf '%s\n' "$initiator_key" >"$carried/initiator-key"
  printf '%s\n' "$bounded_port" >"$carried/bounded-port"

  on "$listener_vm" play-junction "$initiator_key" "$initiator_address" "$bounded_port" || return 1
  on "$initiator_vm" play-junction "$listener_key" "$listener_address" "$bounded_port" || return 1

  on "$listener_vm" play-tunnel "$bounded_port" "$initiator_address" || return 1
  "$harness/outside" after "$initiator_address" "$listener_address" "$bounded_port" || return 1

  on "$listener_vm" play-idempotence "$initiator_key" "$initiator_address" "$bounded_port" || return 1
  on "$initiator_vm" play-idempotence "$listener_key" "$listener_address" "$bounded_port" || return 1
  on "$initiator_vm" play-modification "$listener_key" "$listener_address" "$bounded_port" || return 1
}

reboot_both() {
  local vm attempt
  echo "== real power cycle of $initiator_vm and $listener_vm =="
  for vm in "$initiator_vm" "$listener_vm"; do
    "$labctl" stop "$vm"
  done
  for vm in "$initiator_vm" "$listener_vm"; do
    "$labctl" start "$vm"
  done
  locate
  for vm in "$initiator_vm" "$listener_vm"; do
    for attempt in $(seq 1 180); do
      if "$labctl" ssh "$vm" -- true >/dev/null 2>&1; then
        echo "$vm answers again after ${attempt}s"
        break
      fi
      sleep 1
      [[ $attempt -lt 180 ]] || refuse "$vm never answered after its power cycle" || return 1
    done
  done
}

verify() {
  locate || return 1
  local listener_key initiator_key
  listener_key=$(cat "$carried/listener-key" 2>/dev/null || true)
  initiator_key=$(cat "$carried/initiator-key" 2>/dev/null || true)
  bounded_port=$(cat "$carried/bounded-port" 2>/dev/null || true)
  [[ -n "$listener_key" && -n "$initiator_key" && -n "$bounded_port" ]] \
    || refuse "verify needs the two public keys and the bounded port that run recorded" || return 1

  on "$listener_vm" play-persistence "$initiator_key" "$initiator_address" "$bounded_port" || return 1
  on "$initiator_vm" play-persistence "$listener_key" "$listener_address" "$bounded_port" || return 1
  on "$listener_vm" play-tunnel "$bounded_port" "$initiator_address" || return 1

  # One flow, established through the passage, held open across the whole
  # departure. The bounds are removed after the peer on both machines, so what
  # this flow measures is what a departure really cuts.
  on "$listener_vm" flow open "$bounded_port" || return 1
  on "$initiator_vm" play-departure part "$listener_key" "$listener_address" "$bounded_port" || return 1
  on "$listener_vm" play-departure part "$initiator_key" "$initiator_address" "$bounded_port" || return 1
  on "$listener_vm" flow finish || return 1

  on "$initiator_vm" play-departure withdraw || return 1
  on "$listener_vm" play-departure withdraw || return 1

  on "$initiator_vm" play-failure || return 1
}

remove_perimeters() {
  local status=0
  on "$initiator_vm" remove || status=$?
  on "$listener_vm" remove || status=$?
  "$labctl" ssh "$initiator_vm" -- "rm -rf $remote_harness $remote_sources" || true
  "$labctl" ssh "$listener_vm" -- "rm -rf $remote_harness $remote_sources" || true
  rm -f "$carried/listener-key" "$carried/initiator-key" "$carried/bounded-port"
  return "$status"
}

# play is the whole sequence, in order, first red kept. It never stops before the
# removal: two machines left holding an anchor, a spent position, two lingering
# accounts, a tunnel interface and a loaded table are not a clean LAB, whatever
# failed above.
play() {
  local status=0
  setup || status=$?
  if [[ $status -eq 0 ]]; then run || status=$?; fi
  if [[ $status -eq 0 ]]; then reboot_both || status=$?; fi
  if [[ $status -eq 0 ]]; then verify || status=$?; fi
  remove_perimeters || status=$?
  # The last reading of all is taken from outside, once nothing of this proof is
  # mounted anywhere: two machines back to the surface they had before.
  if [[ -n "$initiator_address" && -n "$listener_address" ]]; then
    "$harness/outside" removed "$initiator_address" "$listener_address" || status=$?
  fi
  return "$status"
}

# publish writes the run's report where a proof output belongs, naming the exact
# tree it judged. It carries no address of the pilot, no key of the LAB and no
# secret: the material is synthetic by construction and the pilot's own paths are
# removed.
publish() {
  local status=$1 log=$2 directory="$result_root/$run_id"
  install -d -m 0755 "$directory"
  {
    printf 'proof: your-cloud private WireGuard passage (palier #16, issues #96 and #97, machine proof #98)\n'
    printf 'run: %s\n' "$run_id"
    printf 'revision: %s\n' "$(revision)"
    printf 'initiator: %s (the machine of the LAN, topology quick)\n' "$initiator_vm"
    printf 'listener: %s (the public machine, topology quick)\n' "$listener_vm"
    printf 'hostile observers: the pilot host and %s\n' "$hostile_vm"
    # A run whose assertions all held and which found a product defect has not
    # passed: the defect is the finding, and a report saying `passed` beside it
    # would be a report nobody could act on.
    if [[ $status -eq 0 ]] && ! grep -q '^!! PRODUCT DEFECT' "$log"; then
      printf 'outcome: passed\n'
    elif [[ $status -eq 0 ]]; then
      printf 'outcome: failed (every assertion held; the failure is the product defects below)\n'
    else
      printf 'outcome: failed\n'
    fi
    printf 'finished_at: %s\n\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"

    if grep -q '^!! PRODUCT DEFECT' "$log"; then
      printf 'product defects this run found, reported and deliberately not repaired by it:\n\n'
      # A defect block is its marker line plus everything indented under it, and
      # the same defect is reported once per machine that meets it — so blocks are
      # collected whole and printed once each. A `sed` range ending at the first
      # blank line would cut a block in half, which is exactly how a report ends
      # up naming a defect nobody can act on.
      awk '''
        function emit(   key) {
          key = block
          if (!(key in seen)) { seen[key] = 1; printf "%s", block }
          collecting = 0; block = ""
        }
        /^!! PRODUCT DEFECT/ { if (collecting) emit(); block = $0 "\n"; collecting = 1; next }
        collecting && ($0 ~ /^   / || $0 ~ /^[[:space:]]*$/) { block = block $0 "\n"; next }
        collecting { emit() }
        END { if (collecting) emit() }
      ''' "$log" | sed -e '''s/^\(.\)/  \1/'''
      printf '\n'
    fi
    if grep -q '^!! DIVERGENCE' "$log"; then
      printf 'divergences between a written contract and the code, found by this run:\n\n'
      grep -A2 '^!! DIVERGENCE' "$log" | sed -e 's/^/  /' -e 's/^  --$//'
      printf '\n'
    fi

    # What a green run of this harness still does not establish. It is written
    # into every report rather than left in an issue, because a report that names
    # only what it proved invites the reader to assume the rest.
    cat <<'DEBTS'
what this proof does not claim, whatever its outcome:

  - the topology is flat, and the reference scenario is not. `quick` puts
    lab-app, lab-vps and lab-machine-1 on one subnet, so a hostile host can
    reach lab-machine-1's own address directly — it could before this proof
    mounted anything and it can afterwards. That is a property of the LAB and
    not of the product: the reference topology puts the machine of the LAN
    behind a NAT nothing here reproduces. What is constated instead, and what
    the passage is actually answerable for, is that the passage adds **no new
    inbound port** to that machine, that the listener adds exactly the tunnel's
    UDP, and that neither machine relays anything towards the other's tunnel
    address.
  - the two layers of the passage's bounds are not isolated by design. Two
    independent layers stand between the VPS and the approved service — the
    listener's own `oifname yc-link0 drop`, and, at the other end, the
    initiator's redirection choosing only the approved destination beside its
    own `iifname yc-link0 drop`. While both are posed, every refusal read from
    the VPS is decided by the first and the second is never reached, so the
    step that reads them says which layer it is reading at rather than claiming
    both. This run did isolate the second — but only because a defect above
    left the listener with no table after its reboot, which is an accident and
    not a method. A proof that wanted the second layer on purpose would need a
    way to reach the initiator through the tunnel without the listener's table,
    and this harness has none.
  - the App window is not wired to this run. The Controller and the App
    are a fixture: what the machines are proven to do is what they do with
    documents they did not write, and interoperability with the real App is
    held by the pinned cross-language vector and not by this proof.
  - no NAT is traversed. The initiator's keepalive is written and observed, but
    the property it exists for — holding a mapping open through a NAT — is not
    exercised by a flat network.
  - the hosted gate does not run this harness. It needs libvirt, a LAB and
    something like half an hour; the quota debt of the September candidate
    covers it.

DEBTS
    sed -e "s#$root#<repo>#g" -e "s#$HOME#<home>#g" -e "s#$(id -un)#<user>#g" "$log"
  } >"$directory/report.txt"
  chmod 0644 "$directory/report.txt"
  printf '\nreport=%s\n' "$directory/report.txt"
}

case "$command" in
  setup) setup ;;
  run) locate && run ;;
  reboot) reboot_both ;;
  verify) locate && verify ;;
  remove)
    locate
    remove_perimeters
    ;;
  all)
    # The raw stream is kept live so a long run can be watched, then published.
    # The status is read from PIPESTATUS rather than from the pipeline, because
    # the left-hand side of a pipe runs in a subshell and no assignment made
    # there survives it — a proof whose verdict is lost to a pipe is a proof that
    # always passes.
    set +e
    play 2>&1 | tee "$workdir/run.log"
    status=${PIPESTATUS[0]}
    set -e
    publish "$status" "$workdir/run.log"
    exit "$status"
    ;;
esac
