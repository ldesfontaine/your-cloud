#!/usr/bin/env bash
# One machine's own side of the passage: the key that is born here and never
# leaves, and the closed interface the role's constants describe.
#
# Nothing of a peer is asked for and nothing of a peer appears. That is the whole
# point of separating the four plans: after this script the machine holds a
# tunnel endpoint that carries nothing, has no peer to carry it to, and — on the
# initiator — is not even listening on a port.
#
# The one value this prints is the public half of the key. The Controller reads
# it as an observation, the human reads it inside the *other* machine's junction
# plan, and this harness carries it between the two exactly as a Controller
# would: out of a report, into a document.
set -euo pipefail
here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=common
. "$here/common"

cd /root

step "2. the passage is prepared on this machine — role $link_role"

before=$(fingerprint)
apply "prepare_link as the $link_role" '"changed":true' \
  -operation prepare_link -link-role "$link_role"
public_key=$(json_field link_public_key)

if [[ ${#public_key} -eq 44 ]]; then
  report "the report carries a public key" "$public_key"
else
  red "the report carries a public key" "${public_key:-none}"
fi
# The one thing a report of this palier must never carry, checked against the
# report's own bytes rather than trusted.
if grep -q "$(cat "$link_key" 2>/dev/null | head -c 20)" "$state/last-report.json" 2>/dev/null; then
  red "the report and the private key" "the report carries bytes of the private key"
else
  report "the report and the private key" "no byte of the private half appears in it"
fi

# --- the key ----------------------------------------------------------------
#
# 0640 root:systemd-network is the contract's one named departure from its own
# text, and the arithmetic behind it is why the mode is asserted rather than
# glanced at: systemd-networkd runs unprivileged, so a key only root can read is
# a passage that never comes up, and exactly one identity more may read it.
expect "the passage key's owner and mode" "$(file_owner "$link_key")" "root:systemd-network 640"
# root:systemd-network rather than root:root, and the difference is not the
# product's doing: see the DIAGNOSTIC-ONLY note in `install`. With the group the
# product writes, systemd-networkd cannot enter this directory and the interface
# below never appears.
expect "the tree it lives in (posed by the harness)" "$(stat -c '%U:%G %a' "$link_root")" "root:systemd-network 750"
report "the key's size" "$(stat -c %s "$link_key") bytes"
if [[ $(wc -l <"$link_key") -eq 1 ]]; then
  report "what the key file holds" "one line of standard base64"
else
  red "what the key file holds" "$(wc -l <"$link_key") lines"
fi

# --- the two files ----------------------------------------------------------
matches_bytes "the description of $link_interface" "$link_netdev" "$(expected_netdev)"
matches_bytes "the addressing of $link_interface" "$link_network" "$(expected_network)"
expect "their owner and mode" "$(file_owner "$link_netdev")" "root:root 644"

# --- the interface ----------------------------------------------------------
expect "the interface" "$(interface_state)" up
expect "the address it holds" "$(interface_address)" "$own_address/32"
expect "the public key the kernel holds" "$(wg_public_key)" "$public_key"
expect "the peers the kernel holds" "$(wg_peers)" none
if [[ "$link_role" == listener ]]; then
  expect "the port the kernel listens on" "$(wg_listen_port)" "$link_listen_port"
  expect "that port, in this machine's own UDP set" "$(udp_port_bound "$link_listen_port")" bound
else
  # The initiator has no ListenPort line, so the kernel picks an ephemeral source
  # port for the tunnel it opens. What matters is that it is not the contract's
  # listening port, because that is the one port the passage adds to a machine
  # and the machine of the LAN must add none.
  observed=$(wg_listen_port)
  if [[ "$observed" != "$link_listen_port" ]]; then
    report "the port the kernel listens on" "$observed, which is not the contract's $link_listen_port"
  else
    red "the port the kernel listens on" "$observed: the initiator holds the listener's port"
  fi
fi

# --- what a preparation is not ----------------------------------------------
expect "the bounding table, after a preparation" "$(link_table_loaded)" absent
expect "the bounding rules on disk" "$(present "$link_rules")" absent
expect "the unit that puts the bounds back" "$(present "$link_unit")" absent
expect "the host relaxation" "$(present "$link_policy")" absent
expect "the route towards the peer" \
  "$(ip route show dev "$link_interface" 2>/dev/null | grep -c "$peer_address" || true)" 0
expect "the foreign table this harness posed" "$(foreign_table_loaded)" loaded
report "the network manager, after the preparation" \
  "$(systemctl is-enabled systemd-networkd)/$(systemctl is-active systemd-networkd)"
report "the real interfaces, after the preparation" \
  "$(ip -4 -brief address show scope global | paste -sd' ' -)"

printf '%s\n' "$public_key" >"$state/own-public-key.txt"
printf '%s\n' "$before" >"$state/before-preparation.txt"

step "2b. the same preparation, asked for again, is not an action"

key_mtime=$(file_mtime "$link_key")
index=$(interface_index)
apply "prepare_link replayed" '"changed":false' \
  -operation prepare_link -link-role "$link_role"
expect "the key was not regenerated" "$(file_mtime "$link_key")" "$key_mtime"
expect "the key it reports is still the same" "$(json_field link_public_key)" "$public_key"
expect "the interface did not flap" "$(interface_index)" "$index"

step "2c. what this machine refuses while it holds this role"

other_role=initiator
[[ "$link_role" == initiator ]] && other_role=listener
refuses "a preparation naming the other role" "a machine has one role per link" \
  -operation prepare_link -link-role "$other_role"

printf 'LINK_PUBLIC_KEY=%s\n' "$public_key"
verdict "this machine holds a key it generated and never reported the private half of, a closed interface at $own_address/32, no peer, no table and no relaxation"
