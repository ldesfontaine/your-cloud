#!/usr/bin/env bash
# Return the machine to its initial state, and prove it.
#
# An account is removed only if this harness created it. The provenance is the
# one `mount-machine` printed, carried back by the pilot rather than guessed
# here: a removal that decided for itself what it had created would eventually
# delete something that was already there.
set -euo pipefail
export LC_ALL=C.UTF-8

usage() { echo "usage: remove-machine ACCOUNT CREATED|FOUND" >&2; exit 2; }
[[ $# -eq 2 ]] || usage
account=$1
provenance=$2

[[ "$account" =~ ^[a-z][a-z0-9-]{2,30}$ ]] || { echo "FAILED: implausible account name" >&2; exit 1; }
case "$provenance" in
  CREATED | FOUND) ;;
  *) usage ;;
esac

home=
if id "$account" >/dev/null 2>&1; then
  home=$(getent passwd "$account" | cut -d: -f6)
fi

if [[ "$provenance" == FOUND ]]; then
  # The account predates this run. Only the one file this run wrote is removed,
  # and the account itself is left exactly where it was found.
  [[ -z "$home" ]] || rm -f "$home/.ssh/authorized_keys"
  printf 'KEPT account=%s reason=found-in-place\n' "$account"
  exit 0
fi

if id "$account" >/dev/null 2>&1; then
  # A session this run opened may still be closing, and an account that owns a
  # process cannot be removed. Only this account's own processes are ended, and
  # that is bounded by construction: nothing but this harness ever runs as it.
  pkill -TERM -u "$account" 2>/dev/null || true
  waited=0
  while [[ $waited -lt 15 ]]; do
    pgrep -u "$account" >/dev/null 2>&1 || break
    sleep 1
    waited=$((waited + 1))
  done
  if pgrep -u "$account" >/dev/null 2>&1; then
    pkill -KILL -u "$account" 2>/dev/null || true
    sleep 1
  fi
  if pgrep -u "$account" >/dev/null 2>&1; then
    echo "FAILED: $account still owns a process after being ended" >&2
    exit 1
  fi
  userdel --remove "$account" >/dev/null 2>&1 || userdel "$account" >/dev/null
fi

# Prove the absence rather than announce it.
if id "$account" >/dev/null 2>&1; then
  echo "FAILED: the account this run created is still present: $account" >&2
  exit 1
fi
if [[ -n "$home" && -e "$home" ]]; then
  rm -rf "$home"
fi
[[ -z "$home" || ! -e "$home" ]] \
  || { echo "FAILED: the home this run created survives: $home" >&2; exit 1; }

printf 'REMOVED account=%s absence=proved\n' "$account"
