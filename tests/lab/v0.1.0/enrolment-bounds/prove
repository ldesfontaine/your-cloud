#!/usr/bin/env bash
# Preuve de la borne d'enrôlement : soixante-quatre identités, et le refus de la
# soixante-cinquième — sur la topologie `quick` du LAB Linux.
#
# Ce que ce harnais prouve est l'**échelle**, et rien d'autre. Que chaque
# machine n'admette que son identité est la propriété de #39, éprouvée là-bas
# contre un vrai `sshd` avec une vraie commande forcée ; la rejuger ici lui
# donnerait un second domicile. Ce qui n'existe nulle part ailleurs, et que ce
# passage ajoute, est triple :
#
#   le parc entier      soixante-quatre identités frappées d'un coup par la
#                       porte compilée, ce qu'aucun test unitaire ne fait avec
#                       de vraies clés
#   la borne            la soixante-cinquième refusée par son nom, et les
#                       collisions encore attrapées *à* la borne
#   l'accord            là où la réalité existe — deux machines sur soixante-
#                       quatre — le verdict de la porte est confronté à ce qu'un
#                       vrai `sshd` décide, et un désaccord rougit
#
# La représentativité est annoncée, jamais sous-entendue : deux identités sur
# soixante-quatre sont détenues par une vraie machine, les soixante-deux autres
# sont de vraies clés Ed25519 que personne ne détient. Un harnais qui tairait
# cette proportion laisserait lire « soixante-quatre machines prouvées ».
#
# Rien n'est versionné : les clés sont générées au montage et détruites au
# démontage, et aucune adresse ne vit dans ce fichier.
set -euo pipefail
export LC_ALL=C.UTF-8

usage() {
  cat >&2 <<'EOF'
usage: prove [artifact | setup | estate | refuse | agree | mutate | remove | all]

  artifact  build the enrolment fixture in the Controller, from this run's sources
  setup     mint sixty-five real Ed25519 identities and mount the two a machine holds
  estate    the estate of sixty-four, judged by the compiled gate
  refuse    the sixty-fifth, and the collisions that must still be caught at the bound
  agree     confront the gate's verdict with what a real sshd decides
  mutate    show the suite reddens when the bound stops bounding
  remove    return both machines to their initial state and prove it
  all       the seven above in order, removing even when a step fails (default)
EOF
  exit 2
}

command=${1:-all}
[[ $# -le 1 ]] || usage
case "$command" in
  artifact | setup | estate | refuse | agree | mutate | remove | all) ;;
  *) usage ;;
esac

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../../.." && pwd)
labctl="$root/tools/labctl"
harness=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

console_vm=lab-console
target_vm=lab-machine-1
expected_origin=your-cloud/labctl
account=ycbounds
state=/root/your-cloud-lab-enrolment-bounds
remote_harness=/root/your-cloud-lab-enrolment-bounds-harness
fixture="$state/fixture"

# The bound this palier reads. It is asserted against what the gate prints, not
# trusted: the whole point of the estate phase is that both numbers come from
# the compiled product.
bound=64

workdir=$(mktemp -d)
trap 'rm -rf "$workdir"' EXIT

fail() { echo "FAILED: $*" >&2; exit 1; }

# The mandatory inventory guard: read the LAB before mutating any of it.
inventory() {
  local vm=$1 line state_column ips template topology origin
  line=$("$labctl" list --format=tsv | awk -v vm="$vm" -F'\t' '$1 == vm')
  [[ -n "$line" ]] || fail "$vm is not part of the LAB inventory"
  IFS=$'\t' read -r _ state_column ips template topology origin <<<"$line"
  [[ "$origin" == "$expected_origin" ]] || fail "$vm carries the origin $origin"
  [[ "$state_column" == running ]] || fail "$vm is $state_column"
  [[ "$topology" == quick ]] || fail "$vm belongs to the topology $topology"
  [[ "$ips" != *,* ]] || fail "$vm holds several addresses: $ips"
  [[ "$ips" != 192.168.122.123 && "$ips" != 10.66.66.1 ]] \
    || fail "$vm holds an address this project never mutates"
  echo "$ips"
}

# Every verdict of this harness is a line the fixture printed. `expect` compares
# that line to what the palier says it must be, and prints both when they
# differ — a harness that only checked an exit code would stay green against a
# gate that had started refusing for the wrong reason.
expect() {
  [[ $# -eq 3 ]] || fail "internal expectation is invalid"
  local label=$1 wanted=$2 observed=$3
  if [[ "$observed" != *"$wanted"* ]]; then
    printf 'FAILED: %s\n  wanted: %s\n  observed: %s\n' "$label" "$wanted" "$observed" >&2
    exit 1
  fi
  printf '  %-56s %s\n' "$label" "$wanted"
}

remote_console() { "$labctl" ssh "$console_vm" -- "$@"; }

# ---------------------------------------------------------------------------

do_artifact() {
  echo "==> artifact"
  inventory "$console_vm" >/dev/null

  # The Controller builds this palier's fixture from the sources of this very
  # run. `package.json` travels with `src-tauri` because `tauri.conf.json` reads
  # its version from it, and the build cache is deliberately kept. `-m` stamps
  # every extracted file with the extraction time, so Cargo cannot decide that
  # sources older than a warm artefact need no rebuild — a pass that was green
  # about code that was never compiled is worse than a slow one.
  tar -C "$root/console" --exclude=target -czf "$workdir/console.tgz" src-tauri package.json
  "$labctl" ssh "$console_vm" -- "rm -rf $remote_harness && install -d -m 0700 $remote_harness"
  "$labctl" copy-to "$console_vm" "$workdir/console.tgz" "$remote_harness/console.tgz" >/dev/null
  remote_console "
set -e
install -d /root/work
rm -f /root/work/package.json
if [ -d /root/work/src-tauri ]; then
  find /root/work/src-tauri -mindepth 1 -maxdepth 1 ! -name target -exec rm -rf {} +
fi
tar -C /root/work -xzmf $remote_harness/console.tgz
rm -f $remote_harness/console.tgz"

  remote_console "
set -e
. /root/.cargo/env
install -d -m 0700 $state
cd /root/work/src-tauri
export CARGO_BUILD_JOBS=1 LC_ALL=C.UTF-8
cargo +1.94.1 build --locked --offline -j 1 -p your-cloud-native-bootstrap-assistant \
  --features machine-identity-contract-test --bin your-cloud-machine-identity-fixture >/dev/null 2>&1
install -m 0700 target/debug/your-cloud-machine-identity-fixture $fixture"
  echo "  fixture built in $console_vm from this run's sources"
}

do_setup() {
  echo "==> setup"
  local console_address target_address mounted provenance
  console_address=$(inventory "$console_vm")
  target_address=$(inventory "$target_vm")

  # Sixty-five real Ed25519 pairs. The sixty-fifth exists only to be refused,
  # and it is a real key so that the refusal is about the count and nothing else.
  remote_console "
set -e
install -d -m 0700 $state $state/keys
rm -f $state/keys/* $state/perimeter.* $state/provenance.*
index=0
while [ \$index -le $bound ]; do
  ssh-keygen -q -t ed25519 -N '' -C '' -f $state/keys/id-\$index
  index=\$((index + 1))
done
chmod 0600 $state/keys/id-*"

  # The perimeter files, each one line per identity, written from what
  # `ssh-keygen` reads back off the real public keys.
  remote_console "
set -e
name_of() {
  case \$1 in
    0) echo $console_vm ;;
    1) echo $target_vm ;;
    *) echo lab-declared-\$1 ;;
  esac
}
fingerprint_of() { ssh-keygen -lf $state/keys/id-\$1.pub | awk '{print \$2}'; }
: >$state/perimeter.full
index=0
while [ \$index -le $bound ]; do
  printf 'identity\t%s\t%s\n' \"\$(name_of \$index)\" \"\$(fingerprint_of \$index)\" >>$state/perimeter.full
  index=\$((index + 1))
done
head -n $bound $state/perimeter.full >$state/perimeter.bound
cp $state/perimeter.full $state/perimeter.over
# The same estate, but the last machine handed the first machine's identity.
head -n \$(($bound - 1)) $state/perimeter.bound >$state/perimeter.shared
printf 'identity\t%s\t%s\n' lab-declared-$((bound - 1)) \"\$(fingerprint_of 0)\" >>$state/perimeter.shared
# The same estate, but the last line naming a machine already in it.
head -n \$(($bound - 1)) $state/perimeter.bound >$state/perimeter.duplicate
printf 'identity\t%s\t%s\n' $console_vm \"\$(fingerprint_of \$(($bound - 1)))\" >>$state/perimeter.duplicate"

  for vm in "$console_vm" "$target_vm"; do
    "$labctl" ssh "$vm" -- "rm -rf $remote_harness && install -d -m 0700 $remote_harness"
    for script in mount-machine remove-machine; do
      "$labctl" copy-to "$vm" "$harness/$script" "$remote_harness/$script" >/dev/null
      "$labctl" ssh "$vm" -- "chmod 0700 $remote_harness/$script"
    done
  done

  # Index 0 belongs to the Controller's own machine, index 1 to the target. Each
  # public key travels through the managed channel; no private key ever leaves
  # the Controller.
  "$labctl" copy-from "$console_vm" "$state/keys/id-0.pub" "$workdir/id-0.pub" >/dev/null
  "$labctl" copy-from "$console_vm" "$state/keys/id-1.pub" "$workdir/id-1.pub" >/dev/null
  "$labctl" copy-to "$console_vm" "$workdir/id-0.pub" "$remote_harness/held.pub" >/dev/null
  "$labctl" copy-to "$target_vm" "$workdir/id-1.pub" "$remote_harness/held.pub" >/dev/null

  : >"$workdir/provenance"
  for vm in "$console_vm" "$target_vm"; do
    mounted=$("$labctl" ssh "$vm" -- "$remote_harness/mount-machine $account $remote_harness/held.pub")
    printf '%s\n' "$mounted"
    provenance=$(sed -n 's/.*provenance=\([A-Z]*\).*/\1/p' <<<"$mounted")
    [[ -n "$provenance" ]] || fail "$vm did not report the account provenance"
    printf '%s\t%s\n' "$vm" "$provenance" >>"$workdir/provenance"
  done
  "$labctl" copy-to "$console_vm" "$workdir/provenance" "$state/provenance.accounts" >/dev/null

  # The host keys are pinned from what the managed channel read, never from a
  # first answer of the network.
  : >"$workdir/known_hosts"
  for pair in "$console_vm:$console_address" "$target_vm:$target_address"; do
    local vm=${pair%%:*} address=${pair#*:}
    printf '%s %s\n' "$address" "$("$labctl" ssh "$vm" -- cat /etc/ssh/ssh_host_ed25519_key.pub | cut -d' ' -f1,2)" \
      >>"$workdir/known_hosts"
  done
  "$labctl" copy-to "$console_vm" "$workdir/known_hosts" "$state/known_hosts" >/dev/null
  remote_console "chmod 0600 $state/known_hosts
printf '%s\n' '$console_address' >$state/address.$console_vm
printf '%s\n' '$target_address' >$state/address.$target_vm"
  echo "  perimeter mounted on both machines, host keys pinned from the managed channel"
}

do_estate() {
  echo "==> estate"
  local minted

  minted=$(remote_console "$fixture estate $state/perimeter.bound") \
    || fail "the gate refused an estate of exactly the bound: $minted"
  expect "an estate of exactly the bound is minted whole" \
    "MINTED count=$bound bound=$bound" "$minted"
  expect "and it is the estate this run declared" \
    "first=$console_vm last=lab-declared-$((bound - 1))" "$minted"

  cat <<EOF

  REPRESENTATIVITY real=2/$bound declared-only=$((bound - 2))/$bound

    $console_vm     a real machine of the topology, really holding this identity
    $target_vm   a real machine of the topology, really holding this identity
    lab-declared-2 … lab-declared-$((bound - 1))
                    real Ed25519 identities that no machine holds

  Sixty-four machines are not proved. What is proved is that the gate mints an
  estate of sixty-four real identities, and that where a machine really exists
  its judgement matches what that machine really does. A LAB of this topology
  cannot say more, and this notice exists so that no report says more either.

EOF
}

do_refuse() {
  echo "==> refuse"
  local observed

  observed=$(remote_console "$fixture estate $state/perimeter.over" || true)
  expect "one machine past the bound is refused by name" \
    "REFUSED TooManyMachines { count: $((bound + 1)) }" "$observed"

  observed=$(remote_console "$fixture estate $state/perimeter.shared" || true)
  expect "two machines sharing an identity, at the bound" \
    "REFUSED SharedIdentity" "$observed"
  expect "and the refusal names both of them" \
    "other: \"$console_vm\"" "$observed"

  observed=$(remote_console "$fixture estate $state/perimeter.duplicate" || true)
  expect "the same machine declared twice, at the bound" \
    "REFUSED DuplicateMachine" "$observed"
}

# The one phase where the gate is confronted with something other than itself.
do_agree() {
  echo "==> agree"
  local held_here held_there judged opened refused console_address target_address

  console_address=$(remote_console "cat $state/address.$console_vm")
  target_address=$(remote_console "cat $state/address.$target_vm")
  held_here=$(remote_console "ssh-keygen -lf $state/keys/id-0.pub | awk '{print \$2}'")
  held_there=$(remote_console "ssh-keygen -lf $state/keys/id-1.pub | awk '{print \$2}'")

  # What the compiled gate decides.
  judged=$(remote_console "$fixture admits $state/perimeter.bound $console_vm $held_here")
  expect "the gate admits $console_vm its own identity" "ADMITTED machine=$console_vm" "$judged"
  judged=$(remote_console "$fixture admits $state/perimeter.bound $console_vm $held_there" || true)
  expect "the gate refuses it the identity of $target_vm, and names the owner" \
    "ForeignIdentity { machine: \"$console_vm\", owner: \"$target_vm\" }" "$judged"
  judged=$(remote_console "$fixture admits $state/perimeter.bound $target_vm $held_there")
  expect "the gate admits $target_vm its own identity" "ADMITTED machine=$target_vm" "$judged"
  judged=$(remote_console "$fixture admits $state/perimeter.bound $target_vm $held_here" || true)
  expect "the gate refuses it the identity of $console_vm, and names the owner" \
    "ForeignIdentity { machine: \"$target_vm\", owner: \"$console_vm\" }" "$judged"

  # What a real sshd decides, on the same four pairs. The sessions are opened
  # from the Controller, which is the only side holding private material.
  attempt() {
    local key=$1 address=$2
    remote_console "
ssh -i $state/keys/id-$key \
  -o UserKnownHostsFile=$state/known_hosts -o StrictHostKeyChecking=yes \
  -o IdentitiesOnly=yes -o PasswordAuthentication=no -o BatchMode=yes \
  -o ConnectTimeout=10 $account@$address true 2>&1" || true
  }

  opened=$(attempt 0 "$console_address")
  [[ -z "$opened" ]] || fail "a real sshd refused $console_vm its own identity: $opened"
  printf '  %-56s %s\n' "a real sshd admits $console_vm its own identity" "session opened"

  opened=$(attempt 1 "$target_address")
  [[ -z "$opened" ]] || fail "a real sshd refused $target_vm its own identity: $opened"
  printf '  %-56s %s\n' "a real sshd admits $target_vm its own identity" "session opened"

  refused=$(attempt 1 "$console_address")
  expect "a real sshd refuses $console_vm the other identity" "Permission denied" "$refused"
  refused=$(attempt 0 "$target_address")
  expect "a real sshd refuses $target_vm the other identity" "Permission denied" "$refused"

  echo "  the gate and the machines agree on all four pairs"
}

# The epreuve by mutation. Without it nothing says these assertions bite: a
# harness whose expectations are all satisfied by a gate that stopped deciding
# is a green script, not a proof.
do_mutate() {
  echo "==> mutate"
  local source=/root/work/src-tauri/crates/native-bootstrap-assistant/src/machine_identity/identity.rs
  local observed status=0

  remote_console "
set -e
test -f $source
cp $source $state/identity.rs.original
sed -i 's/^pub const MAX_ENROLLED_MACHINES: usize = $bound;\$/pub const MAX_ENROLLED_MACHINES: usize = $((bound + 1));/' $source
# A mutation whose target moved must fail loudly instead of leaving the suite
# green for nothing.
grep -q '^pub const MAX_ENROLLED_MACHINES: usize = $((bound + 1));\$' $source"

  rebuild_fixture || status=$?
  if [[ $status -eq 0 ]]; then
    observed=$(remote_console "$fixture estate $state/perimeter.over" || true)
    if [[ "$observed" == *"MINTED count=$((bound + 1))"* ]]; then
      printf '  %-56s %s\n' "MUTATION_CAUGHT: the bound stopped bounding" \
        "the mutated gate minted $((bound + 1))"
    else
      echo "FAILED: the mutation did not change what the gate decides: $observed" >&2
      status=1
    fi
  fi

  # Restored whatever happened above: a mutated source left behind would make
  # every later run of this LAB judge something the repository does not hold.
  remote_console "
set -e
test -f $state/identity.rs.original
cp $state/identity.rs.original $source
rm -f $state/identity.rs.original
grep -q '^pub const MAX_ENROLLED_MACHINES: usize = $bound;\$' $source"
  rebuild_fixture || fail "the fixture could not be rebuilt from the restored source"

  observed=$(remote_console "$fixture estate $state/perimeter.over" || true)
  expect "the restored gate refuses the count again" \
    "REFUSED TooManyMachines { count: $((bound + 1)) }" "$observed"

  [[ $status -eq 0 ]] || exit "$status"
}

rebuild_fixture() {
  remote_console "
set -e
. /root/.cargo/env
cd /root/work/src-tauri
export CARGO_BUILD_JOBS=1 LC_ALL=C.UTF-8
cargo +1.94.1 build --locked --offline -j 1 -p your-cloud-native-bootstrap-assistant \
  --features machine-identity-contract-test --bin your-cloud-machine-identity-fixture >/dev/null 2>&1
install -m 0700 target/debug/your-cloud-machine-identity-fixture $fixture"
}

do_remove() {
  echo "==> remove"
  local provenance removed

  for vm in "$console_vm" "$target_vm"; do
    provenance=$(awk -F'\t' -v vm="$vm" '$1 == vm {print $2}' <<<"$(
      "$labctl" ssh "$console_vm" -- "cat $state/provenance.accounts 2>/dev/null || true"
    )")
    [[ -n "$provenance" ]] || provenance=CREATED
    if "$labctl" ssh "$vm" -- "test -x $remote_harness/remove-machine"; then
      removed=$("$labctl" ssh "$vm" -- "$remote_harness/remove-machine $account $provenance") \
        || fail "$vm could not be returned to its initial state"
      printf '  %-16s %s\n' "$vm" "$removed"
    fi
    "$labctl" ssh "$vm" -- "rm -rf $remote_harness"
    "$labctl" ssh "$vm" -- "test ! -e $remote_harness" \
      || fail "the harness survives on $vm"
  done

  # A mutation an interrupted run left behind is undone before anything else:
  # a source left mutated would make every later run judge something the
  # repository does not hold.
  remote_console "
source=/root/work/src-tauri/crates/native-bootstrap-assistant/src/machine_identity/identity.rs
if [ -f $state/identity.rs.original ]; then
  cp $state/identity.rs.original \$source
  rm -f $state/identity.rs.original
  echo '  restored a source a previous run left mutated'
fi" || true

  # The private material is destroyed, not merely unlinked from a perimeter.
  remote_console "
set -e
if [ -d $state/keys ]; then
  find $state/keys -type f -exec shred -u {} + 2>/dev/null || rm -f $state/keys/*
fi
rm -rf $state"
  remote_console "test ! -e $state" || fail "the perimeter survives on $console_vm"
  echo "  both machines returned to their initial state, key material destroyed"
}

# ---------------------------------------------------------------------------

case "$command" in
  artifact) do_artifact ;;
  setup) do_setup ;;
  estate) do_estate ;;
  refuse) do_refuse ;;
  agree) do_agree ;;
  mutate) do_mutate ;;
  remove) do_remove ;;
  all)
    status=0
    (
      do_artifact
      do_setup
      do_estate
      do_refuse
      do_agree
      do_mutate
    ) || status=$?
    do_remove || status=$?
    [[ $status -eq 0 ]] || exit "$status"
    echo
    echo "PROVE_ENROLMENT_BOUNDS_OK bound=$bound real=2 declared-only=$((bound - 2))"
    ;;
esac
