  It is necessary and not sufficient. Three requirements of v0.1.0 name a SHA
  attested by the hosted gate — the palier issues all closed, the artifacts
  matching the announced revision, the tag designating the SHA of the final
  matrix. No local execution produces that attestation, and this report says so
  rather than letting a reader discover it.

  It says what was constated on machines of a reference LAB scenario. It does
  not say what the product would do on a real infrastructure.

report written: $(date -u +%Y-%m-%dT%H:%M:%SZ)
EOF
  } >"$report_file" || {
    report_status=failed
    return 1
  }
  chmod 0644 "$report_file"

  (cd "$artifact_dir" && sha256sum report.txt >proof-checksum.txt) || {
    report_status=failed
    return 1
  }
  chmod 0644 "$proof_checksum_file"

  (cd "$artifact_dir" && sha256sum -c proof-checksum.txt) || status=$?
  if [[ $status -ne 0 ]]; then
    report_status=failed
    echo "FAILED: the report's own seal does not verify" >&2
    return 1
  fi
  report_status=sealed
  printf 'report=%s\n' "$report_file"
  printf 'seal=%s\n' "$proof_checksum_file"
  return 0
}

# ---------------------------------------------------------------------------

case "$command" in
  guard)
    do_guard
    ;;
  run)
    do_guard
    do_run
    ;;
  close)
    topology_owned=1
    do_close
    ;;
  all)
    do_guard
    run_status=0
    do_run || run_status=$?
    do_close || fail "the LAB could not be closed"
    [[ $run_status -eq 0 && -z "$first_red" ]] || exit 1
    ;;
  complete)
    # The order of #19, in one place: a clean base, the passes, the artifacts,
    # the closure, the report. The closure runs whatever happened before it,
    # because a proof that fails and leaves a topology up has failed twice.
    do_rebuild || fail "the topology could not be rebuilt from nothing"
    do_guard
    run_status=0
    do_run || run_status=$?
    artifacts_status_ok=0
    do_artifacts || artifacts_status_ok=$?
    close_ok=0
    do_close || close_ok=$?
    do_report || echo "the report could not be written or sealed" >&2
    [[ $close_ok -eq 0 ]] || fail "the LAB could not be closed"
    [[ $run_status -eq 0 && $artifacts_status_ok -eq 0 && -z "$first_red" ]] || exit 1
    [[ "$assert_clean_status" == green ]] \
      || fail "assert-clean is not green: #19 requires it green at the end, without an exception added by hand"
    [[ "$report_status" == sealed ]] || fail "the report was not sealed"
    ;;
esac
