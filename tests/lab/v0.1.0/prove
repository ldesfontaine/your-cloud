#!/usr/bin/env bash
# Orchestrate the v0.1.0 LAB proofs: the bootstrap-and-replacement palier (#41)
# and, under `complete`, the whole v0.1.0 proof of `#19` / `#112`.
#
# This file proves nothing by itself. Every verdict is rendered by one of the
# harnesses under this directory, each of which mounts its own perimeter, judges
# through the compiled product and removes what it mounted. What this
# orchestrator adds is the three things a global proof needs and no single
# harness can give:
#
#   a revision   every pass runs against the same tree, named once and recorded
#   an order     the passes run one after another on shared VM, never together
#   a closure    the topology this run owns is destroyed, and what remains is
#                named rather than left for a human to notice
#
# The first red is kept: the pass that failed stops the sequence, its log is
# retained whole, and the closure still runs. A pass killed on its bound is
# forced through its own `remove` before the next thing happens, because a bound
# that leaves a perimeter mounted is worse than no bound at all.
#
# `complete` is the mode `#112` adds, and it is a mode of *this* orchestrator
# rather than a second one, because the contract of `#19` asks for one order and
# one report. What it adds to `all` is the four things the complete proof needs:
#
#   a real base    the topology is destroyed, created and provisioned before the
#                  first pass, so no pass inherits anything from an earlier run
#   every palier   the five palier harnesses run after the #13 passes, each one
#                  replayed AS IS — a harness edited for this occasion would
#                  prove something other than what its palier closed
#   the artifacts  `tools/release-artifacts` writes the four deterministic files
#                  of the closed list, and their determinism is a command here
#   one report     `report.txt`, sealed by its own `proof-checksum.txt` beside
#                  it, in the exact format of `checksums.txt` (the #111 decision)
#
# Two orderings of `complete` are decisions rather than accidents, and both are
# written into the report they govern:
#
#   the artifacts are produced only when every harness passed. A failing harness
#   stops the sequence, and release artifacts cut from a red run would read as a
#   release candidate that no run supports;
#
#   the report is written after the closure, not before it. `labctl assert-clean`
#   is the run's last constat on machines, and a report that omitted its own
#   closure would be a report with a hole. Its seal is therefore taken once,
#   over a whole document, and never reopened.
set -euo pipefail
export LC_ALL=C.UTF-8

usage() {
  cat >&2 <<'EOF'
usage: prove [guard | run [passe...] | close | all [passe...] | complete]

  guard     read the LAB, prove the topology is the approved one, name the revision
  run       run the passes in dependency order, keeping the topology mounted
  close     destroy the topology this run owns and read `labctl assert-clean`
  all       the three above in order, closing even when a pass fails (default)
  complete  the whole v0.1.0 proof of #19 / #112, from a topology really
            destroyed then created then provisioned: the #13 passes, then the
            five palier harnesses in the product's order, then the release
            artifacts, then the closure, then the single sealed report

  Passes, in the order they run:

    personal-access         #51 #52   the access every later pass travels over
    signed-approval         #37       the approval anchor and its anti-replay
    controller-install      #38       a Controller installed from the bundle
    machine-identity        #39       one SSH identity per machine, roles opened
    enrolment-bounds        #41       an estate of sixty-four, and the sixty-fifth refused
    controller-replacement  #40       a Controller replaced, authorities withdrawn

  Under `complete`, and only there, five more harnesses run after those six,
  in the order the product establishes them:

    oci-plan                #14       the controlled plan and its OCI probe
    public-profile          #15       the public profile, HTTPS read from outside
    private-passage         #16       the bounded tunnel and its refusals
    private-service         #17       the private profile, its data, its archives
    external-element        #18       representing without owning

  Each is invoked through its own entry point with its own `all`, so it does its
  own setup, its own reboots and its own teardown, in its own order. Nothing of
  a harness is reordered, skipped or edited by this file.

  `windows-helper` is never part of any sequence here, `complete` included: its
  machine lives outside labctl and outside this topology. It is reported as not
  run, never as passed.

  Outside `complete`, the five harnesses above are not part of the sequence, and
  each for its own reason:

  `oci-plan` renders the controlled OCI plan palier (#14, proof #86), not the
  bootstrap and replacement palier this sequence renders. It mounts and removes
  its own perimeter on lab-machine-1 and is run by its own entry point.

  `public-profile` is not part of it for the same reason as `oci-plan`: it
  renders the public BentoPDF profile palier (#15, proof #92). Its machine is
  `lab-vps`, which this sequence never touches, and it is run by its own entry
  point.

  `private-passage`, `private-service` and `external-element` are not part of it
  either, and for the same reason: they render the private passage palier (#16,
  machine proof #98), the private Vaultwarden profile palier (#17, proof #104)
  and the external responsibility palier (#18, proof #109). Each needs several
  machines of this topology at once and two of them power cycle machines, so
  none ever runs beside these passes; each is run by its own entry point.
EOF
  exit 2
}

command=${1:-all}
[[ $# -eq 0 ]] || shift
case "$command" in
  guard | close | complete) [[ $# -eq 0 ]] || usage ;;
  run | all) ;;
  *) usage ;;
esac

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../.." && pwd)
here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
labctl="$root/tools/labctl"
topology=quick
expected_origin=your-cloud/labctl
forbidden_addresses=(192.168.122.123 10.66.66.1)

# Every pass, in dependency order, with the bound it may not exceed. The bounds
# are wall-clock ceilings, not expectations: they exist so a hung pass ends as a
# named failure instead of an unattended night. They are generous because these
# harnesses build Rust and Go on the machines and power cycle them, and a bound
# that a healthy run can reach would turn a slow build into a false red.
bootstrap_passes=(
  personal-access
  signed-approval
  controller-install
  machine-identity
  enrolment-bounds
  controller-replacement
)
# The five palier harnesses, in the order of the product rather than in the
# order they were written: the mechanism before any load, the public entry
# before the private passage, the passage before the service that travels it,
# and the external element last because it is about what the product never
# installed. `#19` fixes this order and this file does not choose it.
palier_passes=(
  oci-plan
  public-profile
  private-passage
  private-service
  external-element
)
pass_names=("${bootstrap_passes[@]}")
declare -A pass_bound=(
  [personal-access]=5400
  [signed-approval]=1800
  [controller-install]=3600
  [machine-identity]=2700
  [enrolment-bounds]=2700
  [controller-replacement]=3600
  [oci-plan]=5400
  [public-profile]=5400
  [private-passage]=7200
  [private-service]=9000
  [external-element]=7200
)
declare -A pass_issue=(
  [personal-access]="#51 #52"
  [signed-approval]="#37"
  [controller-install]="#38"
  [machine-identity]="#39"
  [enrolment-bounds]="#41"
  [controller-replacement]="#40"
  [oci-plan]="#14 #86"
  [public-profile]="#15 #92"
  [private-passage]="#16 #98"
  [private-service]="#17 #104"
  [external-element]="#18 #109"
)
declare -A vm_template=(
  [lab-console]=console
  [lab-machine-1]=machine
  [lab-vps]=machine
)
vm_names=(lab-console lab-machine-1)

# `complete` is the only mode that speaks to lab-vps, that creates a topology
# and that produces artifacts. Everything else about it is the same code, which
# is the point: the per-palier proofs stay individually runnable and behave
# exactly as they did.
complete_mode=0
if [[ "$command" == complete ]]; then
  complete_mode=1
  vm_names=(lab-console lab-machine-1 lab-vps)
  pass_names=("${bootstrap_passes[@]}" "${palier_passes[@]}")
fi

selected=()
if [[ $# -gt 0 ]]; then
  for requested in "$@"; do
    found=0
    for name in "${pass_names[@]}"; do
      [[ "$name" == "$requested" ]] && found=1 && break
    done
    [[ $found -eq 1 ]] || { echo "unknown pass: $requested" >&2; usage; }
    selected+=("$requested")
  done
else
  selected=("${pass_names[@]}")
fi

workdir=$(mktemp -d)
run_id=$(date -u +%Y%m%dT%H%M%SZ)-$$
[[ "$run_id" =~ ^[0-9]{8}T[0-9]{6}Z-[1-9][0-9]*$ ]] \
  || { echo "invalid v0.1.0 proof run identifier" >&2; /bin/rm -rf "$workdir"; exit 1; }
# The complete proof is a different `<preuve>` of the artifact convention than
# the bootstrap palier, and it gets its own directory rather than sharing one:
# a reader who opens `v0.1.0/<run>` must not have to guess whether the run he
# is reading judged six passes or eleven.
if [[ $complete_mode -eq 1 ]]; then
  result_root="$root/tests/artifacts/proofs/v0.1.0-complete"
else
  result_root="$root/tests/artifacts/proofs/v0.1.0"
fi
result_dir="$result_root/$run_id"
result_file="$result_dir/result.json"
artifact_dir="$result_dir/artifacts"
report_file="$artifact_dir/report.txt"
proof_checksum_file="$artifact_dir/proof-checksum.txt"
mkdir -p "$result_root"
[[ ! -e "$result_dir" && ! -L "$result_dir" ]] \
  || { echo "v0.1.0 proof result path already exists" >&2; /bin/rm -rf "$workdir"; exit 1; }
mkdir -m 0755 "$result_dir" \
  || { echo "cannot create the v0.1.0 proof result path" >&2; /bin/rm -rf "$workdir"; exit 1; }

revision=
started_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
finished_at=
proof_outcome=failed
failure_class=not_started
first_red=
guard_passed=0
topology_owned=0
close_status=not_run
assert_clean_status=not_run
declare -a assert_clean_residue=()
declare -a pass_results=()
declare -A vm_address=()
declare -A pass_report=()
current_pass=

# The complete run's own state. Every one of these is written into the report,
# and none of them is inferred: a rebuild that did not happen says `not_run`.
rebuild_status=not_run
rebuild_started_at=
rebuild_finished_at=
rebuild_seconds=0
declare -A rebuild_step_seconds=()
declare -A rebuild_step_status=()
rebuild_steps=(destroy create provision)
artifacts_status=not_run
artifacts_reason=
determinism_status=not_run
third_party_status=not_run
report_status=not_run
declare -a artifact_digests=()

fail() { echo "FAILED: $*" >&2; exit 1; }

json_escape() {
  local value=$1
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  value=${value//$'\n'/\\n}
  value=${value//$'\r'/}
  value=${value//$'\t'/\\t}
  printf '%s' "$value"
}

json_value() {
  if [[ -n "$1" ]]; then
    printf '"%s"' "$(json_escape "$1")"
  else
    printf 'null'
  fi
}

json_array() {
  local index total=$#
  printf '['
  for ((index = 1; index <= total; index++)); do
    printf '%s' "$(json_value "${!index}")"
    [[ $index -eq $total ]] || printf ', '
  done
  printf ']'
}

announce() { printf '\n==> %s\n' "$*"; }

# A bound around every LAB call, so a wedged transport is a named failure rather
# than a hang. The status is returned untouched; only the wait is capped.
bounded_labctl() {
  [[ $# -ge 2 ]] || fail "internal bounded labctl invocation is invalid"
  local seconds=$1 operation=$2 status=0
  shift 2
  timeout --signal=TERM --kill-after=10s "$seconds" "$labctl" "$operation" "$@" || status=$?
  return "$status"
}

lab_list() { bounded_labctl 60s list "$@"; }
lab_ip() { bounded_labctl 60s ip "$@"; }
lab_start() { bounded_labctl 300s start "$@"; }
lab_ssh() { bounded_labctl 300s ssh "$@"; }

# A machine that was just started has no swap: the LAB's swapfile is deliberately
# absent from `/etc/fstab`, so it survives `labctl stop` on disk but not in use.
# Several passes compile the Console crate, and that compilation is killed by the
# OOM reaper without it — a failure that would be read as a product red.
#
# This is a provisioning fact of the LAB, not a behaviour of the product. It is
# repaired here rather than asserted, because a proof that dies of a missing
# swapfile has measured the swapfile and nothing else.
restore_swap() {
  local vm=$1
  lab_ssh "$vm" test -f /swapfile || return 0
  if [[ -z "$(lab_ssh "$vm" swapon --noheadings --show 2>/dev/null || true)" ]]; then
    announce "Re-enabling the swapfile on $vm, which a restart leaves unused"
    lab_ssh "$vm" swapon /swapfile || return 1
  fi
  return 0
}

# The pilot's own paths never reach a published log. The LAB itself is entirely
# synthetic — identities are minted at mount time and destroyed at removal — so
# the only real-world strings that can appear are the ones naming this machine.
redact() {
  sed -e "s#$root#<repo>#g" -e "s#$HOME#<home>#g" -e "s#$(id -un)#<user>#g"
}

record_pass() {
  [[ $# -eq 4 ]] || fail "internal pass record is invalid"
  local name=$1 status=$2 seconds=$3 log=$4
  pass_results+=("{\"pass\":\"$(json_escape "$name")\",\"issues\":\"$(json_escape "${pass_issue[$name]}")\",\"status\":\"$status\",\"duration_seconds\":$seconds,\"bound_seconds\":${pass_bound[$name]},\"log\":\"$(json_escape "$log")\"}")
}

write_result() {
  local index temporary="$result_dir/.result-$run_id.tmp"
  [[ ! -L "$temporary" ]] || return 1
  {
    printf '{\n'
    printf '  "schema": 1,\n'
    if [[ $complete_mode -eq 1 ]]; then
      printf '  "proof": "your-cloud-v0.1.0-complete",\n'
      printf '  "issue": "#112",\n'
      printf '  "contract": "docs/objectifs/v1/PREUVE-COMPLETE.md (#19, addendum #111)",\n'
    else
      printf '  "proof": "your-cloud-v0.1.0-bootstrap-and-replacement",\n'
      printf '  "issue": "#41",\n'
    fi
    printf '  "run_id": "%s",\n' "$run_id"
    printf '  "phase": "%s",\n' "$command"
    printf '  "complete": %s,\n' \
      "$([[ ( "$command" == all || "$command" == complete ) && ${#selected[@]} -eq ${#pass_names[@]} ]] && echo true || echo false)"
    printf '  "passes_declared": %d,\n' "${#pass_names[@]}"
    printf '  "passes_selected": %d,\n' "${#selected[@]}"
    printf '  "outcome": "%s",\n' "$proof_outcome"
    printf '  "failure_class": '; json_value "$failure_class"; printf ',\n'
    printf '  "first_red": '; json_value "$first_red"; printf ',\n'
    printf '  "revision": '; json_value "$revision"; printf ',\n'
    printf '  "topology": "%s",\n' "$topology"
    printf '  "started_at": '; json_value "$started_at"; printf ',\n'
    printf '  "finished_at": '; json_value "$finished_at"; printf ',\n'
    printf '  "redaction": {"policy": "pilot-paths-removed", "lab_material": "synthetic-only"},\n'
    printf '  "closure": {"status": "%s", "assert_clean": "%s", "retained_outside_this_run": ' \
      "$close_status" "$assert_clean_status"
    json_array "${assert_clean_residue[@]}"; printf '},\n'
    if [[ $complete_mode -eq 1 ]]; then
      printf '  "clean_base": {"status": "%s", "started_at": ' "$rebuild_status"
      json_value "$rebuild_started_at"; printf ', "finished_at": '
      json_value "$rebuild_finished_at"
      printf ', "duration_seconds": %d, "steps": [' "$rebuild_seconds"
      for index in "${!rebuild_steps[@]}"; do
        printf '{"step": "%s", "command": "%s", "status": "%s", "duration_seconds": %d}' \
          "${rebuild_steps[$index]}" \
          "$(case "${rebuild_steps[$index]}" in
              destroy) echo "tools/labctl topology destroy $topology" ;;
              create) echo "tools/labctl topology create $topology" ;;
              provision) echo "tools/provision-lab all" ;;
            esac)" \
          "${rebuild_step_status[${rebuild_steps[$index]}]:-not_run}" \
          "${rebuild_step_seconds[${rebuild_steps[$index]}]:-0}"
        [[ $index -eq $((${#rebuild_steps[@]} - 1)) ]] || printf ', '
      done
      printf ']},\n'
      printf '  "artifacts": {"status": "%s", "reason": ' "$artifacts_status"
      json_value "$artifacts_reason"
      printf ', "determinism": "%s", "third_party_check": "%s", "report": "%s", "directory": ' \
        "$determinism_status" "$third_party_status" "$report_status"
      json_value "$([[ $artifacts_status == passed ]] && echo "artifacts")"
      printf ', "files": '
      json_array "${artifact_digests[@]}"; printf '},\n'
    fi
    printf '  "not_run": [\n'
    printf '    {"pass": "windows-helper", "reason": "its evaluation machine lives outside labctl and outside this topology"}'
    if [[ $complete_mode -eq 1 ]]; then
      printf '\n'
    else
      printf ',\n'
      printf '    {"pass": "oci-plan", "reason": "it renders the controlled OCI plan palier (#14, proof #86), not the bootstrap and replacement this sequence proves"},\n'
      printf '    {"pass": "public-profile", "reason": "it renders the public BentoPDF profile palier (#15, proof #92) on lab-vps, not the bootstrap and replacement this sequence proves"},\n'
      printf '    {"pass": "private-passage", "reason": "it renders the private WireGuard passage palier (#16, proofs #96 and #97, machine proof #98) across lab-machine-1 and lab-vps, not the bootstrap and replacement this sequence proves"},\n'
      printf '    {"pass": "private-service", "reason": "it renders the private Vaultwarden profile palier (#17, proof #104) across lab-machine-1, lab-vps and lab-console, not the bootstrap and replacement this sequence proves"},\n'
      printf '    {"pass": "external-element", "reason": "it renders the external responsibility palier (#18, proof #109) across lab-machine-1, lab-vps and lab-console, not the bootstrap and replacement this sequence proves"}\n'
    fi
    printf '  ],\n'
    printf '  "passes": [\n'
    for index in "${!pass_results[@]}"; do
      printf '    %s' "${pass_results[$index]}"
      [[ $index -eq $((${#pass_results[@]} - 1)) ]] || printf ','
      printf '\n'
    done
    printf '  ]\n}\n'
  } >"$temporary" || { /bin/rm -f "$temporary"; return 1; }
  chmod 0644 "$temporary" || { /bin/rm -f "$temporary"; return 1; }
  mv -f -- "$temporary" "$result_file" || { /bin/rm -f "$temporary"; return 1; }
}

finish() {
  local status=$?
  trap - EXIT
  set +e
  finished_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  if [[ $status -eq 0 && -z "$first_red" ]]; then
    proof_outcome=passed
    failure_class=
  else
    proof_outcome=failed
    if [[ -z "$first_red" ]]; then
      first_red=${current_pass:-orchestration}
      [[ $guard_passed -eq 1 ]] || failure_class=infrastructure_failure
    fi
    [[ -n "$failure_class" && "$failure_class" != not_started ]] \
      || failure_class=product_or_assertion_failure
  fi
  if ! write_result; then
    echo "FAILED: the structured v0.1.0 result could not be published atomically" >&2
    /bin/rm -rf "$workdir"
    exit 1
  fi
  /bin/rm -rf "$workdir"
  printf '\nstructured_result=%s\n' "$result_file"
  if [[ "$proof_outcome" == passed ]]; then
    # A phase is not the palier, and a subset is not the sequence. Only a run
    # that guarded, played every pass and closed may say so; anything else says
    # what it actually did. The palier forbids a false global success, and the
    # cheapest way to produce one is a green word printed by a partial run.
    if [[ "$command" == complete ]]; then
      printf 'PROVE_V0_1_0_COMPLETE_OK revision=%s base=%s passes=%d artifacts=%s determinism=%s report=%s closure=%s assert-clean=%s\n' \
        "$revision" "$rebuild_status" "${#pass_results[@]}" "$artifacts_status" \
        "$determinism_status" "$report_status" "$close_status" "$assert_clean_status"
    elif [[ "$command" != all ]]; then
      printf 'PROVE_V0_1_0_PHASE_OK phase=%s revision=%s\n' "$command" "$revision"
    elif [[ ${#selected[@]} -ne ${#pass_names[@]} ]]; then
      printf 'PROVE_V0_1_0_PARTIAL_OK passes=%d/%d revision=%s\n' \
        "${#selected[@]}" "${#pass_names[@]}" "$revision"
    else
      printf 'PROVE_V0_1_0_OK revision=%s passes=%d closure=%s assert-clean=%s\n' \
        "$revision" "${#pass_results[@]}" "$close_status" "$assert_clean_status"
    fi
    exit 0
  fi
  printf 'PROVE_V0_1_0_FAILED first-red=%s class=%s\n' "$first_red" "$failure_class" >&2
  [[ $status -ne 0 ]] && exit "$status"
  exit 1
}
trap finish EXIT

# ---------------------------------------------------------------------------
# rebuild — `complete` only: the topology really ceases to exist, is created
# from the base image and is provisioned by the recipe
# ---------------------------------------------------------------------------
#
# `Propre` is not "the harnesses cleaned up after themselves". The contract of
# `#19` spells it as three commands, and this function is those three commands
# and nothing else. It runs once, before the first pass, and it is what makes
# every later constat a constat about machines that kept nothing.
#
# The destruction is not conditional on the topology existing: `topology
# destroy` is idempotent over an absent topology, and a run that skipped it
# because a listing looked empty would be trusting exactly the listing this
# stage exists to distrust.

do_rebuild() {
  local step status started ended seconds label
  announce "Rebuilding the topology '$topology' from nothing"
  printf 'This is what the contract of #19 calls a clean base: destroy, create,\n'
  printf 'provision. It costs twenty to thirty minutes, most of it the Rust\n'
  printf 'toolchain on lab-console, and it happens exactly once.\n'

  rebuild_started_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  local rebuild_began
  rebuild_began=$(date -u +%s)
  for step in "${rebuild_steps[@]}"; do
    rebuild_step_status[$step]=not_run
    rebuild_step_seconds[$step]=0
  done

  for step in "${rebuild_steps[@]}"; do
    status=0
    started=$(date -u +%s)
    case "$step" in
      destroy)
        label="tools/labctl topology destroy $topology"
        announce "$label"
        timeout --signal=TERM --kill-after=60s 1200 \
          "$labctl" topology destroy "$topology" || status=$?
        ;;
      create)
        label="tools/labctl topology create $topology"
        announce "$label"
        timeout --signal=TERM --kill-after=60s 2400 \
          "$labctl" topology create "$topology" || status=$?
        ;;
      provision)
        label="tools/provision-lab all"
        announce "$label"
        timeout --signal=TERM --kill-after=60s 7200 \
          "$root/tools/provision-lab" all || status=$?
        ;;
    esac
    ended=$(date -u +%s)
    seconds=$((ended - started))
    rebuild_step_seconds[$step]=$seconds
    if [[ $status -eq 0 ]]; then
      rebuild_step_status[$step]=passed
      printf 'REBUILT %s in %d s\n' "$step" "$seconds"
      # The topology is this run's from the moment its creation succeeded, and
      # not one step later: a provisioning that fails must still be closed.
      [[ "$step" == create ]] && topology_owned=1
    else
      rebuild_step_status[$step]=failed
      rebuild_finished_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
      rebuild_seconds=$(($(date -u +%s) - rebuild_began))
      rebuild_status=failed
      failure_class=infrastructure_failure
      first_red="rebuild:$step"
      echo "FAILED: $label ended with status $status" >&2
      return 1
    fi
  done

  rebuild_finished_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  rebuild_seconds=$(($(date -u +%s) - rebuild_began))
  rebuild_status=passed
  announce "The topology was destroyed, created and provisioned in $rebuild_seconds s"
  return 0
}

# ---------------------------------------------------------------------------
# guard — read the LAB before mutating any of it, and name the revision once
# ---------------------------------------------------------------------------

do_guard() {
  announce "Read-only LAB inventory guard"
  local inventory row state ips template row_topology origin extra vm waited address

  inventory=$(lab_list --format=tsv) || fail "labctl list guard failed"
  printf '%s\n' "$inventory"

  for vm in "${vm_names[@]}"; do
    row=$(awk -F '\t' -v name="$vm" 'NR > 1 && $1 == name {print}' <<<"$inventory")
    [[ -n "$row" && $(wc -l <<<"$row") -eq 1 ]] \
      || fail "inventory row missing or duplicated for $vm"
    IFS=$'\t' read -r _ state ips template row_topology origin extra <<<"$row"
    [[ -z "$extra" ]] || fail "inventory row for $vm carries unexpected columns"
    [[ "$origin" == "$expected_origin" ]] \
      || fail "$vm is not managed by $expected_origin; refusing to touch it"
    [[ "$template" == "${vm_template[$vm]}" ]] \
      || fail "$vm carries template '$template' instead of ${vm_template[$vm]}"
    [[ "$row_topology" == "$topology" ]] \
      || fail "$vm belongs to topology '$row_topology' instead of $topology"
  done

  # The passes all require a running machine with exactly one address. Starting
  # a stopped VM is this orchestrator's own mutation, and the only one it makes
  # outside a pass; it is therefore what makes the topology this run's to close.
  for vm in "${vm_names[@]}"; do
    state=$(awk -F '\t' -v name="$vm" 'NR > 1 && $1 == name {print $2}' <<<"$inventory")
    if [[ "$state" != running ]]; then
      announce "Starting $vm, which the inventory reports as '$state'"
      lab_start "$vm" || fail "cannot start $vm"
    fi
  done
  topology_owned=1

  for vm in "${vm_names[@]}"; do
    waited=0
    address=
    while [[ $waited -lt 180 ]]; do
      address=$(lab_ip "$vm" 2>/dev/null) || address=
      [[ -n "$address" && "$address" != - ]] && break
      sleep 5
      waited=$((waited + 5))
    done
    [[ -n "$address" && "$address" != - ]] \
      || fail "$vm carries no LAB address after $waited s"
    [[ $(wc -l <<<"$address") -eq 1 ]] \
      || fail "$vm carries several addresses; refusing an ambiguous target"
    for forbidden in "${forbidden_addresses[@]}"; do
      [[ "$address" != "$forbidden" ]] \
        || fail "$vm resolves to the forbidden address $forbidden"
    done
    lab_ssh "$vm" true || fail "$vm does not answer on the managed channel"
    restore_swap "$vm" || fail "$vm has a swapfile that could not be re-enabled"
    vm_address[$vm]=$address
    printf '  %-16s %s\n' "$vm" "running, one address ($address), answering"
  done

  revision=$(git -C "$root" rev-parse HEAD) || fail "cannot read the repository revision"
  if ! git -C "$root" diff --quiet \
    || ! git -C "$root" diff --cached --quiet \
    || [[ -n $(git -C "$root" ls-files --others --exclude-standard) ]]; then
    revision="$revision+worktree"
  fi
  printf '  %-16s %s\n' revision "$revision"
  case "$revision" in
    *+worktree)
      printf '\nLIMIT: this run judges an unpublished tree. The palier asks for an\n'
      printf 'exact SHA; a report built on "+worktree" names a state no one else\n'
      printf 'can fetch, and closes no line of the palier.\n'
      ;;
  esac
  guard_passed=1
}

# ---------------------------------------------------------------------------
# run — the passes, in order, one at a time, first red kept
# ---------------------------------------------------------------------------

assert_vm_back() {
  # Two passes really power off lab-console. Whatever a pass did to a machine,
  # the next one starts from a machine that is up and answering, or not at all.
  local vm state waited address back
  local -a machines=()
  read -r -a machines <<<"$1"
  for vm in "${machines[@]}"; do
    state=$(lab_list --format=tsv | awk -F '\t' -v name="$vm" 'NR > 1 && $1 == name {print $2}')
    if [[ "$state" != running ]]; then
      announce "Restarting $vm, left '$state' by the pass"
      lab_start "$vm" || return 1
    fi
    waited=0
    back=0
    while [[ $waited -lt 180 ]]; do
      address=$(lab_ip "$vm" 2>/dev/null) || address=
      if [[ -n "$address" && "$address" != - ]] && lab_ssh "$vm" true; then
        restore_swap "$vm" || return 1
        back=1
        break
      fi
      sleep 5
      waited=$((waited + 5))
    done
    [[ $back -eq 1 ]] || return 1
  done
  return 0
}

do_run() {
  local name script log started ended seconds status

  for name in "${selected[@]}"; do
    if [[ -n "$first_red" ]]; then
      announce "Not running $name: the sequence stopped at the first red"
      record_pass "$name" not_run 0 ""
      continue
    fi
    script="$here/$name/prove"
    [[ -x "$script" ]] || fail "pass entry point is missing or not executable: $script"
    current_pass=$name
    log="$result_dir/pass-$name.log"
    announce "$name (${pass_issue[$name]}) — bound ${pass_bound[$name]} s"

    started=$(date -u +%s)
    # The raw stream is kept live so a multi-hour pass can be watched, then
    # redacted into the published log. Reading PIPESTATUS rather than trusting
    # a process substitution is what makes the log whole when the pass dies.
    set +e
    timeout --signal=TERM --kill-after=60s "${pass_bound[$name]}" "$script" all 2>&1 \
      | tee "$workdir/raw-$name.log"
    status=${PIPESTATUS[0]}
    set -e
    redact <"$workdir/raw-$name.log" >"$log"
    ended=$(date -u +%s)
    seconds=$((ended - started))

    # The five palier harnesses publish a report of their own, and the complete
    # report points at it rather than paraphrasing it: the machine-level constats
    # belong to the harness that took them, and a summary of a summary is where
    # a limit goes missing.
    if [[ -d "$root/tests/artifacts/proofs/$name" ]]; then
      pass_report[$name]=$(ls -t -- "$root/tests/artifacts/proofs/$name" 2>/dev/null | head -1)
    fi

    if [[ $status -eq 0 ]]; then
      printf 'PASS %s in %d s\n' "$name" "$seconds"
      record_pass "$name" passed "$seconds" "pass-$name.log"
    else
      if [[ $status -eq 124 || $status -eq 137 ]]; then
        printf 'TIMEOUT %s after %d s; forcing its own removal\n' "$name" "$seconds" >&2
        failure_class=infrastructure_failure
        # A bound that leaves a perimeter mounted is worse than no bound: the
        # pass owns its cleanup, so it is the pass that must be made to run it.
        set +e
        timeout --signal=TERM --kill-after=60s 900 "$script" remove 2>&1 \
          | tee -a "$workdir/raw-$name.log"
        [[ ${PIPESTATUS[0]} -eq 0 ]] || echo "forced removal of $name did not complete" >&2
        set -e
        redact <"$workdir/raw-$name.log" >"$log"
        record_pass "$name" timed_out "$seconds" "pass-$name.log"
      else
        printf 'RED %s after %d s (status %d)\n' "$name" "$seconds" "$status" >&2
        failure_class=product_or_assertion_failure
        # A multi-hour run can be crossed by a clock step. Several harnesses
        # refuse to issue an approval against a clock that is moving, and that
        # refusal is a fact about this host's timekeeping and not about the
        # product. It is named as such rather than counted as a red of the
        # product, because the cheapest way to invent a defect is to let an
        # environment failure wear a product failure's class.
        if grep -qE "clock is not synchronised|clock moved [0-9-]+s in two seconds" "$log"; then
          printf 'The failure names this host clock, not the product.\n' >&2
          failure_class=clock_step_during_run
        fi
        record_pass "$name" failed "$seconds" "pass-$name.log"
      fi
      first_red=$name
    fi
    current_pass=

    # Both machines, not only the ones this pass declares it touches: a pass
    # that stopped something it never named would otherwise trap the next one.
    assert_vm_back "${vm_names[*]}" || {
      echo "a machine did not come back after $name" >&2
      failure_class=infrastructure_failure
      [[ -n "$first_red" ]] || first_red=$name
      return 1
    }
  done

  announce "windows-helper is not run here"
  printf 'Its evaluation machine lives outside labctl and outside the %s\n' "$topology"
  printf 'topology. It is recorded as not run. A Windows half of this palier\n'
  printf 'remains unproven until that machine plays it.\n'

  # Under `complete` the five below have just run, in the order above. Repeating
  # here that they did not would be the one sentence of this file a reader could
  # catch out, so the paragraphs are printed by the mode that is true of them.
  if [[ $complete_mode -eq 1 ]]; then
    announce "the five palier harnesses ran above, in the order #19 fixes"
    printf 'oci-plan (#14), public-profile (#15), private-passage (#16),\n'
    printf 'private-service (#17) and external-element (#18) each ran through its\n'
    printf 'own entry point, unmodified, doing its own setup, its own reboots and\n'
    printf 'its own teardown. Their verdicts are the verdicts of this run.\n'
    return 0
  fi

  announce "oci-plan is not run here either"
  printf 'It renders the controlled OCI plan palier (#14, proof #86) and not the\n'
  printf 'bootstrap and replacement this sequence proves. It shares lab-machine-1\n'
  printf 'with these passes and therefore never runs beside them, but a verdict of\n'
  printf 'its own belongs to its own palier and is recorded as not run here.\n'

  announce "public-profile is not run here either"
  printf 'It renders the public BentoPDF profile palier (#15, proof #92). Its\n'
  printf 'machine is lab-vps, which this sequence never speaks to, so it could run\n'
  printf 'beside these passes without sharing anything with them — but a verdict of\n'
  printf 'its own belongs to its own palier and is recorded as not run here.\n'

  announce "private-passage is not run here either"
  printf 'It renders the private WireGuard passage palier (#16, proofs #96 and #97,\n'
  printf 'machine proof #98). It needs both lab-machine-1 and lab-vps at once, power\n'
  printf 'cycles both of them, and borrows lab-console as a hostile observer, so it\n'
  printf 'shares machines with these passes and never runs beside them. A verdict of\n'
  printf 'its own belongs to its own palier and is recorded as not run here.\n'

  announce "private-service is not run here either"
  printf 'It renders the private Vaultwarden profile palier (#17, proof #104): the\n'
  printf 'whole reference scenario at once — a data-bearing service on lab-machine-1,\n'
  printf 'an entrypoint serving two declared names on lab-vps, the passage between\n'
  printf 'them, the archives and lab-console as both hostile observer and synthetic\n'
  printf 'neighbour. It needs the three machines of this topology and power cycles two\n'
  printf 'of them, so it never runs beside these passes. A verdict of its own belongs\n'
  printf 'to its own palier and is recorded as not run here.\n'

  announce "external-element is not run here either"
  printf 'It renders the external responsibility palier (#18, proof #109): a service\n'
  printf 'Your Cloud never installed, declared, read, contradicted, aged and\n'
  printf 'withdrawn without ever being adopted. It stands up a whole observation\n'
  printf 'chain — a Daemon and a Relay on lab-machine-1, a Controller on lab-vps and\n'
  printf 'a synthetic Console client on lab-console — so it holds the three machines\n'
  printf 'of this topology and never runs beside these passes. A verdict of its own\n'
  printf 'belongs to its own palier and is recorded as not run here.\n'
}

# ---------------------------------------------------------------------------
# close — destroy what this run owns, then read the verdict honestly
# ---------------------------------------------------------------------------

do_close() {
  announce "Closing the LAB"
  local destroy_status=0 clean_output clean_status=0 line item

  if [[ $topology_owned -eq 1 ]]; then
    timeout --signal=TERM --kill-after=30s 600 "$labctl" topology destroy "$topology" \
      || destroy_status=$?
    if [[ $destroy_status -ne 0 ]]; then
      close_status=failed
      echo "topology destroy failed for $topology" >&2
      return 1
    fi
  else
    announce "No topology was started by this run; nothing of its own to destroy"
  fi

  clean_output=$("$labctl" assert-clean 2>&1) || clean_status=$?
  printf '%s\n' "$clean_output"

  if [[ $clean_status -eq 0 ]]; then
    assert_clean_status=green
    close_status=passed
    return 0
  fi

  assert_clean_status=red
  while IFS= read -r line; do
    case "$line" in
      "VM LAB persistante : "*)
        item=${line#VM LAB persistante : }
        assert_clean_residue+=("vm:${item%% *}")
        ;;
      "Réseau LAB persistant : "*)
        item=${line#Réseau LAB persistant : }
        assert_clean_residue+=("network:${item%% *}")
        ;;
    esac
  done <<<"$clean_output"

  # Whatever remains, this run either created it or it did not. Anything from
  # the topology just destroyed would be a real cleanup failure; anything else
  # is a retention that predates the run, and saying so is not the same as
  # calling the LAB clean.
  for item in "${assert_clean_residue[@]}"; do
    case "${item#*:}" in
      lab-console | lab-machine-1 | lab-vps | "lab-$topology")
        close_status=failed
        echo "the topology this run owns survived its own destruction: $item" >&2
        return 1
        ;;
    esac
  done

  close_status=passed_with_retention
  cat >&2 <<EOF

LIMIT: \`labctl assert-clean\` is red, and this run did not make it red. What
remains is named above and was there before the proof started. The topology
this run owns is gone, so this is a retention to account for, not a cleanup
failure — name it, its reason and the task responsible for it in the report.
EOF
  return 0
}

# ---------------------------------------------------------------------------
# artifacts — `complete` only: the four deterministic files of the closed list
# ---------------------------------------------------------------------------
#
# The four are produced by `tools/release-artifacts`, which reads the repository
# and its locks and executes neither the product nor a test. Two of the six
# things `#19` says the proof must constate are about these files rather than
# about a machine, and neither is asserted here — each is a command whose
# failure stops this stage:
#
#   two runs on one revision render the same bytes   `check-determinism`
#   every digest recomputes from the repository      `sha256sum -c`
#
# The stage runs only when every harness passed. Release artifacts produced
# beside a red would read as a candidate that no run supports.

do_artifacts() {
  local status=0 line digest name

  if [[ -n "$first_red" ]]; then
    artifacts_status=not_run
    artifacts_reason="the sequence stopped at the first red ($first_red); release artifacts are not cut from a run that failed"
    announce "Not producing the release artifacts: $artifacts_reason"
    return 0
  fi

  announce "Producing the four deterministic artifacts of the closed list"
  mkdir -m 0755 -p "$artifact_dir" || {
    artifacts_status=failed
    artifacts_reason="the artifact directory could not be created"
    return 1
  }

  timeout --signal=TERM --kill-after=30s 600 \
    "$root/tools/release-artifacts" produce "$artifact_dir" || status=$?
  if [[ $status -ne 0 ]]; then
    artifacts_status=failed
    artifacts_reason="tools/release-artifacts produce ended with status $status"
    failure_class=product_or_assertion_failure
    first_red=artifacts
    echo "FAILED: $artifacts_reason" >&2
    return 1
  fi

  announce "Determinism is a command here, not a promise"
  status=0
  timeout --signal=TERM --kill-after=30s 600 \
    "$root/tools/release-artifacts" check-determinism || status=$?
  if [[ $status -ne 0 ]]; then
    determinism_status=failed
    artifacts_status=failed
    artifacts_reason="tools/release-artifacts check-determinism ended with status $status"
    failure_class=product_or_assertion_failure
    first_red=artifacts
    echo "FAILED: $artifacts_reason" >&2
    return 1
  fi
  determinism_status=identical

  announce "Verifying the artifacts the way a third party would"
  status=0
  (cd "$artifact_dir" && sha256sum -c checksums.txt) || status=$?
  if [[ $status -ne 0 ]]; then
    third_party_status=failed
    artifacts_status=failed
    artifacts_reason="sha256sum -c checksums.txt failed inside the artifact directory"
    failure_class=product_or_assertion_failure
    first_red=artifacts
    echo "FAILED: $artifacts_reason" >&2
    return 1
  fi
  third_party_status=passed

  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    digest=${line%% *}
    name=${line##* }
    artifact_digests+=("$name $digest")
  done <"$artifact_dir/checksums.txt"

  artifacts_status=passed
  return 0
}

# ---------------------------------------------------------------------------
# report — `complete` only: the fifth artifact, and the only sealed one
# ---------------------------------------------------------------------------
#
# It is written last, after the closure, because `labctl assert-clean` is this
# run's final constat on machines and a report that omitted its own closure
# would be a report with a hole. Its seal is taken once, over a whole document.
#
# `proof-checksum.txt` is the #111 decision, implemented exactly: the format of
# `sha256sum`, no header and no comment, covering the report alone. Two scopes,
# two files, neither claiming the other — `sha256sum -c checksums.txt` says the
# four files are this revision's, `sha256sum -c proof-checksum.txt` says the
# report is this run's.

hms() {
  local total=$1
  printf '%dh%02dm%02ds' $((total / 3600)) $(((total % 3600) / 60)) $((total % 60))
}

do_report() {
  local status=0 entry name pass_status seconds bound issues step

  if [[ $artifacts_status != passed ]]; then
    report_status=not_run
    announce "Not writing the report: the artifacts stage is '$artifacts_status'"
    return 0
  fi

  announce "Writing the single report of this run, and sealing it"
  {
    cat <<EOF
