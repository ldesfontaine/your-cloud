#!/usr/bin/env bash
# Leave the machine honest about what the harness did.
#
# The installed candidate is uninstalled and every process the run started is
# stopped. One thing is deliberately kept and named rather than silently left:
# the build tree under /root/your-cloud-app-build, whose warm caches turn
# an hour-long cold build into minutes. The sync phase re-stamps the sources
# on every run, so the kept tree can never resurrect a stale candidate.
set -euo pipefail
export LC_ALL=C.UTF-8

here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

pkill -f 'WebKitWebDriver' 2>/dev/null || true
pkill -f 'tauri-driver' 2>/dev/null || true
pkill -x your-cloud-app 2>/dev/null || true
pkill -f 'http.server 8710' 2>/dev/null || true
pkill -f 'Xvfb' 2>/dev/null || true

if dpkg-query -W -f '${Status}' your-cloud 2>/dev/null | grep -q 'install ok installed'; then
  dpkg --purge your-cloud >/dev/null 2>&1 || dpkg --remove your-cloud >/dev/null
  echo "  candidate uninstalled"
fi
for binary in /usr/bin/your-cloud-app /usr/bin/your-cloud-native-bootstrap-assistant; do
  [[ ! -e "$binary" ]] || { echo "FAILED: $binary survived the uninstall" >&2; exit 1; }
done

rm -rf /tmp/your-cloud-reflow-state-* 2>/dev/null || true

cd /
rm -rf "$here"
echo "  harness removed; the build tree /root/your-cloud-app-build is kept for the next run"
