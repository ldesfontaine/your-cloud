# Shared observations of the public profile perimeter, sourced by the scripts
# that run on the published machine. It asserts nothing by itself: it is the
# vocabulary every judging script speaks, so that a fact read before a refusal
# and the same fact read after it are read by the same lines.
#
# Everything here is read-only. The two scripts allowed to change the machine
# outside an approved plan are `certify`, which places the certificate no plan
# describes, and `remove`, which takes the perimeter away — and both say so.

export LC_ALL=C.UTF-8

state=/root/lab-public-profile
authority="$state/authority"

# The two accounts of the profile. They are separate identities on one machine,
# which is the arrangement `#90` named and never exercised: two accounts each
# allocating their own subordinate ranges on the same host.
service_account=your-cloud-svc-bentopdf
service_home="/var/lib/$service_account"
service_unit="$service_home/.config/containers/systemd/$service_account.container"
service_service="$service_account.service"
service_container="$service_account"

entry_account=your-cloud-entrypoint
entry_home="/var/lib/$entry_account"
entry_unit="$entry_home/.config/containers/systemd/$entry_account.container"
entry_service="$entry_account.service"
entry_container="$entry_account"

# The root-owned tree the entry reads and never writes, and the one host file
# the entrypoint plan declares as its own effect.
entry_root=/etc/your-cloud/entrypoint
entry_configuration="$entry_root/traefik.yaml"
entry_fragments="$entry_root/dynamic"
entry_certificates="$entry_root/certificates"
host_ports_policy=/etc/sysctl.d/your-cloud-entrypoint.conf
host_ports_setting=net.ipv4.ip_unprivileged_port_start

anchor=/etc/your-cloud/approval-anchor.json
replay=/var/lib/your-cloud-auxiliary/approval-state.json

# The one loopback port a plan of this run chooses, and a second one inside the
# approvable range that no managed service of this machine ever publishes: it is
# what the hostile route names, so that the refusal is about the machine's own
# state and not about a bound the plan validation already holds.
service_port=18800
unmanaged_port=18801

# The declared names. The first is the one the palier publishes and the proof
# reads from outside; the second is published only to be rolled back by a
# controlled failure; the third is declared by nobody and must never obtain an
# application route.
declared_host=bentopdf.lab.your-cloud.test
second_host=atelier.lab.your-cloud.test
unknown_host=inconnu.lab.your-cloud.test

# The pinned images of the contract, repeated here so that what the machine runs
# is compared against a constant this harness wrote and not against whatever the
# machine happens to answer.
pinned_service="ghcr.io/alam00000/bentopdf@sha256:a4ed090f29823da5e296e2c2f8603664da71676156ea47c3f186cc73eec38db0"
pinned_entry="docker.io/library/traefik@sha256:9c3b91d5fb7770853ca5c1124a23c34bf2d9b47ffaebeab2614cbaf410dcb2ac"

failures=0

report() { printf '%-64s %s\n' "$1" "$2"; }
red() {
  report "$1" "FAILED: $2"
  failures=$((failures + 1))
}
step() { printf '\n== %s ==\n' "$*"; }

verdict() {
  [[ $failures -eq 0 ]] || {
    echo "FAILED: $failures assertions" >&2
    exit 1
  }
  echo "PASS: $1"
}

# as_account runs one read-only command under a service account, with exactly
# the environment the Auxiliary builds for its own calls. The working directory
# is `/` because a rootless Podman re-executes itself into a user namespace and
# chdir()s to the directory it inherited: a directory this account cannot enter
# makes every engine call fail for a reason that has nothing to do with the
# engine.
as_account() {
  local account=$1 uid
  shift
  uid=$(id -u "$account" 2>/dev/null) || return 1
  cd / && runuser -u "$account" -- env \
    PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    HOME="/var/lib/$account" \
    USER="$account" \
    XDG_RUNTIME_DIR="/run/user/$uid" \
    DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
    "$@"
}

account_state() { id -u "$1" >/dev/null 2>&1 && echo present || echo absent; }

subordinate_range() { grep "^$1:" /etc/subuid 2>/dev/null || echo none; }

file_digest() {
  [[ -f "$1" ]] || {
    echo absent
    return
  }
  sha256sum "$1" | cut -d' ' -f1
}

file_mtime() { stat -c %Y "$1" 2>/dev/null || echo absent; }

file_owner() { stat -c '%U:%G %a' "$1" 2>/dev/null || echo absent; }

service_state() {
  local account=$1 service=$2
  id -u "$account" >/dev/null 2>&1 || {
    echo no-account
    return
  }
  as_account "$account" systemctl --user is-active "$service" 2>/dev/null || true
}

# service_property reads one property of a running service. The one that matters
# most here is the one a restart cannot leave untouched: systemd mints a new
# InvocationID for every start.
service_property() {
  local account=$1 service=$2 property=$3
  id -u "$account" >/dev/null 2>&1 || {
    echo no-account
    return
  }
  as_account "$account" systemctl --user show "$service" --property="$property" --value 2>/dev/null \
    || echo unreadable
}

container_image() {
  local account=$1 container=$2
  id -u "$account" >/dev/null 2>&1 || {
    echo no-account
    return
  }
  as_account "$account" podman container inspect --format '{{.ImageName}}' "$container" 2>/dev/null \
    || echo none
}

stored_images() {
  local account=$1
  id -u "$account" >/dev/null 2>&1 || {
    echo no-account
    return
  }
  as_account "$account" podman images --quiet 2>/dev/null | wc -l
}

published_fragments() {
  [[ -d "$entry_fragments" ]] || {
    echo none
    return
  }
  local names
  names=$(cd "$entry_fragments" && ls -1 2>/dev/null | paste -sd, -)
  echo "${names:-none}"
}

# host_ports_value is what the running kernel holds right now, which is not the
# same claim as the file on disk: the contract requires both, and this proof
# reads them apart so that a file without an application, or an application
# without a file, is visible rather than averaged.
host_ports_value() { sysctl -n "$host_ports_setting" 2>/dev/null || echo unreadable; }

loopback_answers() {
  curl --silent --show-error --max-time 5 --output /dev/null \
    --write-out '%{http_code} %{content_type}' "http://127.0.0.1:$1/" 2>&1 || true
}

port_listening() {
  ss -Hltn "sport = :$1" 2>/dev/null | grep -q . && echo open || echo closed
}

# fingerprint is everything an operation of this palier could have changed, read
# in one place so that "zero effect" is a comparison and never a claim. It spans
# both accounts, both sheets, the entry's own files, the fragments and the host
# policy, because a route operation and an entrypoint operation touch different
# halves of the same machine.
fingerprint() {
  printf 'svc-account=%s svc-unit=%s svc-service=%s svc-invocation=%s svc-image=%s ' \
    "$(account_state "$service_account")" "$(file_digest "$service_unit")" \
    "$(service_state "$service_account" "$service_service")" \
    "$(service_property "$service_account" "$service_service" InvocationID)" \
    "$(container_image "$service_account" "$service_container")"
  printf 'entry-account=%s entry-unit=%s entry-config=%s entry-service=%s entry-invocation=%s ' \
    "$(account_state "$entry_account")" "$(file_digest "$entry_unit")" \
    "$(file_digest "$entry_configuration")" \
    "$(service_state "$entry_account" "$entry_service")" \
    "$(service_property "$entry_account" "$entry_service" InvocationID)"
  printf 'fragments=%s policy=%s sysctl=%s ports=%s/%s/%s\n' \
    "$(published_fragments)" "$(file_digest "$host_ports_policy")" \
    "$(host_ports_value)" "$(port_listening 443)" "$(port_listening 80)" \
    "$(port_listening "$service_port")"
}

consumed_sequence() {
  [[ -f "$replay" ]] || {
    echo 0
    return
  }
  sed -n 's/.*"consumed_sequence":\([0-9]*\).*/\1/p' "$replay"
}

# next_sequence is read from the machine rather than counted by the harness. A
# document refused before the sequence is consumed leaves the position where it
# was, and one refused after it has spent it: only the machine knows which.
next_sequence() { echo $(($(consumed_sequence) + 1)); }

# unchanged compares a fingerprint taken before an operation with the one taken
# after it, and names the difference rather than the fact that there is one.
unchanged() {
  local label=$1 before=$2 after
  after=$(fingerprint)
  if [[ "$before" == "$after" ]]; then
    report "$label" "zero effect"
  else
    red "$label" "the machine changed: before [$before] after [$after]"
  fi
}

# apply <label> <expectation> <fixture arguments...>
#
# It prints what the machine concluded, and holds it against exactly one
# expected fragment of the JSON report. A run that fails is still printed whole,
# because the conclusion of a controlled failure is part of the contract.
apply() {
  local label=$1 expected=$2 output status=0
  shift 2
  output=$(lab-public-profile-fixture "$@" | your-cloud auxiliary approve --format=json 2>&1) || status=$?
  case "$output" in
    *"$expected"*) report "$label" "$expected (status $status)" ;;
    *) red "$label" "expected $expected, got: $(echo "$output" | tr '\n' ' ')" ;;
  esac
  printf '%s\n' "$output" >"$state/last-report.json"
}

# refuses <label> <expected reason> <fixture arguments...>
#
# The reason is asserted, not merely the non-zero status: a refusal that fired
# for another cause has not proven the rule it is named after. The machine is
# compared with itself before and after, so a refusal that changed something
# would be a red even while its reason was right.
refuses() {
  local label=$1 expected=$2 output before
  shift 2
  before=$(fingerprint)
  if output=$(lab-public-profile-fixture "$@" | your-cloud auxiliary approve 2>&1); then
    red "$label" "accepted: $(echo "$output" | tr '\n' ' ')"
    return
  fi
  case "$output" in
    *"$expected"*) report "$label" "refused: $expected" ;;
    *) red "$label" "refused for another reason: $(echo "$output" | tr '\n' ' ')" ;;
  esac
  unchanged "$label, zero effect" "$before"
}
