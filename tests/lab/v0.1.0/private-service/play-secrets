#!/usr/bin/env bash
# The synthetic secrets this proof carries through every later step, planted as a
# NAMED HARNESS ACT rather than written by the service's own API.
#
# The reason is the profile's own contract and it is worth stating rather than
# working around: `SIGNUPS_ALLOWED=false` and `INVITATIONS_ALLOWED=false` are
# constants of the sheet, so a fresh instance of this profile has no account
# anybody can create and no API path this harness may travel. The palier's
# criterion — "sauvegarde et restauration réussissent avec des données et secrets
# synthétiques" — is about the bytes surviving, and Your Cloud archives bytes: it
# has no idea what a vault row is, which is precisely why the archive is a tar of
# a directory and the report carries a digest and nothing else.
#
# So the limit is named where it applies: **what is proven below is that the exact
# bytes a service holds in its durable directory survive a reboot, a controlled
# recreation, an archive and a return. What is not proven is that a vault row
# written through the API survives, because no plan of this palier opens a path to
# write one.** The state the service itself created — its own database file — is
# read beside the planted marker and carried through every constat with it, so the
# claim is not only about a file the harness invented.
#
# This is one of the four scripts allowed to change the machine outside an
# approved plan. It stops the service with `systemctl --user`, writes into the
# durable directory as the account that owns it, and starts the service again.
set -euo pipefail
here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=common
. "$here/common"

cd /root

step "12. HARNESS ACT: synthetic data planted in the durable directory"

report "why it is planted and not written" \
  "the profile's sheet closes signups and invitations, so this palier has no API path to a vault row"

before_invocation=$(service_property "$vault_account" "$vault_service" InvocationID)
report "the service's invocation before this act" "$before_invocation"

# What the service itself created, read before anything of the harness is added.
report "what the service put in its own directory" \
  "$(cd "$vault_data" && ls -1A 2>/dev/null | paste -sd, - || echo nothing)"
if [[ -f "$vault_data/db.sqlite3" ]]; then
  report "the database the service created" \
    "db.sqlite3, $(stat -c %s "$vault_data/db.sqlite3") bytes, digest $(file_digest "$vault_data/db.sqlite3")"
else
  report "the database the service created" "absent — the marker below is then the whole of the data"
fi

# The act itself: stop, write, start. Stopping is what makes the write honest —
# a file appearing under a running service would be a race rather than a state.
as_account "$vault_account" systemctl --user stop "$vault_service" >/dev/null 2>&1 || true
case "$(service_state "$vault_account" "$vault_service")" in
  active) red "the service, for the duration of the act" "still running; the write would be a race" ;;
  *) report "the service, for the duration of the act" "stopped by the harness, and named as such" ;;
esac

printf '%s\n' "$secret_plain" >"$vault_data/lab-synthetic-secret.txt"
chown "$vault_account:$vault_account" "$secret_file"
chmod 0600 "$secret_file"
expect "the planted secret's owner and mode" "$(file_owner "$secret_file")" "$vault_account:$vault_account 600"
secret_digest=$(file_digest "$secret_file")
printf '%s\n' "$secret_digest" >"$state/secret-digest.txt"
report "the digest of the planted secret" "$secret_digest"

as_account "$vault_account" systemctl --user start "$vault_service" >/dev/null 2>&1 || true
for _ in $(seq 1 30); do
  [[ "$(service_state "$vault_account" "$vault_service")" == active ]] && break
  sleep 2
done
expect "the service, after the act" "$(service_state "$vault_account" "$vault_service")" active
expect "its loopback port" "$(loopback_status_within "$vault_port" 90)" 200
if [[ "$(service_property "$vault_account" "$vault_service" InvocationID)" != "$before_invocation" ]]; then
  report "the service's invocation across the act" "new, as a stop and a start require"
else
  red "the service's invocation across the act" "unchanged; the service was never stopped"
fi

# The whole durable state, in one line, so that every later constat is a
# comparison against something recorded here rather than a fresh judgement.
data_state() {
  { cd "$vault_data" && find . -type f -printf '%P\n' | sort | while read -r file; do
      printf '%s:%s ' "$file" "$(sha256sum "$file" | cut -d' ' -f1)"
    done; } 2>/dev/null
  printf '\n'
}
data_state >"$state/data-state.txt"
report "the durable state this proof now carries" "$(cut -c1-140 <"$state/data-state.txt")"

limit "no vault row was written through the API" \
  "signups and invitations are closed by the profile's own sheet, so this proof plants bytes in the durable directory and follows those bytes. Your Cloud archives bytes and reports a digest; it never reads what is inside an archive. A proof that a row written through the API survives belongs to a palier that opens such a path."

verdict "the durable directory holds the service's own state and one synthetic secret of a known digest, the service was stopped and started by the harness to put it there, and it answers again"
