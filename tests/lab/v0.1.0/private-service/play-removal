#!/usr/bin/env bash
# The dismantling, played in the one order the contracts fix: the name the
# passage carries, then the passage, then the service whose data it published,
# then the public half that was standing before any of it.
#
# It takes the stage as an argument because the claim is about the order, and
# each stage has to be readable from outside the machines before the next one
# runs — the vault's name stops being served while the service still answers,
# then the tunnel goes, then the service goes and its data does not, and only
# then do the public ports close.
set -euo pipefail
here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=common
. "$here/common"

stage=${1:?usage: play-removal <retire-link|depart|remove-service|remove-public> [peer-key] [endpoint]}
peer_key=${2:-}
endpoint=${3:-}

cd /root

case "$stage" in
  retire-link)
    step "34. the name the passage carried is retired, and only the name"

    entry_invocation=$(service_property "$entry_account" "$entry_service" InvocationID)
    pdf_digest=$(file_digest "$entry_fragments/$pdf_host.yaml")

    apply "retire_link_route of $vault_host" '"changed":true' \
      -operation retire_link_route -route-host "$vault_host" -backend-port "$vault_port"
    expect "the passage state the report names" "$(json_field passage_state)" active
    expect "the fragment" "$(present "$entry_fragments/$vault_host.yaml")" absent
    expect "the fragments this machine still holds" "$(published_fragments)" "$pdf_host.yaml"
    expect "the public fragment, untouched" "$(file_digest "$entry_fragments/$pdf_host.yaml")" "$pdf_digest"
    expect "the entry was not restarted" \
      "$(service_property "$entry_account" "$entry_service" InvocationID)" "$entry_invocation"
    expect "the peer this machine still holds" "$(wg_peers)" "$peer_key"
    expect "the bounding table, untouched by a route retirement" "$(link_table_loaded)" loaded
    expect "the certificates, which no plan writes and no plan removes" \
      "$(ls -1 "$entry_certificates" | paste -sd, -)" \
      "$pdf_host.crt,$pdf_host.key,$vault_host.crt,$vault_host.key"

    apply "retiring it again" '"changed":false' \
      -operation retire_link_route -route-host "$vault_host" -backend-port "$vault_port"

    verdict "the name is silent, the tunnel and the service it named are exactly where they were, and the certificate of that name is still on this machine"
    ;;

  depart)
    step "35. the passage is undone on this machine, in the contract's order — role $link_role"

    operation=detach_link_peer
    [[ "$link_role" == initiator ]] && operation=leave_link_peer

    apply "$operation" '"changed":true' \
      -operation "$operation" -link-role "$link_role" \
      -peer-public-key "$peer_key" -peer-endpoint-host "$endpoint" -service-port "$vault_port"
    expect "the peer, in the kernel" "$(wg_peers)" none
    expect "the bounding table in the kernel" "$(link_table_loaded)" absent
    expect "the bounding rules on disk" "$(present "$link_rules")" absent
    expect "the unit that put the bounds back" "$(present "$link_unit")" absent
    expect "the host relaxation" "$(present "$link_policy")" absent
    expect "the interface, which a departure leaves standing" "$(interface_state)" up

    if [[ "$role" == vps ]]; then
      # The one reading the failure of the passage left owing: a retirement on a
      # machine whose junction is gone says so in its own report. It is asked of
      # a name that is already retired, so the reading costs nothing.
      apply "retiring the vault's name again, now that the junction is gone" '"changed":false' \
        -operation retire_link_route -route-host "$vault_host" -backend-port "$vault_port"
      expect "the passage state the report names" "$(json_field passage_state)" absent
    fi

    apply "withdraw_link" '"changed":true' -operation withdraw_link -link-role "$link_role"
    expect "the interface" "$(interface_state)" absent
    expect "this machine's own passage key" "$(present "$link_key")" absent
    expect "the description of $link_interface" "$(present "$link_netdev")" absent
    expect "the addressing of $link_interface" "$(present "$link_network")" absent
    expect "the tunnel's UDP port" "$(udp_port_bound "$link_listen_port")" unbound
    report "systemd-networkd, which a withdrawal deliberately does not disable" \
      "$(systemctl is-enabled systemd-networkd)/$(systemctl is-active systemd-networkd)"
    report "the real interfaces" "$(ip -4 -brief address show scope global | paste -sd' ' -)"

    apply "withdraw_link, asked for again" '"changed":false' \
      -operation withdraw_link -link-role "$link_role"

    verdict "the peer, the bounds, the unit, the relaxation, the interface and the key are gone from this machine, and its own networking is untouched"
    ;;

  remove-service)
    step "36. the private service is removed, and its data deliberately is not"

    secret_digest=$(cat "$state/secret-digest.txt")
    nightly_digest=$(cat "$state/nightly-digest.txt")

    apply "remove_private_service" '"changed":true' \
      -operation remove_private_service -profile vaultwarden \
      -port "$vault_port" -origin-host "$vault_host"
    report "the durable directory the report names as kept" "$(json_field data_path)"
    report "the archives the report names as surviving" \
      "$(grep -o '"snapshot_slots":\[[^]]*\]' "$state/last-report.json" || echo none)"

    expect "the sheet" "$(present "$vault_unit")" absent
    expect "the service" "$(service_state "$vault_account" "$vault_service")" inactive
    expect "the container" "$(container_image "$vault_account" "$vault_container")" none
    expect "the images the account's storage holds" "$(stored_images "$vault_account")" 0
    expect "the loopback port" "$(port_listening "$vault_port")" closed
    expect "the confinement rules on disk" "$(present "$egress_rules")" absent
    expect "the unit that posed it at boot" "$(present "$egress_unit")" absent
    expect "that unit's enablement, in systemd's own word" "$(unit_enabled "$egress_unit_name")" not-found
    expect "the confinement table in the kernel" "$(egress_table_loaded)" absent

    # What a removal keeps, read by name rather than assumed: this is the whole
    # of "retrait propre sans suppression implicite des données".
    expect "the account, which no plan of this product describes" "$(account_state "$vault_account")" present
    expect "the durable data directory" "$(file_owner "$vault_data")" "$vault_account:$vault_account 700"
    expect "the synthetic secret" "$(file_digest "$secret_file")" "$secret_digest"
    expect "the named archive" "$(archive_digest "$nightly_slot")" "$nightly_digest"
    expect "the archives on disk" "$(archive_slots)" "$nightly_slot,$reserved_slot"
    report "who removes the data, then" \
      "a human with their own tools, or — here — the harness's own removal step, which says so"

    apply "removing it again" '"changed":false' \
      -operation remove_private_service -profile vaultwarden \
      -port "$vault_port" -origin-host "$vault_host"

    verdict "everything that ran is gone and everything that was written is still there, named in the report rather than left for a reader to assume"
    ;;

  remove-public)
    step "37. the public half is dismantled, in the order the entry's contract fixes"

    apply "retire_route of $pdf_host" '"changed":true' \
      -operation retire_route -route-host "$pdf_host" -backend-port "$pdf_port"
    expect "the fragments this machine holds" "$(published_fragments)" none
    expect "the public profile's service, untouched" "$(service_state "$pdf_account" "$pdf_service")" active

    apply "remove_entrypoint" '"changed":true' -operation remove_entrypoint
    expect "the entry sheet" "$(present "$entry_unit")" absent
    expect "the static configuration" "$(present "$entry_configuration")" absent
    expect "the host ports policy file" "$(present "$host_ports_policy")" absent
    expect "the running kernel setting" "$(host_ports_value)" 1024
    expect "the secure public port" "$(port_listening 443)" closed
    expect "the clear public port" "$(port_listening 80)" closed
    expect "the certificate directory, which the entry read and never wrote" \
      "$(present "$entry_certificates")" present
    report "what it still holds" "$(ls -1 "$entry_certificates" | paste -sd, -)"

    apply "remove_web_service" '"changed":true' \
      -operation remove_web_service -profile bentopdf -port "$pdf_port"
    expect "the service sheet" "$(present "$pdf_unit")" absent
    expect "the loopback port" "$(port_listening "$pdf_port")" closed
    for account in "$pdf_account" "$entry_account"; do
      expect "the account $account, which no plan describes" "$(account_state "$account")" present
    done

    report "the machine, as it now stands" "$(fingerprint)"
    report "the final consumed position" "$(consumed_sequence)"

    verdict "the route, the entry and the service are gone in the contract's order, the public ports closed last, and what remains is exactly what no plan describes"
    ;;

  *)
    echo "usage: play-removal <retire-link|depart|remove-service|remove-public>" >&2
    exit 2
    ;;
esac
