#!/usr/bin/env bash
# Remove the private service perimeter from one machine and prove its absence.
#
# This is the one script of the harness allowed to do what no plan may, and each
# kind of residue it takes away is the harness's own act rather than a conclusion
# of the product:
#
#   - the service accounts, their homes and their subordinate ranges. No plan of
#     any palier describes an account, so no approved document can take one away
#     and the product deliberately leaves them;
#   - **the durable data of the vault and every archive beside it.** The product
#     kept them on purpose — a removal of this product destroys no data — so it is
#     the harness that destroys the synthetic data it planted, and it says so
#     here rather than letting a reader think a plan did it;
#   - the entrypoint's root-owned tree, including the certificates this harness
#     placed there. The Auxiliary removes what it wrote and nothing else, and it
#     never wrote a certificate;
#   - the observer table this harness posed beside the product's own, which the
#     product was required never to name;
#   - the anchor, the anti-replay position, the synthetic authority and the two
#     binaries this run compiled.
#
# It runs even when a step of the proof failed: a machine left holding an anchor,
# a spent position, lingering accounts, a container, a tunnel interface and two
# loaded tables is not a clean LAB, whatever failed above. Everything is removed
# by name — never by a sweep — so that a residue this script did not anticipate is
# still visible in what it prints.
set -euo pipefail
here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=common
. "$here/common"

cd /
remaining=0

step "38. the perimeter is removed by the harness, not by a plan"

retire() {
  local account=$1
  id -u "$account" >/dev/null 2>&1 || return 0
  as_account "$account" systemctl --user stop "$account.service" >/dev/null 2>&1 || true
  as_account "$account" podman rm --force --ignore "$account" >/dev/null 2>&1 || true
  as_account "$account" podman rmi --all --force >/dev/null 2>&1 || true
  loginctl disable-linger "$account" >/dev/null 2>&1 || true
  as_account "$account" systemctl --user exit >/dev/null 2>&1 || true
  sleep 1
  pkill -9 -u "$account" >/dev/null 2>&1 || true
  sleep 1
  userdel --remove "$account" >/dev/null 2>&1 || userdel "$account" >/dev/null 2>&1 || true
  rm -rf "/var/lib/$account"
  sed -i "/^$account:/d" /etc/subuid /etc/subgid
}

# The passage first, in the order the product's own operations would have taken
# it. A proof that failed halfway can leave any subset of these, so each is
# removed unconditionally and none objects to being already gone.
/usr/sbin/nft add table "$link_table_family" "$link_table_name" 2>/dev/null || true
/usr/sbin/nft delete table "$link_table_family" "$link_table_name" 2>/dev/null || true
systemctl disable "$link_unit_name" >/dev/null 2>&1 || true
rm -f "$link_unit" "$link_rules" "$link_policy"
sysctl --ignore --write "$route_localnet_key=0" >/dev/null 2>&1 || true
rm -f "$link_netdev" "$link_network"
networkctl reload >/dev/null 2>&1 || true
ip link delete "$link_interface" 2>/dev/null || true
rm -rf "$link_root"

# The confinement of the private service, and the observer this harness posed
# beside it.
/usr/sbin/nft add table "$egress_table_family" "$egress_table_name" 2>/dev/null || true
/usr/sbin/nft delete table "$egress_table_family" "$egress_table_name" 2>/dev/null || true
/usr/sbin/nft add table inet lab-egress-observer 2>/dev/null || true
/usr/sbin/nft delete table inet lab-egress-observer 2>/dev/null || true
# The table a rootful engine poses when the diagnostic pre-flight of this harness
# publishes a port. Its own step deletes it; it is named again here for a run that
# failed before reaching that line.
/usr/sbin/nft delete table inet netavark 2>/dev/null || true
systemctl disable "$egress_unit_name" >/dev/null 2>&1 || true
rm -f "$egress_unit" "$egress_rules"
rm -rf "$egress_root"
systemctl daemon-reload >/dev/null 2>&1 || true

case "$role" in
  lan)
    # The data and the archives the product kept. Removing them is this
    # harness's own act and the only reason it is licit is that every byte of
    # them is synthetic and was planted by this same harness.
    if [[ -d "$vault_data" || -d "$vault_snapshots" ]]; then
      report "the synthetic data and archives the product kept" \
        "removed here by the harness, which planted them; no plan of this product describes their destruction"
    fi
    retire "$vault_account"
    ;;
  vps)
    retire "$entry_account"
    retire "$pdf_account"
    if [[ -e "$host_ports_policy" ]]; then
      rm -f "$host_ports_policy"
      sysctl --write "$host_ports_setting=1024" >/dev/null 2>&1 || true
      sysctl --system >/dev/null 2>&1 || true
    fi
    rm -rf "$entry_root"
    ;;
esac

rm -f "$anchor" "$replay" "${replay%.json}.lock"
rmdir /etc/your-cloud 2>/dev/null || true
rm -rf "$state" /usr/local/bin/lab-private-service-fixture /usr/local/bin/your-cloud
rm -rf /root/lab-private-service-sources

step "39. what the machine holds afterwards"

check() {
  local label=$1 observed=$2 expected=$3
  if [[ "$observed" == "$expected" ]]; then
    report "$label" "$expected"
  else
    report "$label" "FAILED: $observed"
    remaining=$((remaining + 1))
  fi
}

for account in your-cloud-svc-vaultwarden your-cloud-svc-bentopdf your-cloud-entrypoint; do
  check "the account $account" "$(account_state "$account")" absent
  check "the home of $account" "$(present "/var/lib/$account")" absent
  check "the subordinate ranges of $account" \
    "$({ grep -h "^$account:" /etc/subuid /etc/subgid || true; } | wc -l)" 0
done
check "the durable data of the private service" "$(present "$vault_data")" absent
check "its archives" "$(present "$vault_snapshots")" absent
check "the confinement tree" "$(present "$egress_root")" absent
check "the unit that posed the confinement" "$(present "$egress_unit")" absent
check "the confinement table" "$(egress_table_loaded)" absent
check "the observer table this harness posed" "$(table_loaded inet lab-egress-observer)" absent
check "the entrypoint tree" "$(present "$entry_root")" absent
check "the host ports policy" "$(present "$host_ports_policy")" absent
check "the running host ports floor" "$(host_ports_value)" 1024
check "the passage tree" "$(present "$link_root")" absent
check "the description of $link_interface" "$(present "$link_netdev")" absent
check "the addressing of $link_interface" "$(present "$link_network")" absent
check "the interface" "$(interface_state)" absent
check "the unit that puts the bounds back" "$(present "$link_unit")" absent
check "the host relaxation" "$(present "$link_policy")" absent
check "the bounding table" "$(link_table_loaded)" absent
check "the tables this machine holds" "$(nft_tables)" ""
check "route_localnet on every interface at once" "$(sysctl_value net.ipv4.conf.all.route_localnet)" 0
check "the approval anchor" "$(present "$anchor")" absent
check "the anti-replay position" "$(present "$replay")" absent
check "the run's state directory" "$(present "$state")" absent
check "the product binary" "$(present /usr/local/bin/your-cloud)" absent
check "the fixture" "$(present /usr/local/bin/lab-private-service-fixture)" absent
check "the secure public port" "$(port_listening 443)" closed
check "the clear public port" "$(port_listening 80)" closed
check "the private profile's loopback port" "$(port_listening "$vault_port")" closed
check "the public profile's loopback port" "$(port_listening "$pdf_port")" closed
check "the tunnel's UDP port" "$(udp_port_bound "$link_listen_port")" unbound

# What this harness never had the right to change, read one last time.
report "systemd-networkd" \
  "$(systemctl is-enabled systemd-networkd)/$(systemctl is-active systemd-networkd)"
report "the real interfaces" "$(ip -4 -brief address show scope global | paste -sd' ' -)"

[[ $remaining -eq 0 ]] || {
  echo "FAILED: $remaining things this harness mounted are still there" >&2
  exit 1
}
echo "PASS: the machine holds nothing this harness mounted"
