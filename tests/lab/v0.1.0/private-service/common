# expected_netdev / expected_network are the two files of the passage, exactly
# as the proof of `#16` spells them. With no argument they are the head a
# preparation owns; with a key they carry the tail exactly one junction owns.
expected_netdev() {
  local peer_key=${1:-} endpoint=${2:-}
  product_header
  printf '[NetDev]\nName=%s\nKind=wireguard\nDescription=Your Cloud private passage (%s)\n\n' \
    "$link_interface" "$link_role"
  printf '[WireGuard]\nPrivateKeyFile=%s\n' "$link_key"
  [[ "$link_role" == listener ]] && printf 'ListenPort=%d\n' "$link_listen_port"
  [[ -n "$peer_key" ]] || return 0
