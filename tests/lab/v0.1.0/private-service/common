# Shared observations of the private service perimeter, sourced by every script
# that runs on either machine of the reference scenario. It asserts nothing by
# itself: it is the vocabulary the judging scripts speak, so that a fact read
# before a refusal and the same fact read after it are read by the same lines.
#
# Everything here is read-only except where a function says otherwise. The
# scripts allowed to change a machine outside an approved plan say so at the
# place they do it, and there are exactly four of them: `certify`, which places
# the certificates no plan describes; `play-secrets`, which plants the synthetic
# data no API of this palier can write; `play-panne`, which produces two real
# host conditions and puts both back; and `remove`, which takes the perimeter
# away.
#
# The two machines source the same file. What differs between them is written
# once, at the bottom, and read from the role this machine's perimeter was
# mounted with.

export LC_ALL=C.UTF-8

state=/root/lab-private-service
authority="$state/authority"
anchor=/etc/your-cloud/approval-anchor.json
replay=/var/lib/your-cloud-auxiliary/approval-state.json

