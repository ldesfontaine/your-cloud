  printf '[Match]\nName=%s\n\n[Network]\nAddress=%s/32\n' "$link_interface" "$link_own_address"
  [[ -n "${1:-}" ]] || return 0
  printf '\n[Route]\nDestination=%s/32\nScope=link\n' "$link_peer_address"
  return 0
}

# matches_bytes compares a file on the machine with the bytes the contract says
# it must carry, and names the difference rather than the fact that there is one.
matches_bytes() {
  local label=$1 path=$2 expected=$3 observed
  if [[ ! -f "$path" ]]; then
    red "$label" "$path is absent"
    return
  fi
  observed=$(cat "$path")
  if [[ "$observed" == "$expected" ]]; then
    report "$label" "$(wc -c <"$path") bytes, identical to the contract's"
  else
    red "$label" "$(diff <(printf '%s\n' "$expected") "$path" | tr '\n' '|')"
  fi
}

# --- the fingerprint --------------------------------------------------------
#
# Everything an operation of this palier could have changed on this machine, read
# in one place so that "zero effect" is a comparison and never a claim. The two
# machines hold different halves of the scenario, so each reads its own.

fingerprint() {
  case "$role" in
    lan)
      printf 'vault-account=%s vault-sheet=%s vault-service=%s vault-invocation=%s vault-image=%s ' \
        "$(account_state "$vault_account")" "$(file_digest "$vault_unit")" \
        "$(service_state "$vault_account" "$vault_service")" \
        "$(service_property "$vault_account" "$vault_service" InvocationID)" \
        "$(container_image "$vault_account" "$vault_container")"
      printf 'data=%s/%s archives=[%s] egress-rules=%s egress-unit=%s/%s egress-table=%s ' \
        "$(present "$vault_data")" "$(file_owner "$vault_data")" "$(archive_slots)" \
        "$(file_digest "$egress_rules")" "$(file_digest "$egress_unit")" \
        "$(unit_enabled "$egress_unit_name")" "$(egress_table_loaded)"
      ;;
    vps)
      printf 'pdf-account=%s pdf-sheet=%s pdf-service=%s pdf-invocation=%s ' \
        "$(account_state "$pdf_account")" "$(file_digest "$pdf_unit")" \
        "$(service_state "$pdf_account" "$pdf_service")" \
        "$(service_property "$pdf_account" "$pdf_service" InvocationID)"
      printf 'entry-sheet=%s entry-config=%s entry-service=%s entry-invocation=%s fragments=%s policy=%s sysctl=%s ports=%s/%s ' \
        "$(file_digest "$entry_unit")" "$(file_digest "$entry_configuration")" \
        "$(service_state "$entry_account" "$entry_service")" \
        "$(service_property "$entry_account" "$entry_service" InvocationID)" \
        "$(published_fragments)" "$(file_digest "$host_ports_policy")" \
        "$(host_ports_value)" "$(port_listening 443)" "$(port_listening 80)"
      ;;
  esac
  printf 'key=%s netdev=%s network=%s iface=%s/%s peers=%s link-rules=%s link-unit=%s/%s link-policy=%s link-table=%s tables=[%s]\n' \
    "$(present "$link_key")" "$(file_digest "$link_netdev")" "$(file_digest "$link_network")" \
    "$(interface_state)" "$(interface_index)" "$(wg_peers)" \
    "$(file_digest "$link_rules")" "$(file_digest "$link_unit")" \
    "$(unit_enabled "$link_unit_name")" "$(file_digest "$link_policy")" \
    "$(link_table_loaded)" "$(nft_tables)"
}

unchanged() {
  local label=$1 before=$2 after
  after=$(fingerprint)
  if [[ "$before" == "$after" ]]; then
    report "$label" "zero effect"
  else
    red "$label" "the machine changed: before [$before] after [$after]"
  fi
}

# --- the approval channel ---------------------------------------------------

consumed_sequence() {
  [[ -f "$replay" ]] || {
    echo 0
    return
  }
  sed -n 's/.*"consumed_sequence":\([0-9]*\).*/\1/p' "$replay"
}

# next_sequence is read from the machine rather than counted by the harness. A
# document refused before the sequence is consumed leaves the position where it
# was, and one refused after it has spent it: only the machine knows which.
next_sequence() { echo $(($(consumed_sequence) + 1)); }

# machine_id is what this machine's own anchor names, so that every document this
# harness asks for is aimed at the machine it is applied on and a copied script
# cannot address the other one.
machine_id() { sed -n 's/.*"machine_id":"\([^"]*\)".*/\1/p' "$anchor"; }

# fixture wraps the fixture binary with the two values every document of this
# machine carries: the machine the anchor names, and the next position the
# machine's own anti-replay file allows.
fixture() {
  lab-private-service-fixture -machine "$(machine_id)" -sequence "$(next_sequence)" "$@"
}

# apply <label> <expectation> <fixture arguments...>
#
# It prints what the machine concluded, and holds it against exactly one expected
# fragment of the JSON report. A run that fails is still printed whole, because
# the conclusion of a controlled failure is part of the contract.
apply() {
  local label=$1 expected=$2 output status=0
  shift 2
  output=$(fixture "$@" | your-cloud auxiliary approve --format=json 2>&1) || status=$?
  printf '%s\n' "$output" >"$state/last-report.json"
  case "$output" in
    *"$expected"*) report "$label" "$expected (status $status)" ;;
    *) red "$label" "expected $expected, got: $(echo "$output" | tr '\n' ' ')" ;;
  esac
}

# refuses <label> <expected reason> <fixture arguments...>
#
# The reason is asserted, not merely the non-zero status: a refusal that fired for
# another cause has not proven the rule it is named after. The machine is compared
# with itself before and after, so a refusal that changed something would be a red
# even while its reason was right.
refuses() {
  local label=$1 expected=$2 output before
  shift 2
  before=$(fingerprint)
  if output=$(fixture "$@" | your-cloud auxiliary approve 2>&1); then
    red "$label" "accepted: $(echo "$output" | tr '\n' ' ')"
    return
  fi
  printf '%s\n' "$output" >"$state/last-refusal.txt"
  case "$output" in
    *"$expected"*) report "$label" "refused: $expected" ;;
    *) red "$label" "refused for another reason: $(echo "$output" | tr '\n' ' ')" ;;
  esac
  unchanged "$label, zero effect" "$before"
}

json_field() { sed -n "s/.*\"$1\":\"\\([^\"]*\\)\".*/\\1/p" "$state/last-report.json"; }

# --- what the role decides --------------------------------------------------
#
# role is written by `install` from the argument the driver gave it, and read
# back here rather than guessed from a hostname: the role decides which half of
# the scenario this machine holds, which side of the passage it carries, and the
# two addresses it will ever know of the tunnel.
role=$(cat "$state/role" 2>/dev/null || echo unknown)
case "$role" in
  lan)
    link_role=initiator
    link_own_address=$link_initiator_address
    link_peer_address=$link_listener_address
    other_machine=lab-vps
    ;;
  vps)
    link_role=listener
    link_own_address=$link_listener_address
    link_peer_address=$link_initiator_address
    other_machine=lab-machine-1
    ;;
  *)
    link_role=unknown
    link_own_address=unknown
    link_peer_address=unknown
    other_machine=unknown
    ;;
esac
