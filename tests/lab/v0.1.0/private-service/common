vault_unit="$vault_home/.config/containers/systemd/$vault_account.container"
vault_service="$vault_account.service"
vault_container="$vault_account"
vault_data="$vault_home/data"
vault_snapshots="$vault_home/snapshots"
vault_port=18280
vault_container_port=80
vault_host=vault.lab.your-cloud.test
