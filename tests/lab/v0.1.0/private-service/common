# The confinement of that account: one table, one file, one boot unit.
egress_root=/etc/your-cloud/egress
egress_rules="$egress_root/rules.nft"
egress_unit_name=your-cloud-egress-rules.service
egress_unit="/etc/systemd/system/$egress_unit_name"
egress_table_family=inet
egress_table_name=your-cloud-egress

