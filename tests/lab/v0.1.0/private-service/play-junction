#!/usr/bin/env bash
# The junction of this machine's side, bounded to the loopback port of the vault.
#
# The peer is named by the public key the *other* machine's preparation reported.
# It arrives here as an argument because that is exactly how it travels in the
# real chain: an observation the Controller read out of one report and carried,
# readable, into the plan a human approves on the other machine.
#
# The one thing this palier adds to `#16` is what the bounded service *is*. At
# `#98` the passage was bounded to the stateless profile, because the presence
# rule walked the closed list of service profiles and the private door did not
# exist yet. `#102` opened that reading to both doors, and this step is where the
# consequence is constated on a real machine: a junction of the machine of the LAN
# names the loopback port of a **data-bearing** service, and it is accepted.
set -euo pipefail
here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=common
. "$here/common"

peer_key=${1:?usage: play-junction <peer-public-key> <peer-endpoint-host>}
endpoint=${2:?usage: play-junction <peer-public-key> <peer-endpoint-host>}

cd /root

operation=attach_link_peer
[[ "$link_role" == initiator ]] && operation=join_link_peer

step "7. the junction of the $link_role, bounded to the vault's loopback port $vault_port"

report "the peer this plan names" "$peer_key"
[[ "$link_role" == initiator ]] && report "the endpoint it reaches" "$endpoint:$link_listen_port"

apply "$operation" '"changed":true' \
  -operation "$operation" -link-role "$link_role" \
  -peer-public-key "$peer_key" -peer-endpoint-host "$endpoint" \
  -service-port "$vault_port"

matches_bytes "the description, with its one peer" "$link_netdev" \
  "$(expected_netdev "$peer_key" "$endpoint")"
matches_bytes "the addressing, with its one route" "$link_network" \
  "$(expected_network with-route)"
expect "the peers the kernel holds" "$(wg_peers)" "$peer_key"
expect "what that peer is allowed to be" "$(wg_allowed_ips)" "$link_peer_address/32"
expect "the bounding rules on disk" "$(file_owner "$link_rules")" "root:root 644"
expect "the bounding table in the kernel" "$(link_table_loaded)" loaded
expect "the unit that puts the bounds back at boot" "$(unit_enabled "$link_unit_name")" enabled

rules=$(link_table_rules)
if grep -qF "tcp dport $vault_port" <<<"$rules"; then
  report "the one port the loaded table bounds" "$vault_port, the vault's own loopback port"
else
  red "the one port the loaded table bounds" "$(printf '%s' "$rules" | tr '\n' ' ')"
fi

if [[ "$link_role" == initiator ]]; then
  grep -qF "iifname \"$link_interface\" ip saddr $link_peer_address tcp dport $vault_port dnat ip to 127.0.0.1:$vault_port" <<<"$rules" \
    && report "the redirection towards the vault's loopback" "posed, for the approved port alone" \
    || red "the redirection towards the vault's loopback" "absent from the loaded table"
  expect "route_localnet on the passage's interface" "$(sysctl_value "$route_localnet_key")" 1
  expect "route_localnet on every interface at once" \
    "$(sysctl_value net.ipv4.conf.all.route_localnet)" 0
  expect "route_localnet on the interface facing the LAN" \
    "$(sysctl_value net.ipv4.conf.enp1s0.route_localnet)" 0
  # The point this palier adds: the port the passage bounds is published by a
  # profile of the *private* door, and the presence rule accepted it.
  grep -qx "PublishPort=127.0.0.1:$vault_port:$vault_container_port" "$vault_unit" \
    && report "what publishes the port this junction bounds" \
      "the sheet of the private profile, which the presence rule of #102 reads through the second door" \
    || red "what publishes the port this junction bounds" "$(grep '^PublishPort=' "$vault_unit" | tr '\n' ' ')"
else
  expect "the host relaxation, on the listener" "$(present "$link_policy")" absent
  expect "any dnat in the listener's table" "$(printf '%s\n' "$rules" | grep -c dnat)" 0
  grep -qF "oifname \"$link_interface\" ip daddr $link_peer_address tcp dport $vault_port accept" <<<"$rules" \
    && report "what may leave by the passage" "one couple: $link_peer_address:$vault_port" \
    || red "what may leave by the passage" "absent from the loaded table"
fi

expect "forwarding on this machine" "$(sysctl_value net.ipv4.ip_forward)" 0
report "the tables this machine holds" "$(nft_tables)"

verdict "this machine holds exactly one peer, one named table bounding exactly the vault's loopback port, one boot unit, and — on the initiator alone — one interface-scoped relaxation"
