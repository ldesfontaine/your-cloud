#!/usr/bin/env bash
# Drive the Controller installation proof: build the bundle, mount the
# perimeter, judge, install, stop the App for real, check the Controller,
# roll back, remove.
#
# The two VM play the two sides the architecture names: lab-app holds the
# App and the Assistant, lab-machine-1 is the private machine the placement
# of #36 approved and the one endpoint the preflight declares is lab-app
# itself — reachable *from the Controller*, which is the whole point of the
# step.
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage: prove [bundle | setup | judge | install | preflight | shutdown | rollback | remove | all]

  bundle    build the .deb and its manifest, and sign it with the LAB anchor
  setup     mount the perimeter on both VM
  judge     run every bundle, preflight and rollback case against the gates
  install   install the Controller, after the gate has judged the bundle
  preflight reach the declared endpoint from the Controller and judge it
  shutdown  really stop the Assistant and the App, then check the Controller
  rollback  prove a failure at each step leaves a reconstructible machine
  remove    remove the perimeter from both VM and prove its absence
  all       the eight above in order, removing even when a step fails (default)
EOF
  exit 2
}

command=${1:-all}
[[ $# -eq 0 ]] || shift
[[ $# -eq 0 ]] || usage
case "$command" in
  bundle | setup | judge | install | preflight | shutdown | rollback | remove | all) ;;
  *) usage ;;
esac

root=$(cd -- "$(dirname -- "$0")/../../../.." && pwd)
labctl="$root/tools/labctl"
harness="$root/tests/lab/v0.1.0/controller-install"
app_vm=lab-app
controller_vm=lab-machine-1
expected_origin=your-cloud/labctl
remote_harness=/root/your-cloud-lab-controller-install
app_state=/root/lab-controller-install
controller_unit=your-cloud-controller.service
# The release identity has one source: app/package.json. A number copied
# here would be the copy someone forgets, and the bundle this harness builds
# would then prove an identity the candidate does not carry.
version=$(sed -n 's/^  "version": "\([0-9.]*\)",$/\1/p' "$root/app/package.json" | head -1)
[[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] \
  || { echo "FAILED: cannot read the release version from app/package.json" >&2; exit 1; }
workdir=$(mktemp -d)
trap 'rm -rf "$workdir"' EXIT

fail() { echo "FAILED: $*" >&2; exit 1; }

# The mandatory inventory guard: read the LAB before mutating any of it.
inventory() {
  local vm=$1 line state ips template topology origin
  line=$("$labctl" list --format=tsv | awk -v vm="$vm" -F'\t' '$1 == vm')
  [[ -n "$line" ]] || fail "$vm is not part of the LAB inventory"
  IFS=$'\t' read -r _ state ips template topology origin <<<"$line"
  [[ "$origin" == "$expected_origin" ]] || fail "$vm carries the origin $origin"
  [[ "$state" == running ]] || fail "$vm is $state"
  [[ "$topology" == quick ]] || fail "$vm belongs to the topology $topology"
  [[ "$ips" != *,* ]] || fail "$vm holds several addresses: $ips"
  [[ "$ips" != 192.168.122.123 && "$ips" != 10.66.66.1 ]] \
    || fail "$vm holds an address this project never mutates"
  echo "$ips"
}

install_script() {
  local vm=$1 script=$2
  "$labctl" ssh "$vm" -- "install -d -m 0700 $remote_harness"
  "$labctl" copy-to "$vm" "$harness/$script" "$remote_harness/$script" >/dev/null
  "$labctl" ssh "$vm" -- "chmod 0700 $remote_harness/$script"
}

# The bundle is built where Go lives, in one directory the teardown proves
# absent. It is deliberately not built on the workstation and never committed:
# the artefact of a proof is produced by the proof.
bundle() {
  inventory "$controller_vm" >/dev/null
  echo "building the server bundle in $controller_vm"
  tar -C "$root" -czf "$workdir/bundle-src.tgz" \
    go.mod go.sum cmd internal packaging tools/build-server-bundle \
    tests/lab/v0.1.0/controller-install/_signer
  "$labctl" copy-to "$controller_vm" "$workdir/bundle-src.tgz" /root/bundle-src.tgz >/dev/null
  "$labctl" ssh "$controller_vm" -- "
set -e
rm -rf /root/bundlebuild
install -d /root/bundlebuild/src /root/bundlebuild/out
tar -C /root/bundlebuild/src -xzmf /root/bundle-src.tgz
rm -f /root/bundle-src.tgz
export PATH=\$PATH:/usr/local/go/bin
LC_ALL=C.UTF-8 /root/bundlebuild/src/tools/build-server-bundle $version /root/bundlebuild/src /root/bundlebuild/out
LC_ALL=C.UTF-8 go build -C /root/bundlebuild/src/tests/lab/v0.1.0/controller-install/_signer -o /root/bundlebuild/out/lab-bundle-signer .
" >"$workdir/bundle.out"
  cat "$workdir/bundle.out"
  for file in "your-cloud-server_${version}_amd64.deb" bundle-manifest.json lab-bundle-signer; do
    "$labctl" copy-from "$controller_vm" "/root/bundlebuild/out/$file" "$workdir/$file" >/dev/null
  done
  install -d -m 0700 "$workdir/bundle"
  mv "$workdir/your-cloud-server_${version}_amd64.deb" \
    "$workdir/bundle-manifest.json" "$workdir/bundle/"
  echo "bundle built: $(sha256sum "$workdir/bundle/your-cloud-server_${version}_amd64.deb" | cut -d' ' -f1)"
}

setup() {
  local app_address controller_address app_host_key
  app_address=$(inventory "$app_vm")
  controller_address=$(inventory "$controller_vm")
  echo "perimeter: App $app_vm, Controller $controller_vm"

  [[ -d "$workdir/bundle" ]] || fail "no bundle in this run; call bundle first"

  # The anchor is generated at mount time and destroyed at teardown. Nothing in
  # the repository ever holds a private byte of it.
  install -d -m 0700 "$workdir/keys"
  head -c 32 /dev/urandom >"$workdir/keys/seed"
  chmod 0600 "$workdir/keys/seed"
  "$workdir/lab-bundle-signer" -seed "$workdir/keys/seed" \
    -manifest "$workdir/bundle/bundle-manifest.json" \
    -anchor "$workdir/bundle/anchor" \
    -signature "$workdir/bundle/bundle-manifest.sig"

  # The declared endpoint the Controller will have to reach, and the host key
  # already confirmed for it — read through the managed channel, never from a
  # first answer on the wire.
  "$labctl" copy-from "$app_vm" /etc/ssh/ssh_host_ed25519_key.pub \
    "$workdir/app-host-key.pub" >/dev/null
  app_host_key=$(ssh-keygen -l -f "$workdir/app-host-key.pub" | awk '{print $2}')

  # The Assistant side.
  "$labctl" ssh "$app_vm" -- "rm -rf $app_state && install -d -m 0700 $app_state $app_state/keys $app_state/bundle"
  "$labctl" copy-to "$app_vm" "$workdir/keys/seed" "$app_state/keys/seed" >/dev/null
  "$labctl" ssh "$app_vm" -- "chmod 0600 $app_state/keys/seed"
  "$labctl" copy-to "$app_vm" "$workdir/lab-bundle-signer" "$app_state/signer" >/dev/null
  for file in "your-cloud-server_${version}_amd64.deb" bundle-manifest.json bundle-manifest.sig anchor; do
    "$labctl" copy-to "$app_vm" "$workdir/bundle/$file" "$app_state/bundle/$file" >/dev/null
  done
  "$labctl" ssh "$app_vm" -- "chmod 0700 $app_state/signer"

  # The fixture is built from the sources this run synchronised, in lab-app,
  # exactly like the personal access suite. It is never downloaded and never
  # committed.
  "$labctl" ssh "$app_vm" -- "
set -e
. /root/.cargo/env
cd /root/work/src-tauri
export CARGO_BUILD_JOBS=1 LC_ALL=C.UTF-8
cargo +1.94.1 build --locked --offline -j 1 -p your-cloud-native-bootstrap-assistant \
  --features controller-install-contract-test --bin your-cloud-controller-install-fixture >/dev/null 2>&1
install -m 0700 target/debug/your-cloud-controller-install-fixture $app_state/fixture"

  install_script "$app_vm" judge
  install_script "$controller_vm" install-controller
  install_script "$controller_vm" remove

  # The synthetic credential sources. They are generated here and never leave
  # the perimeter; the Controller reads them through systemd alone.
  install -d -m 0700 "$workdir/credentials"
  "$labctl" ssh "$controller_vm" -- "install -d -m 0700 /root/controller-install-credentials"
  # A real authority and a leaf it issued: the Controller refuses a
  # `relay-reader-ca.crt` that is not a certificate authority, and a fixture
  # that handed it a self-signed leaf would be testing the fixture.
  openssl req -x509 -newkey ed25519 -nodes -days 1 -subj /CN=lab-relay-reader-ca \
    -addext "basicConstraints=critical,CA:TRUE" \
    -addext "keyUsage=critical,keyCertSign,cRLSign" \
    -keyout "$workdir/credentials/ca.key" \
    -out "$workdir/credentials/relay-reader-ca.crt" >/dev/null 2>&1
  openssl req -new -newkey ed25519 -nodes -subj /CN=lab-controller-reader \
    -keyout "$workdir/credentials/controller-reader.key" \
    -out "$workdir/credentials/reader.csr" >/dev/null 2>&1
  openssl x509 -req -in "$workdir/credentials/reader.csr" \
    -CA "$workdir/credentials/relay-reader-ca.crt" -CAkey "$workdir/credentials/ca.key" \
    -days 1 -out "$workdir/credentials/controller-reader.crt" >/dev/null 2>&1
  for file in controller-reader.crt controller-reader.key relay-reader-ca.crt; do
    "$labctl" copy-to "$controller_vm" "$workdir/credentials/$file" \
      "/root/controller-install-credentials/$file" >/dev/null
  done

  {
    echo "export YOUR_CLOUD_LAB_CONTROLLER_STATE=$app_state"
    echo "export YOUR_CLOUD_LAB_CONTROLLER_TARGET_NAME=$app_vm"
    echo "export YOUR_CLOUD_LAB_CONTROLLER_TARGET_KEY=$app_host_key"
    echo "export YOUR_CLOUD_LAB_CONTROLLER_ADDRESS=$controller_address"
    echo "export YOUR_CLOUD_LAB_APP_ADDRESS=$app_address"
    echo "export YOUR_CLOUD_LAB_BUNDLE_VERSION=$version"
  } >"$workdir/perimeter.env"
  "$labctl" copy-to "$app_vm" "$workdir/perimeter.env" "$app_state/perimeter.env" >/dev/null
  cp "$workdir/perimeter.env" "$workdir/perimeter.env.local"
  echo "perimeter mounted; declared endpoint $app_vm with $app_host_key"
}

judge() {
  "$labctl" ssh "$app_vm" -- \
    ". $app_state/perimeter.env && $remote_harness/judge"
}

# The gate runs first, on the App, against the very artefact that is about
# to travel. Only if it answers VERIFIED does the .deb reach the machine.
install_controller() {
  local verdict controller_address app_address
  controller_address=$(inventory "$controller_vm")
  app_address=$(inventory "$app_vm")
  verdict=$("$labctl" ssh "$app_vm" -- \
    "$app_state/fixture verify-bundle $app_state/bundle/anchor \
     $app_state/bundle/bundle-manifest.json $app_state/bundle/bundle-manifest.sig \
     $version $app_state/bundle/your-cloud-server_${version}_amd64.deb")
  case "$verdict" in
    VERIFIED*) echo "gate: $verdict" ;;
    *) fail "the gate refused the bundle before installation: $verdict" ;;
  esac

  # The artefact travels only now, and it travels through the App.
  "$labctl" ssh "$app_vm" -- "install -d -m 0700 $app_state/outbound"
  "$labctl" copy-from "$app_vm" \
    "$app_state/bundle/your-cloud-server_${version}_amd64.deb" \
    "$workdir/outbound.deb" >/dev/null
  "$labctl" copy-to "$controller_vm" "$workdir/outbound.deb" \
    /root/controller-install-bundle >/dev/null

  "$labctl" ssh "$controller_vm" -- "$remote_harness/install-controller \
    /root/controller-install-bundle ${controller_address}:9443 ${app_address}/32 ${app_address}:8444"

  # What the package owns, read back off the machine rather than off the file
  # that was sent.
  "$labctl" ssh "$controller_vm" -- '
set -e
echo "--- what dpkg inventories ---"
dpkg -L your-cloud-server | sort
echo "--- ownership, mode, setuid and capabilities ---"
stat -c "%n %U:%G %a" /usr/lib/your-cloud/your-cloud /usr/lib/systemd/system/your-cloud-*.service
find /usr/lib/your-cloud -perm /6000 -printf "SETUID_OR_SETGID %p\n"
getcap -r /usr/lib/your-cloud 2>/dev/null | sed "s/^/CAPABILITY /"
echo "--- which units the installation left inactive ---"
systemctl is-enabled your-cloud-controller.service your-cloud-daemon.service your-cloud-relay.service || true
echo "--- the running Controller, its account and its budgets ---"
systemctl is-active your-cloud-controller.service
systemctl show your-cloud-controller.service -p User -p DynamicUser -p TasksMax -p MemoryMax -p NoNewPrivileges -p CapabilityBoundingSet -p ProtectSystem
ps -o user=,args= -C your-cloud | head -3'
}

# The real thing the issue asks for: the Assistant stops, the App stops, the
# laptop closes, and the Controller is checked *afterwards* through the LAB
# channel rather than through anything the App holds open.
# The observing half of the preflight, run from the machine that now holds the
# Controller. `judge` exercises the decision on written observations; this
# exercises it on what the Controller machine really saw on the wire, which is
# the difference between "the endpoint is reachable" and "the endpoint is
# reachable from here".
real_preflight() {
  local app_address app_host_key observed unreachable
  app_address=$(inventory "$app_vm")
  app_host_key=$(awk -F= '/TARGET_KEY/ {print $2}' "$workdir/perimeter.env")

  observed=$("$labctl" ssh "$controller_vm" -- \
    "ssh-keyscan -T 5 -t ssh-ed25519 $app_address 2>/dev/null | ssh-keygen -lf - | awk '{print \$2}'")
  [[ -n "$observed" ]] || fail "the Controller machine observed no host key at all"
  echo "the Controller reached $app_vm and was presented $observed"

  # An address in the RFC 5737 documentation range: routed nowhere, so the
  # Controller really fails to reach it rather than being told not to try.
  unreachable=$("$labctl" ssh "$controller_vm" -- \
    "ssh-keyscan -T 3 -t ssh-ed25519 192.0.2.1 2>/dev/null | ssh-keygen -lf - 2>/dev/null | awk '{print \$2}'" || true)
  [[ -z "$unreachable" ]] || fail "192.0.2.1 answered a host key; the LAB is not what it claims"

  {
    printf '%s\t%s\t%s\n' "$app_vm" "$app_host_key" "$observed"
  } >"$workdir/preflight-real"
  "$labctl" copy-to "$app_vm" "$workdir/preflight-real" \
    "$app_state/preflight-real" >/dev/null
  local verdict
  verdict=$("$labctl" ssh "$app_vm" -- \
    "$app_state/fixture preflight $app_state/preflight-real") \
    || fail "the real observation did not clear the preflight: $verdict"
  echo "gate on the real observation: $verdict"

  # The same collection against an endpoint the Controller genuinely cannot
  # reach, fed to the same gate.
  printf 'unreachable-endpoint\t%s\tUNREACHABLE\n' "$app_host_key" \
    >"$workdir/preflight-real-hostile"
  "$labctl" copy-to "$app_vm" "$workdir/preflight-real-hostile" \
    "$app_state/preflight-real-hostile" >/dev/null
  verdict=$("$labctl" ssh "$app_vm" -- \
    "$app_state/fixture preflight $app_state/preflight-real-hostile" || true)
  case "$verdict" in
    *Unreachable*) echo "gate on the unreachable endpoint: $verdict" ;;
    *) fail "an endpoint the Controller could not reach was cleared: $verdict" ;;
  esac
  echo "PASS: the preflight decided on what the Controller itself observed"
}

controller_pid() {
  "$labctl" ssh "$controller_vm" -- "systemctl show $controller_unit -p MainPID --value"
}

controller_state() {
  "$labctl" ssh "$controller_vm" -- "systemctl show $controller_unit -p ActiveState --value"
}

shutdown_app() {
  local pid_before pid_after state_after swap_before
  pid_before=$(controller_pid)
  echo "Controller before the shutdown: pid=$pid_before state=$(controller_state)"

  # What the machine holds that a power cycle would silently drop. The LAB's
  # swap is enabled by hand rather than by `fstab`, and several suites of this
  # palier need it: a harness that stops a machine owes it the state it found,
  # and losing it here would redden a later suite for a reason that has nothing
  # to do with the code it tests.
  swap_before=$("$labctl" ssh "$app_vm" -- \
    "swapon --show=NAME --noheadings 2>/dev/null | tr '\n' ' '" || true)
  [[ -z "${swap_before// /}" ]] || echo "swap to restore afterwards: $swap_before"

  echo "stopping the Assistant process in $app_vm"
  "$labctl" ssh "$app_vm" -- '
set -e
pkill -f your-cloud-native-bootstrap-assistant || true
pkill -f your-cloud-controller-install-fixture || true
sleep 1
if pgrep -f your-cloud-native-bootstrap-assistant >/dev/null; then
  echo "FAILED: an Assistant process survived" >&2
  exit 1
fi
echo "no Assistant process remains"'

  echo "stopping $app_vm itself — the App and the laptop"
  "$labctl" stop "$app_vm"
  local state
  state=$("$labctl" list --format=tsv | awk -v vm="$app_vm" -F'\t' '$1 == vm {print $2}')
  [[ "$state" == "shut off" ]] || fail "$app_vm is $state, not shut off"
  echo "$app_vm is really shut off"

  # Checked from the piloting laptop through the LAB control channel. Nothing
  # the App owns is involved in this answer.
  pid_after=$(controller_pid)
  state_after=$(controller_state)
  echo "Controller after the shutdown: pid=$pid_after state=$state_after"
  [[ "$state_after" == active ]] \
    || fail "the Controller is not active after the App stopped: $state_after"
  # The same process, not a replacement one: a unit that had died and been
  # restarted by systemd would also read `active`, and would prove nothing.
  [[ "$pid_before" == "$pid_after" ]] \
    || fail "the Controller restarted rather than survived: pid $pid_before then $pid_after"
  "$labctl" ssh "$controller_vm" -- "ss -ltn | grep -q ':9443' && echo 'the Controller still listens on 9443'"

  echo "restarting $app_vm"
  "$labctl" start "$app_vm"
  for _ in $(seq 1 60); do
    if "$labctl" ssh "$app_vm" -- true >/dev/null 2>&1; then break; fi
    sleep 2
  done
  "$labctl" ssh "$app_vm" -- true || fail "$app_vm did not come back"
  inventory "$app_vm" >/dev/null

  local area
  for area in $swap_before; do
    "$labctl" ssh "$app_vm" -- "swapon $area" \
      || fail "$app_vm came back without the swap it had at $area"
  done
  if [[ -n "${swap_before// /}" ]]; then
    "$labctl" ssh "$app_vm" -- "swapon --show=NAME --noheadings | grep -q ." \
      || fail "$app_vm came back without any swap"
    echo "swap restored in $app_vm"
  fi
  echo "PASS: the Controller survived the Assistant, the App and the laptop"
}

# A failure at each step, on the machine, with the ledger the step really
# produced. It runs after `remove`, on a machine the teardown proved clean, so
# each stop point starts from the same initial state.
rollback() {
  local step output controller_address app_address
  # The addresses come from the inventory, never from this file.
  controller_address=$(inventory "$controller_vm")
  app_address=$(inventory "$app_vm")
  for step in package configuration state credentials; do
    "$labctl" ssh "$controller_vm" -- "$remote_harness/remove" >/dev/null 2>&1 || true
    output=$("$labctl" ssh "$controller_vm" -- \
      "YOUR_CLOUD_FAIL_AT=$step $remote_harness/install-controller \
       /root/controller-install-bundle ${controller_address}:9443 \
       ${app_address}/32 ${app_address}:8444" \
      2>&1 || true)
    case "$output" in
      *"STOPPED_AT=$step"*) ;;
      *) fail "the installation did not stop at $step: $output" ;;
    esac
    "$labctl" copy-from "$controller_vm" /root/controller-install-ledger \
      "$workdir/ledger-$step" >/dev/null
    echo "--- stopped at $step, the ledger it produced ---"
    cat "$workdir/ledger-$step"
    # The Assistant's own unwind decides what that ledger allows.
    "$labctl" copy-to "$app_vm" "$workdir/ledger-$step" \
      "$app_state/ledger-$step" >/dev/null
    output=$("$labctl" ssh "$app_vm" -- \
      "$app_state/fixture unwind $app_state/ledger-$step" || true)
    echo "unwind: $output"
    case "$output" in
      COMPLETE*) ;;
      *) fail "a clean stop at $step did not unwind completely: $output" ;;
    esac
    # And the machine really returns to the state the run found.
    "$labctl" ssh "$controller_vm" -- "$remote_harness/remove" >/dev/null \
      || fail "the machine did not return to its initial state after a stop at $step"
  done
  echo "PASS: a failure at each step leaves a machine the unwind can reconstruct"
}

remove() {
  local status=0
  "$labctl" ssh "$controller_vm" -- "$remote_harness/remove" || status=1
  # The perimeter's own inputs, which `remove` deliberately leaves alone so it
  # can serve as the reset between the rollback stop points. The synthetic
  # private key of the reader identity is destroyed, not merely unlinked.
  "$labctl" ssh "$controller_vm" -- "
if [ -d /root/controller-install-credentials ]; then
  find /root/controller-install-credentials -type f -exec shred -u {} + 2>/dev/null || true
fi
rm -rf $remote_harness /root/bundlebuild /root/bundle-src.tgz \
  /root/controller-install-bundle /root/controller-install-credentials" || status=1
  "$labctl" ssh "$app_vm" -- "
if [ -d $app_state/keys ]; then find $app_state/keys -type f -exec shred -u {} + 2>/dev/null || true; fi
rm -rf $app_state $remote_harness" || status=1
  # Absence is asserted, never assumed: a teardown that only issued the commands
  # would leave the next run to discover what it failed to take away.
  for path in "$remote_harness" /root/bundlebuild /root/controller-install-bundle \
    /root/controller-install-credentials; do
    "$labctl" ssh "$controller_vm" -- "test ! -e $path" \
      || { echo "FAILED: $path is still present in $controller_vm" >&2; status=1; }
  done
  "$labctl" ssh "$app_vm" -- "test ! -e $app_state" \
    || { echo 'FAILED: the App state is still present' >&2; status=1; }
  [[ $status -eq 0 ]] || fail "the perimeter removal is not proven"
  echo "perimeter removed from both machines"
}

case "$command" in
  bundle) bundle ;;
  setup) fail "setup needs the bundle of the same run; use all" ;;
  judge) judge ;;
  install) install_controller ;;
  preflight) real_preflight ;;
  shutdown) shutdown_app ;;
  rollback) rollback ;;
  remove) remove ;;
  all)
    status=0
    bundle
    setup
    judge || status=$?
    if [[ $status -eq 0 ]]; then install_controller || status=$?; fi
    if [[ $status -eq 0 ]]; then real_preflight || status=$?; fi
    if [[ $status -eq 0 ]]; then shutdown_app || status=$?; fi
    if [[ $status -eq 0 ]]; then rollback || status=$?; fi
    remove
    [[ $status -eq 0 ]] || fail "the Controller installation proof failed with $status"
    echo "PROVE_CONTROLLER_INSTALL_OK"
    ;;
esac
