#!/usr/bin/env bash
# Mount the synthetic server side of the personal access perimeter.
set -euo pipefail

[[ $# -eq 4 ]] || {
  echo "usage: install-server <authorized-public-key> <observer-public-key>" \
    "<file-ed25519-public-key> <file-rsa-public-key>" >&2
  exit 2
}
authorized_pub=$1
observer_pub=$2
file_ed25519_pub=$3
file_rsa_pub=$4

[[ $(id -u) -eq 0 ]] || { echo "install-server must run as root" >&2; exit 1; }
command -v sshd >/dev/null || command -v /usr/sbin/sshd >/dev/null \
  || { echo "an OpenSSH server is required" >&2; exit 1; }

# Every synthetic account, forced command and listener carries this prefix, so
# the removal script can name exactly what this one created.
prefix=ycpa
forced_dir=/usr/local/lib/your-cloud-lab-personal-access
log_fragment=/etc/ssh/sshd_config.d/$prefix-log.conf
hostile_key=/etc/ssh/${prefix}_hostile_ecdsa_key
nominal_port=22
ecdsa_port=2202
kex_port=2203
cipher_port=2204
# The canary listener. It is a real `sshd`, on a real port of this machine, that
# nothing ever declares to the client: an audit that scanned anything would
# reach it, and its journal is what says whether anything did.
canary_port=2205
canary_log=/var/log/sshd-$prefix-canary.log
# `MAX_PROBE_STREAM_BYTES` of the client, and the single byte past it.
bound=4096
over_bound=$((bound + 1))

nominal=${prefix}nom
oversized_stdout=${prefix}out
oversized_stderr=${prefix}err
exact_bound=${prefix}fit
held=${prefix}hold

# The elevation perimeter of #54. Each account carries one policy and one
# deviation, so a refusal names the policy that produced it instead of a
# combination. None of them is ever given a forced command: they must run the
# three exact channels the client opens.
#
# `listpw=never` is what makes the single `sudo -S` reachable at all. Debian's
# default is `listpw=any`, under which listing a password-protected policy
# itself demands the password, and #51 refuses to send one to find out whether
# it may send one. The two accounts below that really answer a password
# therefore describe the one configuration in which a password may travel, and
# the account without it is kept as the control that says so.
sudo_password=${prefix}sudp
sudo_nopasswd=${prefix}sudn
sudo_unlistable=${prefix}sudx
sudo_log_input=${prefix}sudl
sudo_requiretty=${prefix}sudt
sudo_divergent=${prefix}sudd
sudo_ambiguous=${prefix}suda
sudo_oversized=${prefix}sudb
# Le compte qu'une installation exige, et le seul.
#
# Les comptes ci-dessus n'autorisent que la sonde d'identité : c'est assez pour
# prouver l'élévation et pour l'audit en lecture seule, et ce n'est pas assez
# pour installer — le contrat de l'Assistant qui installe le refuse avant toute
# fenêtre, en nommant ce que l'entrée permet. Celui-ci est donc ajouté **à côté**
# d'eux et ne les remplace pas : l'asymétrie est ce que la preuve doit
# constater, donc les deux formes doivent exister en même temps sur la machine.
sudo_every_command=${prefix}sude
sudo_accounts=(
  "$sudo_password" "$sudo_nopasswd" "$sudo_unlistable" "$sudo_log_input"
  "$sudo_requiretty" "$sudo_divergent" "$sudo_ambiguous" "$sudo_oversized"
  "$sudo_every_command"
)

# The audit perimeter of #36. One account per synthetic machine profile, plus
# the nominal one which carries no forced command at all: what that one answers
# is this very machine, so the compatible control is a real Debian reading and
# not a fixture agreeing with itself.
#
# Every other profile answers the three fixed read-only commands of the audit
# and refuses every other command outright, which is what makes "the client sent
# exactly those three commands" a server-side verdict rather than a client-side
# claim.
audit_nominal=${prefix}audn
audit_distribution=${prefix}audd
audit_architecture=${prefix}auda
audit_resources=${prefix}audr
audit_facility=${prefix}audf
audit_installed=${prefix}audi
audit_silent=${prefix}auds
audit_profiles=(
  "$audit_distribution" "$audit_architecture" "$audit_resources"
  "$audit_facility" "$audit_installed" "$audit_silent"
)

# The three commands, spelled exactly as `personal_access::audit` declares them.
# A client that changed one of them would be answered 127 by every profile.
audit_uname='/usr/bin/uname -m'
audit_df='/usr/bin/df -k -P /var'
audit_head='/usr/bin/head -v -c 320 /proc/self/status /etc/hostname /etc/os-release /proc/1/comm /sys/fs/cgroup/cgroup.controllers /proc/meminfo /sys/devices/system/cpu/online /etc/your-cloud/roles'

accounts=(
  "$nominal" "$oversized_stdout" "$oversized_stderr" "$exact_bound" "$held"
  "${sudo_accounts[@]}" "$audit_nominal" "${audit_profiles[@]}"
)

for key in "$authorized_pub" "$observer_pub" "$file_ed25519_pub" "$file_rsa_pub"; do
  [[ -f "$key" && ! -L "$key" ]] || { echo "public key is missing or symbolic: $key" >&2; exit 1; }
  ssh-keygen -l -f "$key" >/dev/null \
    || { echo "not an OpenSSH public key: $key" >&2; exit 1; }
  if grep -q 'PRIVATE KEY' "$key"; then
    echo "refusing private key material: $key" >&2
    exit 1
  fi
done

for account in "${accounts[@]}"; do
  if id -u "$account" >/dev/null 2>&1; then
    echo "account $account already exists; run remove-server first" >&2
    exit 1
  fi
done

authorized_line=$(cat -- "$authorized_pub")
observer_line=$(cat -- "$observer_pub")
# The two identities the encrypted key files of #53 carry. They are authorised
# on every synthetic account, exactly like the agent identity, so the fallback
# is proven against the same accounts, the same forced commands and the same
# closures rather than against a perimeter of its own.
file_ed25519_line=$(cat -- "$file_ed25519_pub")
file_rsa_line=$(cat -- "$file_rsa_pub")
restrictions=no-agent-forwarding,no-port-forwarding,no-pty,no-user-rc,no-X11-forwarding

# The forced commands. Only the server decides how many bytes come back, which
# is the shape of the threat the client must survive.
install -d -m 0755 "$forced_dir"
cat >"$forced_dir/flood-stdout" <<EOF
#!/bin/sh
head -c $over_bound /dev/zero | tr '\0' x
exit 0
EOF
cat >"$forced_dir/flood-stderr" <<EOF
#!/bin/sh
head -c $over_bound /dev/zero | tr '\0' y >&2
exit 0
EOF
cat >"$forced_dir/exact-stdout" <<EOF
#!/bin/sh
head -c $bound /dev/zero | tr '\0' z
exit 0
EOF
# The held probe reads the channel itself, so it lives exactly as long as the
# transport does and never a moment longer.
cat >"$forced_dir/hold" <<'EOF'
#!/bin/sh
exec cat
EOF
chmod 0755 "$forced_dir"/flood-stdout "$forced_dir"/flood-stderr \
  "$forced_dir"/exact-stdout "$forced_dir"/hold

# ------------------------------------------------ the synthetic machines of #36
#
# One script serves every profile and computes nothing: it matches the command
# against the three fixed ones, and answers with a file the profile of the
# account that is logged in holds. A profile carrying `fail` answers nothing at
# all, which is the machine that never says what it is.
install -d -m 0755 "$forced_dir/profiles"
cat >"$forced_dir/audit-profile" <<EOF
#!/bin/sh
profile=$forced_dir/profiles/\$(id -un)
if [ -e "\$profile/fail" ]; then
  echo "this machine answers nothing" >&2
  exit 1
fi
case "\$SSH_ORIGINAL_COMMAND" in
"$audit_uname") exec cat "\$profile/uname" ;;
"$audit_df") exec cat "\$profile/df" ;;
"$audit_head") exec cat "\$profile/head" ;;
esac
echo "the audited machine was asked something it never agreed to answer" >&2
exit 127
EOF
chmod 0755 "$forced_dir/audit-profile"

# One synthetic machine, written as the three answers it gives.
write_profile() {
  local account=$1 arch=$2 os_id=$3 os_version=$4 init=$5 hierarchy=$6
  local memory_kb=$7 processors=$8 free_kb=$9 roles=${10}
  local directory="$forced_dir/profiles/$account"
  install -d -m 0755 "$directory"
  printf '%s\n' "$arch" >"$directory/uname"
  {
    printf 'Filesystem     1024-blocks    Used Available Capacity Mounted on\n'
    printf '/dev/vda1         10113424 1263772 %s      14%% /\n' "$free_kb"
  } >"$directory/df"
  {
    # `head -v` writes one header per file, a blank line before each header but
    # the first, and no header at all for a file it could not open. What is
    # written below is that layout, so what the client parses in the LAB is what
    # it parses on a real machine.
    printf '==> /proc/self/status <==\nName:\thead\nUid:\t4242\t4242\t4242\t4242\n'
    printf '\n==> /etc/hostname <==\nsynthetic-%s\n' "$account"
    printf '\n==> /etc/os-release <==\nID=%s\nVERSION_ID="%s"\n' "$os_id" "$os_version"
    printf '\n==> /proc/1/comm <==\n%s\n' "$init"
    if [[ "$hierarchy" == unified ]]; then
      printf '\n==> /sys/fs/cgroup/cgroup.controllers <==\ncpuset cpu io memory pids\n'
    fi
    printf '\n==> /proc/meminfo <==\nMemTotal: %10s kB\nMemFree:        1 kB\n' "$memory_kb"
    printf '\n==> /sys/devices/system/cpu/online <==\n%s\n' "$processors"
    if [[ "$roles" != none ]]; then
      printf '\n==> /etc/your-cloud/roles <==\n%s\n' "$roles"
    fi
  } >"$directory/head"
  chmod 0644 "$directory"/uname "$directory"/df "$directory"/head
}

# The supported target in every respect but one, so each refusal is produced by
# a single deviation and names it.
write_profile "$audit_distribution" x86_64 ubuntu 24.04 systemd unified 4194304 0-1 8388608 none
write_profile "$audit_architecture" aarch64 debian 13 systemd unified 4194304 0-1 8388608 none
write_profile "$audit_resources" x86_64 debian 13 systemd unified 131072 0 8388608 none
write_profile "$audit_facility" x86_64 debian 13 openrc legacy 4194304 0-1 8388608 none
# A machine that already declares a Relay: an existing installation, its active
# role, and the cohabitation a proposal must announce.
write_profile "$audit_installed" x86_64 debian 13 systemd unified 4194304 0-1 8388608 relay
# The machine that answers nothing. Every fact of it must come back unknown.
write_profile "$audit_silent" x86_64 debian 13 systemd unified 4194304 0-1 8388608 none
: >"$forced_dir/profiles/$audit_silent/fail"

declare -A forced=(
  ["$nominal"]=""
  ["$oversized_stdout"]="$forced_dir/flood-stdout"
  ["$oversized_stderr"]="$forced_dir/flood-stderr"
  ["$exact_bound"]="$forced_dir/exact-stdout"
  ["$held"]="$forced_dir/hold"
)
for account in "${sudo_accounts[@]}"; do
  forced["$account"]=""
done
# The nominal audit account answers with this machine itself, so it carries no
# forced command; every other profile answers through the single script above.
forced["$audit_nominal"]=""
for account in "${audit_profiles[@]}"; do
  forced["$account"]="$forced_dir/audit-profile"
done

for account in "${accounts[@]}"; do
  useradd -m -s /bin/bash "$account"
  install -d -m 0700 -o "$account" -g "$account" "/home/$account/.ssh"
  command=${forced[$account]}
  : >"/home/$account/.ssh/authorized_keys"
  for identity in "$authorized_line" "$file_ed25519_line" "$file_rsa_line"; do
    if [[ -n "$command" ]]; then
      line="command=\"$command\",$restrictions $identity"
    else
      line="$restrictions $identity"
    fi
    printf '%s\n' "$line" >>"/home/$account/.ssh/authorized_keys"
  done
  chown "$account:$account" "/home/$account/.ssh/authorized_keys"
  chmod 0600 "/home/$account/.ssh/authorized_keys"
done

# The observation bridge reaches this machine as root, because the invariance
# proof reads /etc/shadow and the closure proof reads the journal.
#
# The three synthetic identities are authorised here too, and this is the whole
# of the root route's perimeter: an access lent as `root` is an ordinary key on
# root's own `authorized_keys`, and what makes it an access is the dedicated
# consent on the client, never anything the server does differently.
install -d -m 0700 /root/.ssh
touch /root/.ssh/authorized_keys
chmod 0600 /root/.ssh/authorized_keys
printf '%s %s\n' "$restrictions" "$observer_line" >>/root/.ssh/authorized_keys
for identity in "$authorized_line" "$file_ed25519_line" "$file_rsa_line"; do
  printf '%s %s\n' "$restrictions" "$identity" >>/root/.ssh/authorized_keys
done

# ------------------------------------------------------- the sudo perimeter
#
# One synthetic password, generated here and nowhere else, used by the two
# accounts whose policy really demands one. It never reaches a command line: it
# is written to the standard output of this script, which the harness turns into
# a file on the client, exactly as the key passphrase already is.
sudo_password_value=$(openssl rand -hex 20)
[[ ${#sudo_password_value} -eq 40 ]] \
  || { echo "the synthetic sudo password was not generated" >&2; exit 1; }
printf '%s:%s\n' "$sudo_password" "$sudo_password_value" | chpasswd

write_policy() {
  local account=$1 body=$2 file="/etc/sudoers.d/90-$prefix-$1"
  printf '%s\n' "$body" >"$file"
  chmod 0440 "$file"
  visudo -cqf "$file" || { echo "the policy of $account is not valid sudoers" >&2; exit 1; }
}

# The nominal password route: the listing is readable without a secret, running
# the action is not. It is the only shape in which this palier ever sends one.
write_policy "$sudo_password" "Defaults:$sudo_password listpw=never
$sudo_password ALL=(root) /usr/bin/id"

# The nominal passwordless route.
write_policy "$sudo_nopasswd" "$sudo_nopasswd ALL=(root) NOPASSWD: /usr/bin/id"

# La portée qu'une installation exige : toute commande. Elle n'est pas une
# version « plus permissive » des précédentes, c'est la seule forme sous
# laquelle un `dpkg` peut courir — et le contrat écrit pourquoi une liste
# nommant `dpkg` n'aurait pas été plus étroite en pouvoir réel.
write_policy "$sudo_every_command" "$sudo_every_command ALL=(root) NOPASSWD: ALL"

# A policy that cannot be described without first authenticating. It is
# deliberately the Debian default shape, and it is refused before any password
# exists.
write_policy "$sudo_unlistable" "$sudo_unlistable ALL=(root) /usr/bin/id"

# A policy that would write the standard input — the password — into the I/O
# log. Refused whatever else it authorises.
write_policy "$sudo_log_input" "Defaults:$sudo_log_input log_input
$sudo_log_input ALL=(root) NOPASSWD: /usr/bin/id"

# A policy that demands a terminal this session never allocates.
write_policy "$sudo_requiretty" "Defaults:$sudo_requiretty requiretty
$sudo_requiretty ALL=(root) NOPASSWD: /usr/bin/id"

# A policy that authorises another command entirely.
write_policy "$sudo_divergent" "$sudo_divergent ALL=(root) NOPASSWD: /usr/bin/true"

# Two entries, so which one applies is sudo's own ordering and not anything the
# client can observe.
write_policy "$sudo_ambiguous" "$sudo_ambiguous ALL=(root) NOPASSWD: /usr/bin/id
$sudo_ambiguous ALL=(root) NOPASSWD: /usr/bin/hostname"

# A listing far past the bound the client reads it under.
{
  printf 'Defaults:%s listpw=never\n' "$sudo_oversized"
  printf '%s ALL=(root) NOPASSWD: /usr/bin/id' "$sudo_oversized"
  for index in $(seq 200); do
    printf ', %s/pad-%03d-aaaaaaaaaaaaaaaaaaaaaaaa' "$forced_dir" "$index"
  done
  printf '\n'
} >"/etc/sudoers.d/90-$prefix-$sudo_oversized"
chmod 0440 "/etc/sudoers.d/90-$prefix-$sudo_oversized"
visudo -cqf "/etc/sudoers.d/90-$prefix-$sudo_oversized" \
  || { echo "the oversized policy is not valid sudoers" >&2; exit 1; }

# Each policy is confirmed against the very sudo that will answer the client,
# under the very locale the client fixes. A perimeter that does not behave as
# described is refused here rather than halfway through a proof.
listing_of() {
  su -s /bin/sh -c "LC_ALL=C /usr/bin/sudo -N -n -l -l" "$1" </dev/null 2>&1 || true
}
[[ "$(listing_of "$sudo_unlistable")" == *"a password is required"* ]] \
  || { echo "the unlistable policy can be listed after all" >&2; exit 1; }
[[ "$(listing_of "$sudo_requiretty")" == *"must have a tty"* ]] \
  || { echo "the requiretty policy does not demand a terminal" >&2; exit 1; }
[[ "$(listing_of "$sudo_nopasswd")" == *"!authenticate"* ]] \
  || { echo "the passwordless policy does not waive authentication" >&2; exit 1; }
[[ "$(listing_of "$sudo_password")" != *"!authenticate"* ]] \
  || { echo "the password policy waives authentication after all" >&2; exit 1; }
[[ "$(listing_of "$sudo_log_input")" == *"log_input"* ]] \
  || { echo "the log_input policy does not log its input" >&2; exit 1; }
[[ $(listing_of "$sudo_oversized" | wc -c) -gt "$bound" ]] \
  || { echo "the oversized listing fits inside the bound" >&2; exit 1; }

# The server's own account of a session closing is what the suite reads, and
# only a verbose journal writes it.
install -d -m 0755 /etc/ssh/sshd_config.d
printf 'LogLevel VERBOSE\n' >"$log_fragment"
systemctl restart ssh

# Three servers that negotiate outside the client's positive lists, each with
# one deviation and nothing else. They serve the same accounts as the nominal
# one: what is proven is the refusal at negotiation, before any account matters.
ssh-keygen -q -t ecdsa -b 256 -N '' -C "$prefix-hostile" -f "$hostile_key" <<<y >/dev/null 2>&1 \
  || { echo "the hostile ECDSA host key could not be generated" >&2; exit 1; }

start_instance() {
  local port=$1 name=$2 deviation=$3 config="/etc/ssh/sshd_config_$prefix-$2"
  cat >"$config" <<EOF
Port $port
ListenAddress 0.0.0.0
PidFile /run/sshd-$prefix-$name.pid
UsePAM no
PermitRootLogin no
PasswordAuthentication no
KbdInteractiveAuthentication no
AuthorizedKeysFile /home/%u/.ssh/authorized_keys
Subsystem sftp /usr/lib/openssh/sftp-server
LogLevel VERBOSE
$deviation
EOF
  /usr/sbin/sshd -f "$config" -E "/var/log/sshd-$prefix-$name.log"
}

start_instance "$ecdsa_port" ecdsa "HostKey $hostile_key
HostKeyAlgorithms ecdsa-sha2-nistp256
PubkeyAcceptedAlgorithms ssh-ed25519"
start_instance "$kex_port" kex "HostKey /etc/ssh/ssh_host_ed25519_key
KexAlgorithms diffie-hellman-group16-sha512"
start_instance "$cipher_port" cipher "HostKey /etc/ssh/ssh_host_ed25519_key
Ciphers aes128-ctr
MACs hmac-sha2-256"

# The canary. It deviates in nothing: same host key, same accounts, same
# algorithms as the nominal server. The only thing that separates it from the
# declared endpoint is that nobody ever declares it, so a connection in its
# journal can only come from something that went looking.
start_instance "$canary_port" canary "HostKey /etc/ssh/ssh_host_ed25519_key"

listening() {
  ss -tln | grep -qE "[:.]$1[[:space:]]"
}
for port in "$nominal_port" "$ecdsa_port" "$kex_port" "$cipher_port" "$canary_port"; do
  for _ in $(seq 50); do
    listening "$port" && break
    sleep 0.1
  done
  listening "$port" || { echo "no server listens on $port" >&2; exit 1; }
done

host_key=$(ssh-keygen -l -f /etc/ssh/ssh_host_ed25519_key.pub | awk '{print $2}')

printf 'PORT=%s\n' "$nominal_port"
printf 'USERNAME=%s\n' "$nominal"
printf 'HOST_KEY=%s\n' "$host_key"
printf 'UID=%s\n' "$(id -u "$nominal")"
printf 'OVERSIZED_STDOUT_USERNAME=%s\n' "$oversized_stdout"
printf 'OVERSIZED_STDERR_USERNAME=%s\n' "$oversized_stderr"
printf 'EXACT_BOUND_USERNAME=%s\n' "$exact_bound"
printf 'HELD_USERNAME=%s\n' "$held"
printf 'ECDSA_PORT=%s\n' "$ecdsa_port"
printf 'KEX_PORT=%s\n' "$kex_port"
printf 'CIPHER_PORT=%s\n' "$cipher_port"
printf 'SUDO_PASSWORD_USERNAME=%s\n' "$sudo_password"
printf 'SUDO_NOPASSWD_USERNAME=%s\n' "$sudo_nopasswd"
printf 'SUDO_EVERY_COMMAND_USERNAME=%s\n' "$sudo_every_command"
printf 'SUDO_UNLISTABLE_USERNAME=%s\n' "$sudo_unlistable"
printf 'SUDO_LOG_INPUT_USERNAME=%s\n' "$sudo_log_input"
printf 'SUDO_REQUIRETTY_USERNAME=%s\n' "$sudo_requiretty"
printf 'SUDO_DIVERGENT_USERNAME=%s\n' "$sudo_divergent"
printf 'SUDO_AMBIGUOUS_USERNAME=%s\n' "$sudo_ambiguous"
printf 'SUDO_OVERSIZED_USERNAME=%s\n' "$sudo_oversized"
printf 'SUDO_UID=%s\n' "$(id -u "$sudo_password")"
printf 'AUDIT_USERNAME=%s\n' "$audit_nominal"
printf 'AUDIT_UID=%s\n' "$(id -u "$audit_nominal")"
printf 'AUDIT_HOME=%s\n' "/home/$audit_nominal"
printf 'AUDIT_HOSTNAME=%s\n' "$(cat /etc/hostname)"
printf 'AUDIT_DISTRIBUTION_USERNAME=%s\n' "$audit_distribution"
printf 'AUDIT_ARCHITECTURE_USERNAME=%s\n' "$audit_architecture"
printf 'AUDIT_RESOURCES_USERNAME=%s\n' "$audit_resources"
printf 'AUDIT_FACILITY_USERNAME=%s\n' "$audit_facility"
printf 'AUDIT_INSTALLED_USERNAME=%s\n' "$audit_installed"
printf 'AUDIT_SILENT_USERNAME=%s\n' "$audit_silent"
printf 'CANARY_PORT=%s\n' "$canary_port"
printf 'CANARY_LOG=%s\n' "$canary_log"
# The only secret this script emits. The harness turns it into a file on the
# client and never writes it into the perimeter description, so no environment
# of any process the suite starts ever carries it.
printf 'SUDO_PASSWORD_VALUE=%s\n' "$sudo_password_value"
echo "INSTALL_SERVER_OK" >&2
