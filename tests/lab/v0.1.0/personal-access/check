#!/usr/bin/env bash
# Prove the Console crate still compiles against the synchronised sources.
set -euo pipefail

[[ $(id -u) -eq 0 ]] || { echo "check must run as root" >&2; exit 1; }

sources=/root/work/src-tauri
manifest_version=/root/work/package.json
toolchain=1.94.1
target=x86_64-unknown-linux-gnu
sidecar=your-cloud-native-bootstrap-assistant

[[ -d "$sources" ]] || { echo "no sources at $sources; synchronise them first" >&2; exit 1; }
# `tauri.conf.json` reads its version from `../package.json`. A synchronisation
# that forgot it is refused here rather than deep inside the build script.
[[ -f "$manifest_version" ]] \
  || { echo "no $manifest_version; synchronise the sources again" >&2; exit 1; }

# shellcheck source=/dev/null
. /root/.cargo/env
cd "$sources"

# One job everywhere: these machines hold about two gibibytes of memory.
export CARGO_BUILD_JOBS=1

# The external binary `tauri.conf.json` declares. It is built from the sources
# this run synchronised — never downloaded, never committed — and rebuilt every
# time, so the Console is never checked against a helper that no longer exists.
#
# It is built for the host rather than through `--target`, which would open a
# second target directory sharing nothing with the warm one: this machine has
# no room for two. The triple only names the file the build script looks for.
cargo "+$toolchain" build --locked --offline -j 1 \
  --no-default-features --package "$sidecar" --bin "$sidecar"

install -d -m 0755 binaries
install -m 0755 "target/debug/$sidecar" "binaries/$sidecar-$target"

cargo "+$toolchain" check --locked --offline -j 1 --package your-cloud-console
echo "CHECK_CONSOLE_OK"
