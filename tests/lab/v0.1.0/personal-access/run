#!/usr/bin/env bash
# Run the personal access contract suite against the mounted perimeter.
set -euo pipefail

[[ $(id -u) -eq 0 ]] || { echo "run must run as root" >&2; exit 1; }

state=/root/lab-personal-access
perimeter="$state/perimeter.env"
sources=/root/work/src-tauri
toolchain=1.94.1

[[ -f "$perimeter" ]] || { echo "no perimeter at $perimeter; mount it first" >&2; exit 1; }
[[ -d "$sources" ]] || { echo "no sources at $sources; synchronise them first" >&2; exit 1; }

# shellcheck source=/dev/null
. "$perimeter"
export SSH_AUTH_SOCK="$state/agent/agent.sock"
[[ -S "$SSH_AUTH_SOCK" ]] || { echo "the synthetic agent is not listening" >&2; exit 1; }
ssh-add -l >/dev/null || { echo "the synthetic agent holds nothing" >&2; exit 1; }

# Each run starts from no scratch, no recorded trust and no probe left behind
# by a previous one.
rm -rf "$YOUR_CLOUD_LAB_SCRATCH"
install -d -m 0700 "$YOUR_CLOUD_LAB_SCRATCH"
rm -f "$YOUR_CLOUD_LAB_KNOWN_HOSTS"
"$YOUR_CLOUD_LAB_SERVER_COMMAND" \
  "pkill -u $YOUR_CLOUD_LAB_HELD_USERNAME cat || true" >/dev/null 2>&1 || true

# shellcheck source=/dev/null
. /root/.cargo/env
cd "$sources"

# One job everywhere: these machines hold about two gibibytes of memory.
export CARGO_BUILD_JOBS=1
suite=(
  cargo "+$toolchain" test --locked -j 1
  -p your-cloud-native-bootstrap-assistant
  --features personal-access-contract-test
  --test personal-access-contract
)

# The suite proper, with no display at all: the client, the agent and the
# transport owe nothing to a graphical session, and running them without one is
# what says so.
"${suite[@]}" "$@" -- --test-threads=1

# The cases a display is the whole point of: a helper launched by the App's
# own supervisor, observed through the window it opens. `LC_ALL` is fixed
# because GTK writes on standard error under an unset locale, and the App
# forwards to the helper exactly the locale it holds itself.
#
# `-noreset` is what makes the display a fixture instead of a moving part, and
# it is not a convenience. An X server regenerates — frees every resource,
# recompiles its keymap, reloads its extensions — each time its client count
# falls back to zero, and on this pass that happens dozens of times: the only
# clients are the helpers under observation and the short-lived `xdotool` probes
# that observe them. A connection accepted in the same dispatch cycle as a
# pending regeneration is closed before its setup reply ever arrives, so
# `XOpenDisplay` answers nothing and the helper honestly reports a display it
# could not reach. That refusal is aimed at no one in particular: on this very
# session a stock `xdpyinfo`, with not a line of the App in it, is refused
# about three times in a hundred while an `xdotool` loop connects beside it, and
# never once when the generation is held. The screen geometry is repeated here
# because `--server-args` replaces the default rather than extending it.
LC_ALL=C.UTF-8 xvfb-run -a -s "-screen 0 1280x1024x24 -noreset" env NO_AT_BRIDGE=1 \
  "${suite[@]}" "$@" -- --ignored --test-threads=1
