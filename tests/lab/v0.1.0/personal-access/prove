#!/usr/bin/env bash
# Drive the personal access contract suite: mount, synchronise, run, remove.
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage: prove [setup | sync | check | run [filtre...] | remove | all [filtre...]]

  setup   mount the two-VM perimeter and write its description
  sync    copy the Console sources into lab-console, keeping its build cache
  check   prove the Console crate still compiles against those sources
  run     run the personal access contract suite against the mounted perimeter
  remove  remove the perimeter from both VM and prove its absence
  all     the five above in order, removing even when a step fails (default)
EOF
  exit 2
}

command=${1:-all}
[[ $# -eq 0 ]] || shift
case "$command" in
  setup | sync | check | run | remove | all) ;;
  *) usage ;;
esac
[[ $# -eq 0 || "$command" == run || "$command" == all ]] || usage

root=$(cd -- "$(dirname -- "$0")/../../../.." && pwd)
labctl="$root/tools/labctl"
harness="$root/tests/lab/v0.1.0/personal-access"
console_vm=lab-console
server_vm=lab-machine-1
expected_origin=your-cloud/labctl
remote_harness=/root/your-cloud-lab-personal-access
remote_state=/root/lab-personal-access
remote_sources=/root/work
workdir=$(mktemp -d)
trap 'rm -rf "$workdir"' EXIT

# Every name the suite reads from the environment. A perimeter that does not
# describe all of them is refused before anything is run.
required_names=(
  TARGET NAME PORT USERNAME HOST_KEY AUTHORIZED STRANGER UID KNOWN_HOSTS
  OVERSIZED_STDOUT_USERNAME OVERSIZED_STDERR_USERNAME EXACT_BOUND_USERNAME
  HELD_USERNAME ECDSA_PORT KEX_PORT CIPHER_PORT MANY_NAME SELF_NAME
  LOOPBACK_NAME HOSTS_FILE REBOUND_ADDRESS SERVER_COMMAND KEY_NEEDLE SCRATCH
  KEY_DIR KEY_PASSPHRASE KEY_SEED_NEEDLE KEY_ED25519_FINGERPRINT KEY_RSA_FINGERPRINT
  SUDO_PASSWORD_USERNAME SUDO_NOPASSWD_USERNAME SUDO_UNLISTABLE_USERNAME
  SUDO_LOG_INPUT_USERNAME SUDO_REQUIRETTY_USERNAME SUDO_DIVERGENT_USERNAME
  SUDO_AMBIGUOUS_USERNAME SUDO_OVERSIZED_USERNAME SUDO_EVERY_COMMAND_USERNAME
  SUDO_UID SUDO_PASSWORD
  ROOT_USERNAME
  AUDIT_USERNAME AUDIT_UID AUDIT_HOME AUDIT_HOSTNAME
  AUDIT_DISTRIBUTION_USERNAME AUDIT_ARCHITECTURE_USERNAME
  AUDIT_RESOURCES_USERNAME AUDIT_FACILITY_USERNAME AUDIT_INSTALLED_USERNAME
  AUDIT_SILENT_USERNAME CANARY_PORT CANARY_LOG
)

fail() { echo "FAILED: $*" >&2; exit 1; }

# The mandatory inventory guard: read the LAB before mutating any of it.
inventory() {
  local vm=$1 line state ips template topology origin
  line=$("$labctl" list --format=tsv | awk -v vm="$vm" -F'\t' '$1 == vm')
  [[ -n "$line" ]] || fail "$vm is not part of the LAB inventory"
  IFS=$'\t' read -r _ state ips template topology origin <<<"$line"
  [[ "$origin" == "$expected_origin" ]] || fail "$vm carries the origin $origin"
  [[ "$state" == running ]] || fail "$vm is $state"
  [[ "$topology" == quick ]] || fail "$vm belongs to the topology $topology"
  [[ "$ips" != *,* ]] || fail "$vm holds several addresses: $ips"
  [[ "$ips" != 192.168.122.123 && "$ips" != 10.66.66.1 ]] \
    || fail "$vm holds an address this project never mutates"
  echo "$ips"
}

# Install one script without touching whatever else the perimeter left there,
# so a subcommand may deploy what it needs on its own.
install_script() {
  local vm=$1 script=$2
  "$labctl" ssh "$vm" -- "install -d -m 0700 $remote_harness"
  "$labctl" copy-to "$vm" "$harness/$script" "$remote_harness/$script" >/dev/null
  "$labctl" ssh "$vm" -- "chmod 0700 $remote_harness/$script"
}

copy_harness() {
  local vm=$1 script
  shift
  "$labctl" ssh "$vm" -- "rm -rf $remote_harness"
  for script in "$@"; do
    install_script "$vm" "$script"
  done
}

setup() {
  local console_address server_address host_key_fingerprint declared
  console_address=$(inventory "$console_vm")
  server_address=$(inventory "$server_vm")
  echo "perimeter: client $console_vm, server $server_vm"

  copy_harness "$console_vm" install-client remove-client check run
  copy_harness "$server_vm" install-server remove-server

  # The server's real host key, read through the managed channel. It anchors
  # the observation bridge and is cross-checked against what the server itself
  # reports, so no side of this harness trusts a first answer.
  "$labctl" copy-from "$server_vm" /etc/ssh/ssh_host_ed25519_key.pub \
    "$workdir/server-host-key.pub" >/dev/null
  host_key_fingerprint=$(ssh-keygen -l -f "$workdir/server-host-key.pub" | awk '{print $2}')
  "$labctl" copy-to "$console_vm" "$workdir/server-host-key.pub" \
    "$remote_harness/server-host-key.pub" >/dev/null

  "$labctl" ssh "$console_vm" -- "$remote_harness/install-client" \
    "$server_address" "$console_address" "$remote_harness/server-host-key.pub" \
    >"$workdir/client.env"

  for key in authorized observer; do
    "$labctl" copy-from "$console_vm" "$remote_state/keys/$key.pub" \
      "$workdir/$key.pub" >/dev/null
    "$labctl" copy-to "$server_vm" "$workdir/$key.pub" \
      "$remote_harness/$key.pub" >/dev/null
  done
  # The two public keys of the encrypted files, so the fallback of #53
  # authenticates against the same synthetic accounts as the agent path.
  for key in ed25519 rsa3072; do
    "$labctl" copy-from "$console_vm" "$remote_state/keys/files/$key.pub" \
      "$workdir/file-$key.pub" >/dev/null
    "$labctl" copy-to "$server_vm" "$workdir/file-$key.pub" \
      "$remote_harness/file-$key.pub" >/dev/null
  done

  "$labctl" ssh "$server_vm" -- "$remote_harness/install-server" \
    "$remote_harness/authorized.pub" "$remote_harness/observer.pub" \
    "$remote_harness/file-ed25519.pub" "$remote_harness/file-rsa3072.pub" \
    >"$workdir/server.env"

  declared=$(awk -F= '$1 == "HOST_KEY" {print $2}' "$workdir/server.env")
  [[ "$declared" == "$host_key_fingerprint" ]] \
    || fail "the server announces the host key $declared, the LAB channel read $host_key_fingerprint"

  # The one synthetic secret the server generated. It becomes a file on the
  # client and never a value in the perimeter description: the suite reads it
  # from that path, exactly as it already reads the key passphrase, so no
  # environment of any process it starts ever carries the password itself.
  local sudo_password
  sudo_password=$(awk -F= '$1 == "SUDO_PASSWORD_VALUE" {print substr($0, 21)}' \
    "$workdir/server.env")
  [[ -n "$sudo_password" ]] || fail "the server never generated a synthetic sudo password"
  printf '%s' "$sudo_password" >"$workdir/sudo-password"
  chmod 0600 "$workdir/sudo-password"
  "$labctl" copy-to "$console_vm" "$workdir/sudo-password" \
    "$remote_state/needle/sudo-password" >/dev/null
  "$labctl" ssh "$console_vm" -- "chmod 0600 $remote_state/needle/sudo-password"

  {
    echo "TARGET=$server_address"
    # The root route authenticates as root itself: the account is not synthetic,
    # only the identity authorised on it is, and `remove-server` takes that
    # identity away again.
    echo "ROOT_USERNAME=root"
    echo "SUDO_PASSWORD=$remote_state/needle/sudo-password"
    cat "$workdir/client.env" "$workdir/server.env"
  } >"$workdir/values"
  : >"$workdir/perimeter.env"
  for name in "${required_names[@]}"; do
    local value
    value=$(awk -F= -v name="$name" '$1 == name {print substr($0, length(name) + 2)}' \
      "$workdir/values")
    [[ -n "$value" ]] || fail "the mounted perimeter never described $name"
    printf 'export YOUR_CLOUD_LAB_%s=%s\n' "$name" "$value" >>"$workdir/perimeter.env"
  done
  "$labctl" copy-to "$console_vm" "$workdir/perimeter.env" \
    "$remote_state/perimeter.env" >/dev/null
  echo "perimeter described by ${#required_names[@]} names"
}

sync() {
  # `package.json` travels with `src-tauri` because `tauri.conf.json` reads its
  # version from `../package.json`: without it the Console build script refuses
  # the workspace, and the guard that says the Console still compiles could only
  # ever be replayed by hand.
  #
  # The build cache of lab-console is deliberately preserved: rebuilding this
  # workspace from nothing costs far more than the copy it would replace.
  tar -C "$root/console" --exclude=target -czf "$workdir/console.tgz" \
    src-tauri package.json
  # The staging directory belongs to the perimeter, but synchronising sources
  # needs no perimeter: create it rather than depend on a previous `setup`.
  "$labctl" ssh "$console_vm" -- "install -d -m 0700 $remote_harness"
  "$labctl" copy-to "$console_vm" "$workdir/console.tgz" \
    "$remote_harness/console.tgz" >/dev/null
  "$labctl" ssh "$console_vm" -- "
set -e
install -d $remote_sources
rm -f $remote_sources/package.json
if [ -d $remote_sources/src-tauri ]; then
  find $remote_sources/src-tauri -mindepth 1 -maxdepth 1 ! -name target -exec rm -rf {} +
fi
# -m stamps every extracted file with the extraction time. Without it tar
# restores the workstation's timestamps, and a source older than the artefact
# already in the warm target/ lets Cargo skip the rebuild and rerun the previous
# binary: the pass would be green about code that was never compiled. The cost
# is a full rebuild after each synchronisation, which is the price of a run
# that provably tests what was just sent.
tar -C $remote_sources -xzmf $remote_harness/console.tgz
rm -f $remote_harness/console.tgz"
  echo "sources synchronised into $console_vm:$remote_sources"
}

# The Console crate compiles against the sources this run synchronised. It is
# its own subcommand rather than a step of `run`: it owes nothing to the mounted
# perimeter, it fails for its own reason, and either one must stay replayable
# without paying for the other. `all` runs it first, so a protocol change that
# breaks the Console is seen before the suite is paid for.
check() {
  install_script "$console_vm" check
  "$labctl" ssh "$console_vm" -- "$remote_harness/check"
}

run_suite() {
  "$labctl" ssh "$console_vm" -- "$remote_harness/run" "$@"
}

remove() {
  local status=0
  "$labctl" ssh "$server_vm" -- "$remote_harness/remove-server" || status=1
  "$labctl" ssh "$console_vm" -- "$remote_harness/remove-client" || status=1
  "$labctl" ssh "$server_vm" -- "rm -rf $remote_harness" || status=1
  "$labctl" ssh "$console_vm" -- "rm -rf $remote_harness" || status=1
  [[ $status -eq 0 ]] || fail "the perimeter removal is not proven"
  echo "perimeter removed from both machines"
}

case "$command" in
  setup) setup ;;
  sync) sync ;;
  check) check ;;
  run) run_suite "$@" ;;
  remove) remove ;;
  all)
    setup
    sync
    status=0
    check || status=$?
    if [[ $status -eq 0 ]]; then
      run_suite "$@" || status=$?
    fi
    remove
    [[ $status -eq 0 ]] || fail "the personal access proof failed with $status"
    echo "PROVE_PERSONAL_ACCESS_OK"
    ;;
esac
