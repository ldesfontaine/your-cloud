#!/usr/bin/env bash
# Remove the synthetic server side of the personal access perimeter.
set -euo pipefail

[[ $# -eq 0 ]] || { echo "usage: remove-server" >&2; exit 2; }
[[ $(id -u) -eq 0 ]] || { echo "remove-server must run as root" >&2; exit 1; }

prefix=ycpa
forced_dir=/usr/local/lib/your-cloud-lab-personal-access
log_fragment=/etc/ssh/sshd_config.d/$prefix-log.conf
hostile_key=/etc/ssh/${prefix}_hostile_ecdsa_key
accounts=(
  ${prefix}nom ${prefix}out ${prefix}err ${prefix}fit ${prefix}hold
  ${prefix}sudp ${prefix}sudn ${prefix}sudx ${prefix}sudl
  ${prefix}sudt ${prefix}sudd ${prefix}suda ${prefix}sudb ${prefix}sude
  ${prefix}sudg
  ${prefix}audn ${prefix}audd ${prefix}auda ${prefix}audr
  ${prefix}audf ${prefix}audi ${prefix}auds
)
failures=0

# Every synthetic sudo policy this perimeter wrote, and its synthetic password
# with the account that held it.
rm -f /etc/sudoers.d/90-$prefix-*

for account in "${accounts[@]}"; do
  if id -u "$account" >/dev/null 2>&1; then
    pkill -9 -u "$account" 2>/dev/null || true
    sleep 1
    userdel -r "$account" 2>/dev/null || true
  fi
done

pkill -f "sshd_config_$prefix-" 2>/dev/null || true
sleep 1
# Every deviating instance this perimeter started, the canary included.
rm -f "/etc/ssh/sshd_config_$prefix-"*
rm -f /var/log/sshd-$prefix-*.log /run/sshd-$prefix-*.pid
rm -f "$hostile_key" "$hostile_key.pub"
rm -rf "$forced_dir"

# The journal verbosity and the observation identity are the two mutations this
# perimeter made outside its own files.
rm -f "$log_fragment"
systemctl restart ssh
# The observation identity and the three the root route authenticates with all
# carry this perimeter's prefix in their comment, and nothing else on this
# machine does.
if [[ -f /root/.ssh/authorized_keys ]]; then
  sed -i "/$prefix-/d" /root/.ssh/authorized_keys
  [[ -s /root/.ssh/authorized_keys ]] || rm -f /root/.ssh/authorized_keys
fi

# A removal that cannot prove the absence is a failure, not a warning.
for account in "${accounts[@]}"; do
  if id -u "$account" >/dev/null 2>&1; then
    echo "account still present: $account" >&2
    failures=$((failures + 1))
  fi
done
if pgrep -f "sshd_config_$prefix-" >/dev/null; then
  echo "a hostile server is still running" >&2
  failures=$((failures + 1))
fi
if compgen -G "/etc/ssh/sshd_config_$prefix-*" >/dev/null; then
  echo "a deviating server configuration is still present" >&2
  failures=$((failures + 1))
fi
for path in "$forced_dir" "$log_fragment" "$hostile_key"; do
  if [[ -e "$path" ]]; then
    echo "residue still present: $path" >&2
    failures=$((failures + 1))
  fi
done
if [[ -f /root/.ssh/authorized_keys ]] && grep -q "$prefix-" /root/.ssh/authorized_keys; then
  echo "a synthetic identity is still authorised on root" >&2
  failures=$((failures + 1))
fi
if compgen -G "/etc/sudoers.d/90-$prefix-*" >/dev/null; then
  echo "a synthetic sudo policy is still present" >&2
  failures=$((failures + 1))
fi

[[ $failures -eq 0 ]] || exit 1
echo "REMOVE_SERVER_OK" >&2
