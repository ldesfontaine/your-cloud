#!/usr/bin/env bash
# Prove that the Console frontend reflows without cutting anything, at both
# contractual window sizes, with the text at 100 % and at 200 %, on labels a
# hostile Controller could really send. Issue #56, contract
# `docs/objectifs/v1/CONTRAT-V0.0.3.md`.
#
# What it drives is the shipped frontend bundle — the same React tree, the same
# stylesheets, the same fonts — with exactly one module replaced: the Tauri IPC
# bridge. It runs in `lab-console`, in WebKitGTK, which is the engine the Linux
# Console paints with, on a virtual screen.
#
# What it does not drive is the installed `.deb`. Eight of the eleven states measured
# here are only reachable behind an unlocked vault and a live Controller, and
# standing that chain up to measure a stylesheet would make the measurement
# depend on everything except the stylesheet. The engine, the bundle and the
# window sizes are the product's; the process that hosts them is not. The
# installed-binary captures stay the hosted gate's job, and the Windows half of
# #56 stays open.
set -euo pipefail
export LC_ALL=C.UTF-8

usage() {
  cat >&2 <<'EOF'
usage: prove [setup | run | collect | remove | all]

  setup    build the fixture bundle and place the harness on lab-console
  run      drive the eleven states at both sizes and both text sizes
  collect  bring the captures and the structured result back
  remove   leave the machine as the harness found it
  all      the four above, then publish the report (default)

The machine must already exist, be running and be provisioned:

  tools/labctl topology create quick
  tools/provision-lab lab-console
EOF
  exit 2
}

command=${1:-all}
[[ $# -le 1 ]] || usage
case "$command" in
  setup | run | collect | remove | all) ;;
  *) usage ;;
esac

root=$(cd -- "$(dirname -- "$0")/../../../.." && pwd)
harness=$(cd -- "$(dirname -- "$0")" && pwd)
labctl="$root/tools/labctl"
target_vm=lab-console
expected_origin=your-cloud/labctl
remote_harness=/root/your-cloud-lab-console-reflow
result_root="$root/tests/artifacts/proofs/console-reflow"
run_id=$(date -u +%Y%m%dT%H%M%SZ)-$$
workdir=$(mktemp -d)
trap 'rm -rf "$workdir"' EXIT

fail() { echo "FAILED: $*" >&2; exit 1; }
announce() { printf '\n==> %s\n' "$*"; }

# The revision the artefacts belong to. A dirty tree is named as dirty rather
# than passed off as the commit it sits on.
revision() {
  local head dirty=
  head=$(cd "$root" && git rev-parse HEAD)
  if ! (cd "$root" && git diff --quiet) \
    || ! (cd "$root" && git diff --cached --quiet) \
    || [[ -n "$(cd "$root" && git ls-files --others --exclude-standard)" ]]; then
    dirty=+worktree
  fi
  printf '%s%s' "$head" "$dirty"
}

# The mandatory inventory guard: read the LAB before mutating any of it.
inventory() {
  local vm=$1 line state ips template topology origin
  line=$("$labctl" list --format=tsv | awk -v vm="$vm" -F'\t' '$1 == vm')
  [[ -n "$line" ]] || fail "$vm is not part of the LAB inventory"
  IFS=$'\t' read -r _ state ips template topology origin <<<"$line"
  [[ "$origin" == "$expected_origin" ]] || fail "$vm carries the origin $origin"
  [[ "$state" == running ]] || fail "$vm is $state"
  [[ "$topology" == quick ]] || fail "$vm belongs to the topology $topology"
  [[ "$ips" != *,* ]] || fail "$vm holds several addresses: $ips"
  [[ "$ips" != 192.168.122.123 && "$ips" != 10.66.66.1 ]] \
    || fail "$vm holds an address this project never mutates"
  echo "$ips"
}

on_machine() { "$labctl" ssh "$target_vm" -- "$*"; }

setup() {
  announce "lab-console — $(inventory "$target_vm")"

  announce "building the fixture bundle from the working tree"
  (cd "$root/console" && npm run --silent build:reflow-fixture)
  [[ -f "$root/console/dist-reflow/index.html" ]] || fail "the fixture bundle was not produced"

  announce "placing the harness on $target_vm"
  on_machine "rm -rf $remote_harness && install -d -m 0700 $remote_harness"
  local script
  for script in inside run remove reflow-oracle.py; do
    "$labctl" copy-to "$target_vm" "$harness/$script" "$remote_harness/$script" >/dev/null
    on_machine "chmod 0700 $remote_harness/$script"
  done
  tar czf "$workdir/bundle.tgz" -C "$root/console/dist-reflow" .
  "$labctl" copy-to "$target_vm" "$workdir/bundle.tgz" "$remote_harness/bundle.tgz" >/dev/null
  on_machine "install -d -m 0755 $remote_harness/bundle \
    && tar xzf $remote_harness/bundle.tgz -C $remote_harness/bundle \
    && rm -f $remote_harness/bundle.tgz"
  echo "  bundle placed: $(on_machine "find $remote_harness/bundle -type f | wc -l") files"
}

run_oracle() {
  announce "measuring eleven states at 1280x800 and 640x560, text 100 % and 200 %"
  on_machine "$remote_harness/run '$(revision)' '$run_id'"
}

collect() {
  announce "collecting the captures and the structured result"
  install -d -m 0755 "$workdir/output"
  "$labctl" copy-from "$target_vm" "$remote_harness/output" "$workdir/collected" >/dev/null
  local produced="$workdir/collected"
  [[ -d "$produced" ]] || produced="$workdir/collected/output"
  [[ -f "$produced/reflow-result.json" ]] || fail "no structured result came back"
  install -d -m 0755 "$result_root/$run_id"
  cp -a "$produced/." "$result_root/$run_id/"
  chmod -R u+rw "$result_root/$run_id"
  echo "  captures: $(find "$result_root/$run_id" -name '*.png' | wc -l)"
  echo "  result:   $result_root/$run_id/reflow-result.json"
}

publish() {
  local status=$1 log=$2 directory="$result_root/$run_id"
  install -d -m 0755 "$directory"
  {
    echo "proof: console-reflow"
    echo "issue: #56"
    echo "contract: docs/objectifs/v1/CONTRAT-V0.0.3.md"
    echo "run: $run_id"
    echo "revision: $(revision)"
    echo "machine: $target_vm (WebKitGTK on Xvfb)"
    echo "outcome: $([[ $status -eq 0 ]] && echo pass || echo red)"
    echo "finished_at: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    cat <<'DEBTS'

what this proof does not claim, whatever its outcome:
  - it measures the frontend bundle in WebKitGTK, not the installed `.deb`
    running under Tauri. The engine and the stylesheets are the product's; the
    process that hosts them is not;
  - it says nothing about Windows. The same measurement under WebView2 on the
    `windows-eval` machine is the other half of #56 and is not run here;
  - it measures reflow, clipping, overlap, reachability, keyboard order and
    focus visibility. It is not a claim of WCAG 2.2 AA conformance;
  - the labels it exercises are hostile by construction, not exhaustive. A
    Controller can always send a string no fixture anticipated.

DEBTS
    sed -e "s#$root#<repo>#g" -e "s#$HOME#<home>#g" -e "s#$(id -un)#<user>#g" "$log"
  } >"$directory/report.txt"
  chmod 0644 "$directory/report.txt"
  printf '\nreport=%s\n' "$directory/report.txt"
}

play() {
  setup || return $?
  run_oracle || return $?
  return 0
}

case "$command" in
  setup) setup ;;
  run) run_oracle ;;
  collect) collect ;;
  remove) on_machine "$remote_harness/remove" ;;
  all)
    # The verdict must survive the pipe: a proof whose status is lost to `tee`
    # is a proof that always passes.
    set +e
    play 2>&1 | tee "$workdir/run.log"
    status=${PIPESTATUS[0]}
    set -e
    collect 2>&1 | tee -a "$workdir/run.log" || status=${status:-1}
    # Removal always runs, red or green: a harness left behind is a machine that
    # lies to the next proof.
    on_machine "$remote_harness/remove" 2>&1 | tee -a "$workdir/run.log" || true
    publish "$status" "$workdir/run.log"
    exit "$status"
    ;;
esac
