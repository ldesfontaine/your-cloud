#!/usr/bin/env bash
# Drive the controlled OCI plan proof: mount, run the machine's own suite as
# root, play the palier, power cycle the machine for real, play what a reboot
# must have carried, then remove the perimeter and prove its absence.
#
# One VM plays every role this palier separates, and that is honest rather than
# convenient: the Controller and the Console are a synthetic fixture here — the
# Console window is not wired to this proof — while the Auxiliary is the real
# product binary, built from the synchronised sources, running as root against
# a real systemd, a real rootless Podman and a real registry. What this harness
# proves is therefore what the machine does with documents it did not write.
#
# The reboot is a real power cycle through the LAB controller, because the
# property under proof is that lingering carries an approved state across one,
# and a process restart does not exercise that.
set -euo pipefail
export LC_ALL=C.UTF-8

usage() {
  cat >&2 <<'EOF'
usage: prove [setup | unit | run | reboot | verify | remove | all]

  setup   synchronise the sources, build the binary and the fixture, mount the
          anchor and the empty anti-replay position
  unit    the product's own suite, on the machine and as root, so the checks
          gated on real root authority count for once
  run     the palier up to the power cycle: capability, deployment, idempotence,
          replay and the hostile documents
  reboot  really stop and start the target machine through the LAB controller
  verify  what the reboot carried, the controlled failure, the cut, the removal
  remove  remove the perimeter and prove its absence
  all     the six above in order, removing even when a step fails (default)

This harness belongs to the palier of the controlled OCI plan (#14, proof #86)
and is deliberately not one of the passes of tests/lab/v0.1.0/prove, whose
sequence is the bootstrap and replacement palier (#13, proof #41). It mounts and
removes its own perimeter on lab-machine-1 and creates no topology.
EOF
  exit 2
}

command=${1:-all}
[[ $# -le 1 ]] || usage
case "$command" in
  setup | unit | run | reboot | verify | remove | all) ;;
  *) usage ;;
esac

root=$(cd -- "$(dirname -- "$0")/../../../.." && pwd)
labctl="$root/tools/labctl"
harness="$root/tests/lab/v0.1.0/oci-plan"
target_vm=lab-machine-1
expected_origin=your-cloud/labctl
remote_harness=/root/your-cloud-lab-oci-plan
remote_sources=/root/lab-oci-plan-sources
result_root="$root/tests/artifacts/proofs/oci-plan"
run_id=$(date -u +%Y%m%dT%H%M%SZ)-$$
workdir=$(mktemp -d)
trap 'rm -rf "$workdir"' EXIT

fail() {
  echo "FAILED: $*" >&2
  exit 1
}

# The mandatory inventory guard: read the LAB before mutating any of it.
inventory() {
  local vm=$1 line state ips template topology origin
  line=$("$labctl" list --format=tsv | awk -v vm="$vm" -F'\t' '$1 == vm')
  [[ -n "$line" ]] || fail "$vm is not part of the LAB inventory"
  IFS=$'\t' read -r _ state ips template topology origin <<<"$line"
  [[ "$origin" == "$expected_origin" ]] || fail "$vm carries the origin $origin"
  [[ "$state" == running ]] || fail "$vm is $state"
  [[ "$topology" == quick ]] || fail "$vm belongs to the topology $topology"
  [[ "$ips" != *,* ]] || fail "$vm holds several addresses: $ips"
  [[ "$ips" != 192.168.122.123 && "$ips" != 10.66.66.1 ]] \
    || fail "$vm holds an address this project never mutates"
  echo "$ips"
}

# The revision is named once and honestly. A modified tree is announced as such,
# because a report built on a state nobody can fetch closes no line of a palier.
revision() {
  local sha
  sha=$(git -C "$root" rev-parse HEAD)
  if ! git -C "$root" diff --quiet \
    || ! git -C "$root" diff --cached --quiet \
    || [[ -n $(git -C "$root" ls-files --others --exclude-standard) ]]; then
    sha="$sha+worktree"
  fi
  echo "$sha"
}

setup() {
  local address
  address=$(inventory "$target_vm")
  echo "perimeter: target $target_vm at $address, revision $(revision)"

  "$labctl" ssh "$target_vm" -- "rm -rf $remote_harness && install -d -m 0700 $remote_harness"
  for script in common install run-before run-after remove; do
    "$labctl" copy-to "$target_vm" "$harness/$script" "$remote_harness/$script" >/dev/null
    "$labctl" ssh "$target_vm" -- "chmod 0700 $remote_harness/$script"
  done

  # The product sources this run proves, and the synthetic fixture that stands
  # in for the Controller and the Console. The fixture is placed *inside* the
  # module because it asks internal/plan for the canonical plan documents; it
  # exists only in this copy and is never a package of the product.
  tar czf "$workdir/sources.tgz" -C "$root" go.mod go.sum cmd internal
  "$labctl" copy-to "$target_vm" "$workdir/sources.tgz" /root/lab-oci-plan-sources.tgz >/dev/null
  "$labctl" copy-to "$target_vm" "$harness/_fixture/main.go" /root/lab-oci-fixture-main.go >/dev/null
  "$labctl" ssh "$target_vm" -- \
    "rm -rf $remote_sources && install -d -m 0700 $remote_sources \
     && tar xzf /root/lab-oci-plan-sources.tgz -C $remote_sources \
     && install -d -m 0700 $remote_sources/labfixture \
     && mv /root/lab-oci-fixture-main.go $remote_sources/labfixture/main.go \
     && rm -f /root/lab-oci-plan-sources.tgz"

  "$labctl" ssh "$target_vm" -- \
    "export PATH=\$PATH:/usr/local/go/bin && $remote_harness/install $remote_sources"
}

unit() {
  # #85 closed with a debt: its root-gated checks — a spent sequence still
  # refused after a cut, a half-written state neither repaired nor resumed —
  # only count when the package is run by a real root. This is where that
  # happens, and it is the only reason this step exists in a LAB harness.
  echo "== the product's own suite, on the machine it runs on, as root =="
  "$labctl" ssh "$target_vm" -- \
    "export PATH=\$PATH:/usr/local/go/bin && cd $remote_sources \
     && test -z \"\$(LC_ALL=C.UTF-8 gofmt -l .)\" && LC_ALL=C.UTF-8 go vet ./... \
     && LC_ALL=C.UTF-8 go test -mod=readonly -count=1 ./..."
}

reboot_target() {
  local attempt
  echo "== real power cycle of $target_vm =="
  "$labctl" stop "$target_vm"
  "$labctl" start "$target_vm"
  inventory "$target_vm" >/dev/null
  # The controller returns as soon as the machine holds an address; its own
  # channel opens a little later. Waiting here rather than in the assertions
  # keeps a slow boot from reading as a failed reboot.
  for attempt in $(seq 1 120); do
    if "$labctl" ssh "$target_vm" -- true >/dev/null 2>&1; then
      echo "the machine answers again after ${attempt}s"
      return 0
    fi
    sleep 1
  done
  fail "$target_vm never answered after its power cycle"
}

# play is the whole sequence, in order, first red kept. It never stops before
# the removal: a machine left holding an anchor, a spent position, a lingering
# account and a running container is not a clean LAB, whatever failed above.
play() {
  local status=0
  setup || status=$?
  if [[ $status -eq 0 ]]; then unit || status=$?; fi
  if [[ $status -eq 0 ]]; then
    "$labctl" ssh "$target_vm" -- "$remote_harness/run-before" || status=$?
  fi
  if [[ $status -eq 0 ]]; then reboot_target || status=$?; fi
  if [[ $status -eq 0 ]]; then
    "$labctl" ssh "$target_vm" -- "$remote_harness/run-after" || status=$?
  fi
  # The removal's own verdict is kept: a teardown that could not prove absence
  # is a red of its own, not a footnote of the step that preceded it.
  "$labctl" ssh "$target_vm" -- "$remote_harness/remove" || status=$?
  "$labctl" ssh "$target_vm" -- "rm -rf $remote_harness" || true
  return "$status"
}

# publish writes the run's report where a proof output belongs, naming the exact
# tree it judged. It carries no address, no key and no secret: the LAB material
# is synthetic by construction and the pilot's own paths are removed.
publish() {
  local status=$1 log=$2 directory="$result_root/$run_id"
  install -d -m 0755 "$directory"
  {
    printf 'proof: your-cloud controlled OCI plan (palier #14, issue #86)\n'
    printf 'run: %s\n' "$run_id"
    printf 'revision: %s\n' "$(revision)"
    printf 'target: %s (topology quick)\n' "$target_vm"
    printf 'outcome: %s\n' "$([[ $status -eq 0 ]] && echo passed || echo failed)"
    printf 'finished_at: %s\n\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    sed -e "s#$root#<repo>#g" -e "s#$HOME#<home>#g" -e "s#$(id -un)#<user>#g" "$log"
  } >"$directory/report.txt"
  chmod 0644 "$directory/report.txt"
  printf '\nreport=%s\n' "$directory/report.txt"
}

case "$command" in
  setup) setup ;;
  unit) unit ;;
  run) "$labctl" ssh "$target_vm" -- "$remote_harness/run-before" ;;
  reboot) reboot_target ;;
  verify) "$labctl" ssh "$target_vm" -- "$remote_harness/run-after" ;;
  remove) "$labctl" ssh "$target_vm" -- "$remote_harness/remove" ;;
  all)
    # The raw stream is kept live so a long run can be watched, then published.
    # The status is read from PIPESTATUS rather than from the pipeline, because
    # the left-hand side of a pipe runs in a subshell and no assignment made
    # there survives it — a proof whose verdict is lost to a pipe is a proof
    # that always passes.
    set +e
    play 2>&1 | tee "$workdir/run.log"
    status=${PIPESTATUS[0]}
    set -e
    publish "$status" "$workdir/run.log"
    exit "$status"
    ;;
esac
