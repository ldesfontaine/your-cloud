failures=0

report() { printf '%-72s %s\n' "$1" "$2"; }
red() {
  report "$1" "FAILED: $2"
  failures=$((failures + 1))
}
step() { printf '\n== %s ==\n' "$*"; }

# defect names something the machine does that the product did not intend, in
# full, and lets the rest of the palier run. It deliberately does not count as a
# failed assertion: a defect stops its own path and everything the palier can
# still constate is still constated. The run does not pass — `prove` reads these
# markers out of the log and reports the outcome as failed whatever the assertion
# count is.
defects=0
defect() {
  defects=$((defects + 1))
  printf '\n!! PRODUCT DEFECT: %s\n' "$1"
  printf '%s\n' "$2" | sed -e 's/^/   /'
  printf '\n'
}

divergences=0
divergence() {
  divergences=$((divergences + 1))
  printf '\n!! DIVERGENCE %d: %s\n   %s\n\n' "$divergences" "$1" "$2"
}

# limit names something this step deliberately does not claim, so that a reader of
# the log meets the boundary at the place it applies rather than only in the
# report's list of debts.
limit() { printf '\n!! LIMIT: %s\n   %s\n\n' "$1" "$2"; }

verdict() {
  [[ $failures -eq 0 ]] || {
    echo "FAILED: $failures assertions" >&2
    exit 1
  }
  if [[ $defects -gt 0 ]]; then
    echo "PASS with $defects product defect(s) reported above: $1"
  else
    echo "PASS: $1"
  fi
}

expect() {
  local label=$1 observed=$2 expected=$3
  if [[ "$observed" == "$expected" ]]; then
    report "$label" "$expected"
  else
    red "$label" "expected [$expected], observed [$observed]"
  fi
}

