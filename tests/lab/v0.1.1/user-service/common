# user_service_homes is the reading the product itself performs to find the third
# door: the homes under /var/lib whose name opens on the account prefix. It is
# spelled once here so that "this machine runs no user service" and "it runs
# exactly these" are the same question asked twice.
user_service_homes() {
  local names
  names=$(find /var/lib -maxdepth 1 -name "${user_account_prefix}*" -printf '%f\n' 2>/dev/null \
    | sort | paste -sd, -)
  echo "${names:-none}"
}

account_uid() { id -u "$1" 2>/dev/null || echo none; }

subordinate_range() { grep "^$1:" /etc/subuid 2>/dev/null || echo none; }

# as_account runs one command under a service account, with exactly the
# environment the Auxiliary builds for its own calls. The working directory is `/`
# because a rootless Podman re-executes itself into a user namespace and chdir()s
# to the directory it inherited.
as_account() {
  local account=$1 uid
  shift
  uid=$(id -u "$account" 2>/dev/null) || return 1
  cd / && runuser -u "$account" -- env \
    PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    HOME="/var/lib/$account" \
    USER="$account" \
    XDG_RUNTIME_DIR="/run/user/$uid" \
    DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
    "$@"
}

service_state() {
  local account=$1 service=$2
  id -u "$account" >/dev/null 2>&1 || {
    echo no-account
    return
  }
  as_account "$account" systemctl --user is-active "$service" 2>/dev/null || true
}

service_property() {
  local account=$1 service=$2 property=$3
  id -u "$account" >/dev/null 2>&1 || {
