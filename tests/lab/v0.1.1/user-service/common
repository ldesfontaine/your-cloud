# app_content_digest is the one durable file this proof damages and returns from,
# and app_boots is the one that a start legitimately grows.
#
# They are read apart from volumes_state on purpose. Every operation that stops
# and starts this service — an archive, a return, a redeployment — appends a line
# to the boot log, because that is what the application was written to do: it is
# how "a new container in front of the very same bytes" is visible at all. So a
# constat about what survived compares the content, and a constat about what ran
# reads the count; comparing the whole tree across a restart would be asserting
# that the service did not start.
app_content_digest() { file_digest "$app_volumes$app_content_volume/content.txt"; }

app_boots() { wc -l <"$app_volumes$app_state_volume/boots.log" 2>/dev/null || echo 0; }

# volumes_state is every durable byte of the user service, in one line, so that a
# later constat is a comparison against something recorded earlier rather than a
# fresh judgement. It is the right reading exactly where nothing restarted in
# between.
volumes_state() {
  { cd "$app_volumes" && find . -type f -printf '%P\n' | sort | while read -r file; do
    printf '%s:%s ' "$file" "$(sha256sum "$file" | cut -d' ' -f1)"
  done; } 2>/dev/null
  printf '\n'
}

