      entryPoints:
        - websecure
      service: "$host"
      tls: {}
  services:
    "$host":
      loadBalancer:
        servers:
          - url: "http://$link_initiator_address:$port"
tls:
  certificates:
    - certFile: "$entry_certificates/$host.crt"
      keyFile: "$entry_certificates/$host.key"
EOF
}

expected_netdev() {
  local peer_key=${1:-} endpoint=${2:-}
  product_header
  printf '[NetDev]\nName=%s\nKind=wireguard\nDescription=Your Cloud private passage (%s)\n\n' \
    "$link_interface" "$link_role"
  printf '[WireGuard]\nPrivateKeyFile=%s\n' "$link_key"
  [[ "$link_role" == listener ]] && printf 'ListenPort=%d\n' "$link_listen_port"
  [[ -n "$peer_key" ]] || return 0
  printf '\n[WireGuardPeer]\nPublicKey=%s\nAllowedIPs=%s/32\n' "$peer_key" "$link_peer_address"
  [[ "$link_role" == initiator ]] \
    && printf 'Endpoint=%s:%d\nPersistentKeepalive=25\n' "$endpoint" "$link_listen_port"
  return 0
}

expected_network() {
  product_header
  printf '[Match]\nName=%s\n\n[Network]\nAddress=%s/32\n' "$link_interface" "$link_own_address"
  [[ -n "${1:-}" ]] || return 0
  printf '\n[Route]\nDestination=%s/32\nScope=link\n' "$link_peer_address"
  return 0
}

matches_bytes() {
  local label=$1 path=$2 expected=$3 observed
  if [[ ! -f "$path" ]]; then
    red "$label" "$path is absent"
    return
  fi
  observed=$(cat "$path")
  if [[ "$observed" == "$expected" ]]; then
    report "$label" "$(wc -c <"$path") bytes, identical to the contract's"
  else
    red "$label" "$(diff <(printf '%s\n' "$expected") "$path" | tr '\n' '|')"
  fi
}

# --- the fingerprint --------------------------------------------------------
#
# Everything an operation of this palier could have changed on this machine, read
# in one place so that "zero effect" is a comparison and never a claim.

fingerprint() {
  case "$role" in
    lan)
      printf 'vault-account=%s vault-sheet=%s vault-service=%s vault-invocation=%s ' \
        "$(account_state "$vault_account")" "$(file_digest "$vault_unit")" \
        "$(service_state "$vault_account" "$vault_service")" \
        "$(service_property "$vault_account" "$vault_service" InvocationID)"
      printf 'app-account=%s app-sheet=%s app-service=%s app-invocation=%s app-image=%s ' \
        "$(account_state "$app_account")" "$(file_digest "$app_unit")" \
        "$(service_state "$app_account" "$app_service")" \
        "$(service_property "$app_account" "$app_service" InvocationID)" \
        "$(container_image "$app_account" "$app_container")"
      printf 'volumes=%s archives=[%s] secrets=%s/%s envfile=%s ' \
        "$(present "$app_volumes")" "$(archive_slots "$app_snapshots")" \
        "$(present "$app_secrets")" "$(file_owner "$app_secrets")" \
        "$(file_digest "$app_environment_file")"
      ;;
    vps)
      printf 'edge-account=%s edge-sheet=%s edge-service=%s edge-invocation=%s edge-image=%s ' \
        "$(account_state "$edge_account")" "$(file_digest "$edge_unit")" \
        "$(service_state "$edge_account" "$edge_service")" \
        "$(service_property "$edge_account" "$edge_service" InvocationID)" \
        "$(container_image "$edge_account" "$edge_container")"
      printf 'entry-sheet=%s entry-config=%s entry-service=%s entry-invocation=%s fragments=%s policy=%s sysctl=%s ports=%s/%s ' \
        "$(file_digest "$entry_unit")" "$(file_digest "$entry_configuration")" \
        "$(service_state "$entry_account" "$entry_service")" \
        "$(service_property "$entry_account" "$entry_service" InvocationID)" \
        "$(published_fragments)" "$(file_digest "$host_ports_policy")" \
        "$(host_ports_value)" "$(port_listening 443)" "$(port_listening 80)"
      ;;
  esac
  printf 'egress-rules=%s egress-unit=%s/%s egress-table=%s ' \
    "$(file_digest "$egress_rules")" "$(file_digest "$egress_unit")" \
    "$(unit_enabled "$egress_unit_name")" "$(egress_table_loaded)"
  printf 'key=%s netdev=%s network=%s iface=%s/%s peers=%s link-rules=%s link-table=%s tables=[%s]\n' \
    "$(present "$link_key")" "$(file_digest "$link_netdev")" "$(file_digest "$link_network")" \
    "$(interface_state)" "$(interface_index)" "$(wg_peers)" \
    "$(file_digest "$link_rules")" "$(link_table_loaded)" "$(nft_tables)"
}

unchanged() {
  local label=$1 before=$2 after
  after=$(fingerprint)
  if [[ "$before" == "$after" ]]; then
    report "$label" "zero effect"
  else
    red "$label" "the machine changed: before [$before] after [$after]"
  fi
}

# --- the approval channel ---------------------------------------------------

consumed_sequence() {
  [[ -f "$replay" ]] || {
    echo 0
    return
  }
  sed -n 's/.*"consumed_sequence":\([0-9]*\).*/\1/p' "$replay"
}

next_sequence() { echo $(($(consumed_sequence) + 1)); }

machine_id() { sed -n 's/.*"machine_id":"\([^"]*\)".*/\1/p' "$anchor"; }

# fixture wraps the fixture binary with everything every document of this machine
# carries: the machine the anchor names, the next position the anti-replay file
# allows, the Controller's own identifiers, its store, and the repository the
# images of this run come from.
fixture() {
  lab-user-service-fixture \
    -machine "$(machine_id)" -sequence "$(next_sequence)" \
    -infrastructure "$infrastructure_id" -controller "$controller_id" \
    -store "$store" -image-repository "$origin_repository" "$@"
}

# image_digest is the digest of the synthetic application's image, recorded by
# `install` from the build and read back here. It is the one value of a plan of
# this door that a revision does not fix.
image_digest() { cat "$state/image-digest.txt"; }

image_reference() { echo "$origin_repository@$(image_digest)"; }

# apply <label> <expectation> <fixture arguments...>
apply() {
  local label=$1 expected=$2 output status=0
  shift 2
  output=$(fixture "$@" | your-cloud auxiliary approve --format=json 2>&1) || status=$?
  printf '%s\n' "$output" >"$state/last-report.json"
  case "$output" in
    *"$expected"*) report "$label" "$expected (status $status)" ;;
    *) red "$label" "expected $expected, got: $(echo "$output" | tr '\n' ' ')" ;;
  esac
}

# refuses <label> <expected reason> <fixture arguments...>
#
# The reason is asserted, not merely the non-zero status. The machine is compared
# with itself before and after, so a refusal that changed something is a red even
# while its reason was right.
refuses() {
  local label=$1 expected=$2 output before
  shift 2
  before=$(fingerprint)
  if output=$(fixture "$@" | your-cloud auxiliary approve 2>&1); then
    red "$label" "accepted: $(echo "$output" | tr '\n' ' ')"
    return
  fi
  printf '%s\n' "$output" >"$state/last-refusal.txt"
  case "$output" in
    *"$expected"*) report "$label" "refused: $expected" ;;
    *) red "$label" "refused for another reason: $(echo "$output" | tr '\n' ' ')" ;;
  esac
  unchanged "$label, zero effect" "$before"
}

# unbuildable asserts that the Controller itself cannot produce a document, and
# names the sentence it refuses with. Several refusals of this palier live there
# and nowhere else — a definition the contract refuses is one nobody can freeze —
# and constating them where they happen is more honest than carrying an
# impossible document to a machine.
unbuildable() {
  local label=$1 expected=$2 output
  shift 2
  if output=$(fixture "$@" 2>&1); then
    red "$label" "the Controller produced it: $(echo "$output" | tr '\n' ' ' | cut -c1-160)"
    return
  fi
  case "$output" in
    *"$expected"*) report "$label" "the Controller refuses to build it: $expected" ;;
    *) red "$label" "refused for another reason: $(echo "$output" | tr '\n' ' ' | cut -c1-200)" ;;
  esac
}

json_field() { sed -n "s/.*\"$1\":\"\\([^\"]*\\)\".*/\\1/p" "$state/last-report.json"; }

# --- what the role decides --------------------------------------------------

role=$(cat "$state/role" 2>/dev/null || echo unknown)
case "$role" in
  lan)
    link_role=initiator
    link_own_address=$link_initiator_address
    link_peer_address=$link_listener_address
    other_machine=lab-vps
    ;;
  vps)
    link_role=listener
    link_own_address=$link_listener_address
    link_peer_address=$link_initiator_address
    other_machine=lab-machine-1
    ;;
  *)
    link_role=unknown
    link_own_address=unknown
    link_peer_address=unknown
    other_machine=unknown
    ;;
esac
