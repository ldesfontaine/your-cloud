#!/usr/bin/env bash
# The two sentences the addendum of `#119` wrote about generated values, produced
# on a machine rather than asserted:
#
#   "Des secrets disparus sont une dérive, jamais une continuité — la valeur
#    manquante est régénérée et le rapport dit que la machine a changé."
#
#   "Une valeur que la machine n'a pas générée est refusée à la relecture par sa
#    propre grammaire : un fichier posé à la main n'injectera pas de ligne
#    d'environnement arbitraire par la porte des secrets."
#
# Both halves need a state the machine does not already hold, and that is worth
# saying rather than discovering: a deployment whose sheet, image, data and
# declared keys are all in place returns "nothing changed" without ever reading a
# value — which is the correct behaviour and also the reason a corrupted value has
# to be made visible to the *presence* check before it can be read at all.
#
# This is one of the scripts allowed to change a machine outside an approved plan.
# It removes a generated value and it plants one, and it says so at the place it
# does both. No value is ever read into a variable, an argument or this log: what
# travels is the attestation the fixture computes and the application serves.
set -euo pipefail
here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=common
. "$here/common"

cd /root

before_attestation=$(cat "$state/app-attestation.txt")
before_content=$(app_content_digest)

deploy() {
  apply "$1" "$2" \
    -operation deploy_user_service -definition application \
    -image-digest "$(image_digest)" -port "$app_port" -origin-host "$app_host"
}

step "41. HARNESS ACT: the generated value is taken away"

rm -f "$app_secret_file"
expect "the value of the declared key" "$(present "$app_secret_file")" absent
expect "the environment file that still names it" "$(present "$app_environment_file")" present

step "42. a value that vanished is a drift, and the report says the machine changed"

deploy "deploy_user_service over a machine whose value is gone" '"changed":true'
expect "the value of the declared key" "$(file_owner "$app_secret_file")" "$app_account:$app_account 600"
expect "its shape" "$(head -1 "$app_secret_file" | grep -cE '^[0-9a-f]{64}$')" 1
after_attestation=$(fixture -attest -secret-file "$app_secret_file" | sed -n 's/^ATTESTATION=//p')
expect "the value is not the one that vanished" \
  "$([[ "$after_attestation" != "$before_attestation" ]] && echo regenerated || echo identical)" regenerated
report "why that is the honest answer" \
  "this Auxiliary cannot know what was there, and announcing continuity over a service whose value it has just recreated would be a machine claiming something it does not have"

expect "the service" "$(service_state "$app_account" "$app_service")" active
expect "its loopback port" "$(loopback_status_within "$app_port" 120)" 200
page=$(loopback_page "$app_port")
expect "the value the container now holds" "$(page_field "$page" token)" "$after_attestation"
expect "the content of its volume, untouched by any of it" "$(app_content_digest)" "$before_content"

step "43. HARNESS ACT: a value this machine did not generate is planted by hand"

# The environment file is taken away with it, because the presence check reads
# names and never values: without that, the deployment would find every declared
# key present and change nothing, and the planted value would never be read.
printf 'INJECTED=whatever this file wants the container to hear\n' >"$app_secret_file"
chown "$app_account:$app_account" "$app_secret_file"
chmod 0600 "$app_secret_file"
rm -f "$app_environment_file"
report "what was planted" "a file under the secrets directory whose content is not sixty-four hexadecimal characters"

step "44. and it is refused at the read, by its own grammar"

status=0
output=$(fixture -operation deploy_user_service -definition application \
  -image-digest "$(image_digest)" -port "$app_port" -origin-host "$app_host" \
  | your-cloud auxiliary approve --format=json 2>&1) || status=$?
printf '%s\n' "$output" >"$state/last-report.json"
report "what the machine concluded" "$(tr '\n' ' ' <<<"$output" | cut -c1-300)"
case "$output" in
  *"holds a value it did not generate for this key"*)
    report "the refusal" "this machine holds a value it did not generate for this key"
    ;;
  *)
    red "the refusal of a planted value" "$(tr '\n' ' ' <<<"$output" | cut -c1-240)"
    ;;
esac
[[ $status -ne 0 ]] \
  && report "the exit status" "$status, non-zero" \
  || red "the exit status" "the machine accepted a value it did not generate"
grep -q 'INJECTED' "$app_unit" 2>/dev/null \
  && red "the planted line" "it reached the sheet" \
  || report "the planted line" "it reached nothing: the door of the secrets injects no environment line"
expect "the environment file, which was never rewritten from it" \
  "$(present "$app_environment_file")" absent

step "45. HARNESS ACT: the planted value is taken away, and the service comes back"

rm -f "$app_secret_file"
deploy "deploy_user_service, once the planted value is gone" '"changed":true'
expect "the service" "$(service_state "$app_account" "$app_service")" active
expect "its loopback port" "$(loopback_status_within "$app_port" 120)" 200
final_attestation=$(fixture -attest -secret-file "$app_secret_file" | sed -n 's/^ATTESTATION=//p')
page=$(loopback_page "$app_port")
expect "the value the container holds" "$(page_field "$page" token)" "$final_attestation"
expect "the keys the environment file names, written again" \
  "$(cut -d= -f1 <"$app_environment_file" | paste -sd, -)" "$app_secret_key"
expect "the content of its volume, through all four of those deployments" \
  "$(app_content_digest)" "$before_content"
expect "the content the application still serves" "$(page_field "$page" content)" "$app_content"

printf '%s\n' "$final_attestation" >"$state/app-attestation.txt"
volumes_state >"$state/volumes-state.txt"
printf '%s\n' "$(container_id "$app_account" "$app_container")" >"$state/app-container.txt"

verdict "a generated value that vanished was regenerated and the report said the machine changed, a value this machine did not generate was refused at the read by its own grammar and injected no environment line, and the volumes were untouched throughout"
