#!/usr/bin/env bash
# Everything this palier claims about what is served, read from outside both
# machines.
#
# This script never runs on lab-vps and never on lab-machine-1. It runs on the
# pilot's own host and, for the readings that want a third machine with root, it
# drives lab-console — which is also the machine this run's images came from. It
# speaks to the two machines only over the addresses and ports a client of the
# real world would use, and it pins the synthetic authority of this run and
# nothing else.
#
# **The honesty this proof owes its reader is written here rather than in a
# footnote.** The `quick` topology is one flat network: the pilot and lab-console
# sit on the same subnet as lab-machine-1, so they can reach that machine's own
# address directly, and they could before any of this existed. That is a property
# of the LAB and not of the product. What is constated instead, and what the
# composition is answerable for, is that no application port of either machine is
# reachable from anywhere, that both declared names are served by one address on
# one port, and that what those names serve is what the definitions said.
set -euo pipefail
here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
root=$(cd -- "$here/../../../.." && pwd)
labctl="$root/tools/labctl"

stage=${1:?usage: outside <stage> <lan-address> <vps-address> <authority> [attestation]}
lan=${2:?usage: outside <stage> <lan-address> <vps-address> <authority> [attestation]}
vps=${3:?usage: outside <stage> <lan-address> <vps-address> <authority> [attestation]}
ca=${4:?usage: outside <stage> <lan-address> <vps-address> <authority> [attestation]}
attestation=${5:-}

export LC_ALL=C.UTF-8
app_port=18310
edge_port=18320
vault_port=18280
app_host=app.lab.your-cloud.test
edge_host=edge.lab.your-cloud.test
unknown_host=inconnu.lab.your-cloud.test
app_content='your-cloud lab synthetic content, revision one'

workdir=$(mktemp -d)
trap 'rm -rf "$workdir"' EXIT

failures=0
report() { printf '%-72s %s\n' "$1" "$2"; }
red() {
  report "$1" "FAILED: $2"
  failures=$((failures + 1))
}
step() { printf '\n== %s ==\n' "$*"; }
expect() {
  local label=$1 observed=$2 expected=$3
  if [[ "$observed" == "$expected" ]]; then
    report "$label" "$expected"
  else
    red "$label" "expected [$expected], observed [$observed]"
  fi
}
verdict() {
  [[ $failures -eq 0 ]] || {
    echo "FAILED: $failures assertions" >&2
    exit 1
  }
  echo "PASS: $1"
}

reach() {
  local address=$1 port=$2
  if timeout 5 bash -c "exec 3<>/dev/tcp/$address/$port" 2>/dev/null; then
    echo reachable
  else
    echo refused
  fi
}

hostile_reach() {
  local address=$1 port=$2
  "$labctl" ssh lab-console -- \
    "timeout 5 bash -c 'exec 3<>/dev/tcp/$address/$port' 2>/dev/null && echo reachable || echo refused" \
    2>/dev/null | tr -d '\r' | tail -1
}

# pinned_get performs one request as a client that trusts this run's authority and
# nothing else, resolving the declared name to the published address itself so that
# the name travels in the SNI and in the Host header while the connection goes
# exactly where this proof means it to go.
pinned_get() {
  local host=$1 out=$2
  curl --silent --show-error --max-time 20 \
    --cacert "$ca" --resolve "$host:443:$vps" \
    --dump-header "$workdir/headers.txt" --output "$out" \
    --write-out '%{http_code}' "https://$host/" 2>"$workdir/curl.err" \
    || {
      printf 'none(%s)' "$(tr -d '\n' <"$workdir/curl.err" | cut -c1-120)"
      return 0
    }
}

unpinned_get() {
  curl --silent --insecure --max-time 20 --output /dev/null \
    --resolve "$1:443:$vps" --write-out '%{http_code}' "https://$1/" 2>/dev/null || echo none
}

served_address() {
  curl --silent --max-time 20 --output /dev/null --cacert "$ca" \
    --resolve "$1:443:$vps" --write-out '%{remote_ip}:%{remote_port}' \
    "https://$1/" 2>/dev/null || echo none
}

presented_subject() {
  openssl s_client -connect "$vps:443" -servername "$1" </dev/null 2>/dev/null \
    | openssl x509 -noout -subject 2>/dev/null || echo unreadable
}

page_field() { sed -n "s/^$2=//p" <<<"$1" | head -1; }

case "$stage" in
  before)
    step "A. from outside, before any plan"
    for port in 443 80 "$vault_port" "$app_port" "$edge_port"; do
      expect "lab-vps:$port, from the pilot" "$(reach "$vps" "$port")" refused
      expect "lab-machine-1:$port, from the pilot" "$(reach "$lan" "$port")" refused
    done
    report "what this flat topology already grants a hostile host" \
      "lab-machine-1:22 is $(reach "$lan" 22) from here, before anything of this proof exists"
    verdict "neither machine offers this proof's client anything of the scenario"
    ;;

  after-user)
    step "B. from outside, once a service of the third door runs on the machine of the LAN"
    expect "the user service's port, from the pilot" "$(reach "$lan" "$app_port")" refused
    expect "the user service's port, from lab-console" "$(hostile_reach "$lan" "$app_port")" refused
    expect "the vault's port beside it, from the pilot" "$(reach "$lan" "$vault_port")" refused
    expect "the vault's port, from lab-console" "$(hostile_reach "$lan" "$vault_port")" refused
    expect "the user service's port on the VPS's own address" "$(reach "$vps" "$app_port")" refused
    expect "the secure public port of the machine of the LAN" "$(reach "$lan" 443)" refused
    expect "the clear public port of the machine of the LAN" "$(reach "$lan" 80)" refused
    verdict "a service of the third door publishes on its machine's loopback and is reachable from nowhere else — not from the pilot, not from a third machine with root, and not from the VPS's own address"
    ;;

  after-edge)
    step "C. from outside, the name a local route publishes on the entry"
    status=$(pinned_get "$edge_host" "$workdir/edge.txt")
    expect "https to $edge_host, verified against the pinned authority" "$status" 200
    page=$(cat "$workdir/edge.txt")
    report "what it serves" "$(tr '\n' ' ' <<<"$page" | cut -c1-160)"
    expect "the origin its definition interpolated" "$(page_field "$page" origin)" "https://$edge_host"
    expect "the generated value a definition without secret keys receives" \
      "$(page_field "$page" token)" absent
    expect "https to the other name, not published yet" "$(unpinned_get "$app_host")" 404
    expect "the user service's own port on the VPS" "$(reach "$vps" "$edge_port")" refused
    verdict "the first name is served by the entry over the run's authority, carries the origin its own definition interpolated, and the other name is not served at all"
    ;;

  after-link)
    step "D. two declared names of the third door, one public address, one public port"
    app_status=$(pinned_get "$app_host" "$workdir/app.txt")
    edge_status=$(pinned_get "$edge_host" "$workdir/edge.txt")
    expect "https to $app_host, verified against the pinned authority" "$app_status" 200
    expect "https to $edge_host, verified against the pinned authority" "$edge_status" 200

    app_at=$(served_address "$app_host")
    edge_at=$(served_address "$edge_host")
    report "where $app_host was served from" "$app_at"
    report "where $edge_host was served from" "$edge_at"
    expect "the two names are served by one address and one port" "$app_at" "$edge_at"
    expect "and that address and port are the VPS's 443" "$app_at" "$vps:443"
    report "and the two trajectories behind them" \
      "$app_host crosses the passage to lab-machine-1, $edge_host is served locally on lab-vps — both of them services of the third door"

    step "E. what the definition said, read from outside the machine that runs it"
    page=$(cat "$workdir/app.txt")
    report "what $app_host serves" "$(tr '\n' ' ' <<<"$page" | cut -c1-200)"
    expect "the slug it names" "$(page_field "$page" slug)" labapp
    expect "the origin the plan approved and the definition interpolated" \
      "$(page_field "$page" origin)" "https://$app_host"
    expect "the tmpfs its definition declared" "$(page_field "$page" scratch)" writable
    expect "the content of its own volume" "$(page_field "$page" content)" "$app_content"
    if [[ -n "$attestation" ]]; then
      expect "the generated value the container holds, attested and never carried" \
        "$(page_field "$page" token)" "$attestation"
    else
      report "the generated value the container holds" "$(page_field "$page" token)"
    fi

    for host in "$app_host" "$edge_host"; do
      subject=$(presented_subject "$host")
      case "$subject" in
        *"$host"*) report "the certificate presented for $host" "$subject" ;;
        *) red "the certificate presented for $host" "$subject" ;;
      esac
    done

    step "F. and nothing else is served at all"
    expect "https to a name nobody declared" "$(unpinned_get "$unknown_host")" 404
    expect "https to the address itself" "$(unpinned_get "$vps")" 404
    expect "the user service's port on the machine of the LAN" "$(reach "$lan" "$app_port")" refused
    expect "the same port, from lab-console" "$(hostile_reach "$lan" "$app_port")" refused
    expect "the vault's port, which no name publishes" "$(reach "$lan" "$vault_port")" refused
    expect "the other user service's port on the VPS" "$(reach "$vps" "$edge_port")" refused
    verdict "two names of the third door answer 200 on the same public address and the same 443 under certificates of their own names, one through the passage and one locally, what they serve is what their definitions said, and no other name, no direct address and no application port is served"
    ;;

  after-lifecycle)
    step "G. from outside, after the recreation, the archive cycle and the failed revision"
    status=$(pinned_get "$app_host" "$workdir/app.txt")
    expect "https to $app_host" "$status" 200
    page=$(cat "$workdir/app.txt")
    expect "the content, through all of it" "$(page_field "$page" content)" "$app_content"
    expect "the origin, through all of it" "$(page_field "$page" origin)" "https://$app_host"
    if [[ -n "$attestation" ]]; then
      expect "the generated value the container holds" "$(page_field "$page" token)" "$attestation"
    else
      report "the generated value the container holds" "$(page_field "$page" token)"
    fi
    report "the number of starts its own volume records" "$(page_field "$page" boots)"
    expect "https to $edge_host, untouched by any of it" "$(pinned_get "$edge_host" "$workdir/edge.txt")" 200
    expect "the user service's port on the machine of the LAN" "$(reach "$lan" "$app_port")" refused
    verdict "the name still answers with the content its own volume holds and the value its machine generated, and the other name was untouched"
    ;;

  after-retire-app)
    step "H. from outside, once the passage's name is retired"
    expect "https to the name that was published" "$(unpinned_get "$app_host")" 404
    subject=$(presented_subject "$app_host")
    case "$subject" in
      *"$app_host"*) red "the certificate presented for it" "still its own: $subject" ;;
      *) report "the certificate presented for it" "$subject" ;;
    esac
    expect "https to $edge_host, untouched" "$(pinned_get "$edge_host" "$workdir/edge.txt")" 200
    expect "the user service's port on the machine of the LAN" "$(reach "$lan" "$app_port")" refused
    verdict "the retired name obtains the entry's generic refusal and no certificate of its own, while the other name keeps being served"
    ;;

  removed)
    step "I. from outside, once nothing of this proof remains"
    for port in 443 80 "$vault_port" "$app_port" "$edge_port"; do
      expect "lab-vps:$port" "$(reach "$vps" "$port")" refused
      expect "lab-machine-1:$port" "$(reach "$lan" "$port")" refused
    done
    expect "the user service's port, from lab-console" "$(hostile_reach "$lan" "$app_port")" refused
    verdict "both machines offer this proof's client nothing at all"
    ;;

  *)
    echo "unknown stage: $stage" >&2
    exit 2
    ;;
esac
