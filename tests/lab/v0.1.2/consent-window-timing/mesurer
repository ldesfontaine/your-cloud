#!/usr/bin/env python3
"""Chronomètre ce que délibérer coûte réellement, sur la copie exacte du produit.

`#133` demande deux durées et interdit de les fixer sur un avis : l'une borne le
temps de lire un plan, l'autre le temps qu'une autorité confirmée reste
inutilisée. **Les deux sont des durées humaines**, et ce script mesure les deux.

La seconde l'est parce que le contrat le veut : le sondage du frontend s'arrête
à l'état `answered` et ne soumet rien. `submit_plan_decision` n'a qu'un
appelant, le bouton « Signer et lancer » de `plans-view.tsx`, et le commentaire
posé à côté dit pourquoi — une soumission qui suivrait la fermeture de la
fenêtre ferait de la fenêtre le déclencheur d'un effet, quand le contrat en fait
un recueil de consentement. Entre la confirmation et la signature, un humain
revient à la Console, lit ce qu'elle lui dit, et clique.

Ce qui est affiché n'est pas une imitation : ce sont les lignes que
`PresentedPublicationPlan::confirmation_lines()` produit, extraites du produit
et conservées dans `copie.tsv`. Le terminal n'est pas la fenêtre GTK, et c'est
la limite honnête de cet essai : il mesure le temps de **lire ce texte et de
comparer ces empreintes**, pas l'ergonomie de la fenêtre.

Une lecture sur les trois porte une empreinte **altérée d'un caractère**, tirée
au sort et jamais annoncée. Sans elle, l'essai mesurerait un temps passé devant
un texte ; avec elle, il dit aussi si ce temps achète quelque chose.

    tests/lab/v0.1.2/consent-window-timing/mesurer private_service
    tests/lab/v0.1.2/consent-window-timing/mesurer user_service --lectures 3
"""

from __future__ import annotations

import argparse
import random
import statistics
import sys
import time
from pathlib import Path

SHEET = Path(__file__).resolve().parent / "copie.tsv"


def copy_for(family: str) -> list[str]:
    lines = []
    for raw in SHEET.read_text(encoding="utf-8").splitlines():
        if raw.startswith("#") or "\t" not in raw:
            continue
        name, _, line = raw.partition("\t")
        if name == family:
            lines.append(line)
    if not lines:
        raise SystemExit(f"la famille {family!r} est absente de {SHEET}")
    return lines


def digests(lines: list[str]) -> list[int]:
    """Les index des deux lignes d'empreinte, reconnues à leur libellé.

    Reconnaître « soixante-quatre caractères hexadécimaux » ne suffit pas : la
    révision gelée d'une définition en est une aussi, et c'est bien la question
    — le plan porte plusieurs longues chaînes qui se ressemblent, et seules deux
    d'entre elles sont ce que la signature couvre.
    """
    found = [index for index, line in enumerate(lines) if line.startswith("Empreinte ")]
    if len(found) != 2:
        raise SystemExit(f"cette famille porte {len(found)} lignes d'empreinte, pas deux")
    return found


def altered(line: str) -> str:
    """Un caractère de l'empreinte changé, et un seul."""
    head, _, digest = line.rpartition(" ")
    position = random.randrange(len(digest))
    replacement = random.choice([c for c in "0123456789abcdef" if c != digest[position]])
    return f"{head} {digest[:position]}{replacement}{digest[position + 1:]}"


# Le panneau que la Console rend une fois la fenêtre refermée sur une
# confirmation, copié de `console/src/product/plans-view.tsx`. C'est lui que
# l'humain lit avant de cliquer, et donc lui qui occupe le second intervalle.
CONSOLE_AFTER_CONFIRMATION = (
    "Approuvé dans la fenêtre native",
    "Rien n’est encore parti. Signer scelle ces deux empreintes sous votre clé "
    "et remet l’approbation au Controller, qui dépense la position de cette "
    "machine avant d’ouvrir quoi que ce soit. C’est une autorité à un coup.",
    "[ Signer et lancer ]",
)


def reading(
    lines: list[str], reference: list[str], tampered: bool
) -> tuple[float, float | None, bool]:
    shown = list(lines)
    if tampered:
        index = random.choice(digests(lines))
        shown[index] = altered(lines[index])

    print("\n" * 3)
    input("Prêt ? Entrée pour afficher le plan. ")
    print("\n=== La Console affiche, à côté de la fenêtre, les deux empreintes du plan ===")
    for index in digests(lines):
        print(f"  {reference[index]}")
    print("\n=== La fenêtre d'approbation ===")
    for line in shown:
        print(f"  {line}")
    print()
    started = time.monotonic()
    input("Entrée quand vous avez fini de lire et de comparer. ")
    answer = ""
    while answer not in {"o", "n"}:
        answer = input("Les deux empreintes de la fenêtre sont-elles celles de la Console ? [o/n] ").strip().lower()
    deliberating = time.monotonic() - started
    caught = (answer == "n") if tampered else (answer == "o")

    # Le second intervalle n'existe que sur une lecture qui aurait réellement
    # confirmé : une lecture qui a repéré une altération n'atteint jamais le
    # bouton, et la chronométrer mesurerait un geste qu'un humain n'aurait pas
    # fait.
    if answer != "o":
        return deliberating, None, caught

    print("\n=== La fenêtre s'est refermée. Vous revenez à la Console ===")
    signing_started = time.monotonic()
    badge, prose, button = CONSOLE_AFTER_CONFIRMATION
    print(f"  [{badge}]")
    print(f"  {prose}")
    print(f"  {button}")
    input("\nEntrée pour « cliquer » sur Signer et lancer. ")
    return deliberating, time.monotonic() - signing_started, caught


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("famille", choices=["private_service", "user_service"])
    parser.add_argument("--lectures", type=int, default=3)
    arguments = parser.parse_args()

    lines = copy_for(arguments.famille)
    characters = sum(len(line) for line in lines)
    print(f"Famille : {arguments.famille}")
    print(f"{len(lines)} phrases, {characters} caractères, 2 empreintes de 64 caractères.")
    print("Lisez comme vous liriez pour de vrai. Rien n'est chronométré avant votre Entrée.")

    tampered_at = random.randrange(arguments.lectures)
    results = []
    for index in range(arguments.lectures):
        deliberating, signing, caught = reading(lines, lines, index == tampered_at)
        results.append((deliberating, signing, index == tampered_at, caught))
        signed = "—" if signing is None else f"{signing:.1f} s"
        print(f"  → délibérer {deliberating:.1f} s   signer {signed}")

    print("\n=== Résultat ===")
    print("  lecture   délibérer    signer   plan       empreinte altérée")
    for index, (deliberating, signing, tampered, caught) in enumerate(results, start=1):
        signed = "     —" if signing is None else f"{signing:6.1f}"
        mark = "altéré " if tampered else "intact "
        verdict = "vue" if caught else "MANQUÉE"
        print(f"  {index:^7}   {deliberating:6.1f} s   {signed} s   {mark}    {verdict}")

    def bounds(label: str, values: list[float]) -> None:
        if not values:
            print(f"  {label} : aucune mesure")
            return
        print(
            f"  {label} : médiane {statistics.median(values):.1f} s   "
            f"maximum {max(values):.1f} s   ({len(values)} lecture(s))"
        )

    print()
    bounds("délibérer          ", [d for d, _, _, _ in results])
    bounds("autorité confirmée ", [s for _, s, _, _ in results if s is not None])

    missed = [i for i, (_, _, _, caught) in enumerate(results, start=1) if not caught]
    if missed:
        print(f"\n  !! lecture(s) {missed} : la réponse ne correspond pas à ce qui était affiché.")
        print("     Un temps de lecture qui ne repère pas une empreinte altérée ne borne rien ;")
        print("     c'est un fait à porter au dossier de #133 avant d'en tirer une durée.")

    print()
    print("Les deux bornes se posent au-dessus du maximum observé, pas de la médiane :")
    print("une borne calée sur le lecteur moyen coupe le lecteur attentif.")
    print()
    print("Et la seconde se pose au-dessus de ce maximum AUGMENTÉ d'une marge : cette")
    print("feuille ne fait pas revenir de la fenêtre native à la Console, donc ce qu'elle")
    print("donne du second intervalle est un plancher. Une borne trop courte refuserait le")
    print("geste d'un humain qui a lu, compris et accepté.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
