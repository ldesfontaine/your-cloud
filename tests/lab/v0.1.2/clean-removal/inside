#!/usr/bin/env bash
# Ce que l'oracle a besoin d'avoir autour de lui, dans l'écran virtuel que `run`
# a ouvert, et sous le compte de l'humain.
#
# Le pilote est le produit installé : `/usr/bin/your-cloud-console`, le binaire
# que le `.deb` de cette passe a réellement posé, conduit par `tauri-driver`
# devant le même WebKitWebDriver avec lequel la Console Linux peint.
#
# **Aucune variable `XDG_*` n'est posée ici**, et c'est la seule différence qui
# compte avec le patron dont ce script descend. Le harnais du trajet de commande
# déplace l'état de la Console sous un répertoire à lui pour pouvoir le remettre
# à zéro entre deux étapes ; cette preuve-ci mesure justement **où le produit
# écrit quand personne ne le lui dit**. Un état déplacé rendrait la question
# sans objet.
set -euo pipefail
export LC_ALL=C.UTF-8

here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
application=/usr/bin/your-cloud-console
output="$here/output"
driver_port=4444
native_port=4445

mkdir -p "$output"

fail() { echo "FAILED: $*" >&2; exit 1; }

[[ -x "$application" ]] || fail "$application est absent ; installez le candidat d'abord"

wait_for_port() {
  local label=$1 port=$2 attempt
  for attempt in $(seq 1 120); do
    if (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null; then
      echo "  $label prêt après $attempt tentatives"
      return 0
    fi
    sleep 0.5
  done
  echo "FAILED: $label n'a jamais ouvert le port $port" >&2
  return 1
}

"$here/tauri-driver" \
  --native-driver /usr/bin/WebKitWebDriver \
  --port "$driver_port" --native-port "$native_port" \
  >"$output/tauri-driver.log" 2>&1 &
driver_pid=$!
cleanup() {
  kill "$driver_pid" 2>/dev/null || true
  wait "$driver_pid" 2>/dev/null || true
  pkill -x your-cloud-console 2>/dev/null || true
  pkill -x your-cloud-native-bootstrap-assistant 2>/dev/null || true
}
trap cleanup EXIT

wait_for_port "tauri-driver" "$driver_port"
wait_for_port "le WebKitWebDriver natif" "$native_port"
echo "  moteur $(dpkg-query -W -f '${Version}' libwebkit2gtk-4.1-0 2>/dev/null || echo '?') (WebKitGTK)"
echo "  candidat $(dpkg-query -W -f '${Version}' your-cloud 2>/dev/null || echo '?')"
echo "  humain $(id -un) — HOME=$HOME"

set +e
python3 -u -X faulthandler "$here/console-oracle.py" \
  --base-url "http://127.0.0.1:$driver_port" \
  --application "$application" \
  --output "$output/usage.json"
oracle_status=$?
set -e
echo "  sortie de l'oracle : $oracle_status"
exit "$oracle_status"
