#!/usr/bin/env bash
# Le sol que la machine doit porter **avant** que la base soit relevée.
#
# Il est posé avant le recensement de base, et c'est un choix de méthode qui
# décide de ce que la preuve mesure. Le `.deb` déclare deux dépendances —
# `libwebkit2gtk-4.1-0` et `libgtk-3-0` — dont la fermeture apt compte des
# milliers de fichiers. Les installer *après* la base ferait entrer cette
# fermeture dans la différence, et « ce que le paquet a posé » se lirait au
# milieu de ce que Debian a posé pour lui. Elles sont donc dans la base, et la
# différence isole le paquet.
#
# Trois choses sont posées ici, et elles ne disent pas la même chose :
#
#   les dépendances du paquet   ce que le produit exige pour tourner ;
#   le sol du pilote            Xvfb, D-Bus et le WebKitWebDriver dont l'oracle
#                               a besoin, et le produit non — nommés à part
#                               pour cette raison ;
#   l'humain                    un vrai compte non privilégié. L'App d'un
#                               humain écrit sous son `$HOME` ; mesurer sous
#                               `/root` répondrait à une autre question que
#                               « que reste-t-il des données de l'humain ».
set -euo pipefail
export LC_ALL=C.UTF-8
export DEBIAN_FRONTEND=noninteractive

human=${1:-humain}

echo "== dépendances déclarées par le paquet, et sol du pilote"
apt-get update -qq
apt-get install -y -qq --no-install-recommends \
  libwebkit2gtk-4.1-0 libgtk-3-0 \
  webkit2gtk-driver xvfb xauth dbus-x11 python3 >/dev/null

echo "== l'humain"
if ! id -u "$human" >/dev/null 2>&1; then
  adduser --disabled-password --gecos "" "$human" >/dev/null
fi
install -d -m 0755 /opt/clean-removal
chmod 0755 /opt/clean-removal
chown -R root:root /opt/clean-removal

# L'oracle, le pilote et leurs sorties appartiennent à l'humain : c'est lui qui
# les exécute, et les sorties du harnais ne doivent pas devenir des fichiers de
# root dans une zone que le recensement ignore de toute façon.
install -d -m 0777 /opt/clean-removal/output
chmod 0755 /opt/clean-removal/inside /opt/clean-removal/run \
  /opt/clean-removal/app-oracle.py /opt/clean-removal/tauri-driver

echo "== ce que la machine porte maintenant"
printf '  %-34s %s\n' "WebKitWebDriver" "$(command -v WebKitWebDriver || echo absent)"
printf '  %-34s %s\n' "libwebkit2gtk-4.1-0" "$(dpkg-query -W -f '${Version}' libwebkit2gtk-4.1-0)"
printf '  %-34s %s\n' "libgtk-3" "$(dpkg-query -W -f '${Package} ${Version}\n' 'libgtk-3-0*' | head -1)"
printf '  %-34s %s\n' "xauth" "$(command -v xauth || echo absent)"
printf '  %-34s %s\n' "python3" "$(python3 --version)"
printf '  %-34s %s\n' "$human" "$(getent passwd "$human" | cut -d: -f6)"
echo PREPARE_OK
