# Shared vocabulary of the command-path perimeter, sourced by every script that
# runs on a machine of this scenario. It asserts nothing by itself: it is the
# words the judging scripts speak, so that a fact read before a step and the
# same fact read after it are read by the same lines.
#
# Three machines, three authorities, and none of them interchangeable:
#
#   lab-vps        the **Controller**. It serves the real product binary, holds
#                  the command identities and the endpoint sheets, and is the
#                  only side that opens an SSH session toward a machine;
#   lab-machine-1  the **machine**. It holds the Auxiliary account, the forced
#                  command, the approval anchor, its own anti-replay position
#                  and the rootless Podman ground a user service really needs.
#                  It also serves the Relay the Controller reads from, and the
#                  origin of this run's image;
#   lab-app    the **human's machine**. It holds the real App — the
#                  installed `.deb`, its WebView and its native helper — and
#                  nothing of the server side.
#
# Everything here is read-only except where a function says otherwise.

export LC_ALL=C.UTF-8

state=/root/lab-command-path
machine_id=lab-machine-1

# The chain this proof needs alive, and the two addresses the product's own
# binaries insist on. They are constants of the product, not choices of this
# harness: the Relay refuses to listen anywhere but the first, and its reader
# refuses every source but the second.
relay_address=192.168.243.153
relay_ingestion_port=8443
relay_reader_port=8444
controller_source=192.168.242.103
relay_name=relay.observation.your-cloud.test

daemon_unit=your-cloud-daemon.service
relay_unit=your-cloud-relay.service
controller_unit=your-cloud-controller.service
artifact=/usr/local/lib/your-cloud/your-cloud

# The Auxiliary's own furniture on the machine. Every one of these paths is the
# product's, not this harness's: the anchor the Auxiliary verifies against, the
# anti-replay position it spends, the account the forced command runs as, and
# the two files the enrolment poses.
account=your-cloud-auxiliary
anchor=/etc/your-cloud/approval-anchor.json
replay=/var/lib/your-cloud-auxiliary/approval-state.json
forced_key=/etc/your-cloud/authorized-keys/$account
elevation_rule=/etc/sudoers.d/60-your-cloud-auxiliary
machine_binary=/usr/lib/your-cloud/your-cloud

# The Controller's two root-owned directories of the command path, named by the
# unit the package delivers. One entry per machine inside each, never a line per
# machine in a unit the package could not write.
command_identities=/etc/your-cloud/command-identities
command_endpoints=/etc/your-cloud/command-endpoints

# The service this run deploys, and the port it publishes on the machine. The
# slug is the product's own grammar; the port is a fact of this topology.
service_slug=journal-de-bord
service_port=18090

failures=0

report() { printf '%-68s %s\n' "$1" "$2"; }
red() {
  report "$1" "FAILED: $2"
  failures=$((failures + 1))
}
green() { report "$1" "$2"; }
step() { printf '\n== %s ==\n' "$*"; }
note() { printf '  %-46s %s\n' "$1" "$2"; }

verdict() {
  [[ $failures -eq 0 ]] || {
    echo "FAILED: $failures assertions" >&2
    exit 1
  }
  echo "PASS: $1"
}

# defect names something the machine does that the product did not intend, in
# full, and lets the rest of the palier run. It is never repaired here: the
# session that orchestrates this proof decides what a defect costs.
defect() {
  printf '!! PRODUCT DEFECT: %s\n' "$1"
  printf '   %s\n' "$2"
}

limit() {
  printf '!! LIMIT: %s\n' "$1"
  printf '   %s\n' "$2"
}

unit_state() { systemctl show "$1" --property=ActiveState --value 2>/dev/null || echo unknown; }

# The dispatch registry the Controller writes, read from the machine that owns
# it. It is the state directory of the service, and only root may read it.
dispatch_registry() {
  local root=/var/lib/private/your-cloud-controller
  [[ -d $root ]] || root=/var/lib/your-cloud-controller
  printf '%s/dispatches.json' "$root"
}
