#!/usr/bin/env bash
# Drive the command-path proof: the whole journey from the human who approves to
# the machine that reports, with the product's own binaries and nothing else.
#
# This is the milestone's proof under the rule written at
# `docs/contribution/QUALITE.md`: **no fixture replaces a component of the
# product on this path.** Every past proof of this repository crossed links 3, 4
# and 5 by a fixture — a synthetic signer, a synthetic Console, a piped
# wrapper — and each said so. Here the real Console builds the pair, the real
# native window collects the consent, the real core signs, the real Controller
# receives, spends the sequence and launches over SSH, and the real Auxiliary
# applies on another machine.
#
# Three machines, three authorities, none interchangeable:
#
#   lab-console    the human's machine: the installed `.deb`, its WebView, its
#                  native helper and its vault. Nothing of the server side;
#   lab-vps        the Controller: the product binary, the command identities,
#                  the endpoint sheets, and the only side that opens an SSH
#                  session toward a machine;
#   lab-machine-1  the machine: the Auxiliary account, the forced command, the
#                  anchor, its own anti-replay position, and the Go toolchain
#                  this LAB builds the server binary with.
#
# The Relay is **not** optional here, and this harness records why rather than
# rediscovering it. A Controller serves perfectly well with a Relay endpoint
# that never answers — its reader is lazy — and observations are genuinely not
# on the command path. But a machine only enters the inventory through
# `PUT /v0/machines`, which reads the Relay snapshot and refuses a machine it
# cannot see reported `active`; and an approval for a machine outside the
# inventory is refused `machine_not_active`. The Relay and the Daemon are
# therefore the gate of link 4, not furniture.
set -euo pipefail
export LC_ALL=C.UTF-8

usage() {
  cat >&2 <<'EOF'
usage: prove [artifact | controller | console | associate | relay | enrol |
              attach | origin | journey | verify | collect | remove | all]

  artifact    build the product binary on the machine that carries Go
  controller  init the real Controller on lab-vps and start it serving, with
              one enrolment window open
  console     sync the console sources, build the .deb and install it
  associate   drive the real Console to its association with that Controller,
              then close the window: a Controller holding an active device
              refuses to open a second one, and it is right to
  relay        stand the Relay and the Daemon up — the gate a machine enters
              the Controller's inventory through
  enrol       pose the anchor carrying the **real** approval key of the real
              Console, the forced command and the bounded elevation
  attach      rattach the machine from the Console's own Parc view
  origin      build this run's image, serve it, and ground the machine for it
  journey     the whole path twice: the failure that reaches the machine and
              comes back, then the success that really poses a service
  verify      read the posed service from outside the product
  collect     bring the structured results back
  remove      take the perimeter away from the three machines and prove it
  all         everything above in order, removing even when a step fails

The three machines must already exist, be running and be provisioned:

  tools/labctl topology create quick
  tools/provision-lab all
EOF
  exit 2
}

command=${1:-all}
[[ $# -le 1 ]] || usage
case "$command" in
  artifact | controller | console | associate | relay | enrol | attach | origin \
    | journey | verify | collect | remove | all) ;;
  *) usage ;;
esac

root=$(cd -- "$(dirname -- "$0")/../../../.." && pwd)
harness=$(cd -- "$(dirname -- "$0")" && pwd)
labctl="$root/tools/labctl"
console_vm=lab-console
controller_vm=lab-vps
machine_vm=lab-machine-1
expected_origin=your-cloud/labctl
remote_harness=/root/your-cloud-lab-command-path
remote_state=/root/lab-command-path
remote_build=/root/command-path-build
remote_origin=/root/lab-command-path-origin
# The origin of this run's image. It is the environment, not the product: the
# name, the repository and the apparatus are `v0.1.1`'s, reused rather than
# rebuilt, and it is served from the Controller's machine only because that is a
# third host neither the Console nor the machine is.
origin_host=registry.lab.your-cloud.test
origin_repository="$origin_host/lab/synthetic-app"
# The service this run really poses, and the three values that must agree
# across three documents: the frozen definition, the plan, and the Quadlet unit
# the Auxiliary writes.
service_slug=journal-de-bord
service_account=your-cloud-user-$service_slug
service_port=18090
scratch_directory=/var/scratch
result_root="$root/tests/artifacts/proofs/command-path"
run_id=$(date -u +%Y%m%dT%H%M%SZ)-$$
workdir=$(mktemp -d)
# The values one phase observes and a later one needs live outside the run's
# temporary directory on purpose: the subcommands are meant to be usable one at
# a time while the perimeter stays mounted. Not one of them is a secret — two
# identifiers and the Controller's own one-time sheet, which expires by itself.
carried="${TMPDIR:-/tmp}/your-cloud-lab-command-path"
mkdir -p "$carried"
trap 'rm -rf "$workdir"' EXIT

fail() { echo "FAILED: $*" >&2; exit 1; }
announce() { printf '\n==> %s\n' "$*"; }

# The revision the artefacts belong to. A dirty tree is named as dirty rather
# than passed off as the commit it sits on.
revision() {
  local head dirty=
  head=$(cd "$root" && git rev-parse HEAD)
  if ! (cd "$root" && git diff --quiet) \
    || ! (cd "$root" && git diff --cached --quiet) \
    || [[ -n "$(cd "$root" && git ls-files --others --exclude-standard)" ]]; then
    dirty=+worktree
  fi
  printf '%s%s' "$head" "$dirty"
}

# The mandatory inventory guard: read the LAB before mutating any of it.
inventory() {
  local vm=$1 line state ips template topology origin
  line=$("$labctl" list --format=tsv | awk -v vm="$vm" -F'\t' '$1 == vm')
  [[ -n "$line" ]] || fail "$vm is not part of the LAB inventory"
  IFS=$'\t' read -r _ state ips template topology origin <<<"$line"
  [[ "$origin" == "$expected_origin" ]] || fail "$vm carries the origin $origin"
  [[ "$state" == running ]] || fail "$vm is $state"
  [[ "$topology" == quick ]] || fail "$vm belongs to the topology $topology"
  [[ "$ips" != *,* ]] || fail "$vm holds several addresses: $ips"
  [[ "$ips" != 192.168.122.123 && "$ips" != 10.66.66.1 ]] \
    || fail "$vm holds an address this project never mutates"
  echo "$ips"
}

deploy() { # deploy <vm> <script>...
  local vm=$1 script
  shift
  "$labctl" ssh "$vm" -- "install -d -m 0700 $remote_harness"
  for script in "$@"; do
    "$labctl" copy-to "$vm" "$harness/$script" "$remote_harness/$script" >/dev/null
    "$labctl" ssh "$vm" -- "chmod 0700 $remote_harness/$script"
  done
}

# --------------------------------------------------------------------------
# artifact — the server binary, built where Go lives and never on the pilot.
# --------------------------------------------------------------------------
build_artifact() {
  announce "building the product binary on $machine_vm — $(inventory "$machine_vm")"
  tar -C "$root" -czf "$workdir/sources.tgz" go.mod go.sum cmd internal
  "$labctl" copy-to "$machine_vm" "$workdir/sources.tgz" "$remote_build.tgz" >/dev/null
  "$labctl" ssh "$machine_vm" -- "
set -e
export PATH=\$PATH:/usr/local/go/bin LC_ALL=C.UTF-8
rm -rf $remote_build && install -d -m 0700 $remote_build
tar -C $remote_build -xzmf $remote_build.tgz && rm -f $remote_build.tgz
cd $remote_build && go build -o $remote_build/your-cloud ./cmd/your-cloud"
  "$labctl" copy-from "$machine_vm" "$remote_build/your-cloud" "$carried/your-cloud" >/dev/null
  echo "  product binary: $(sha256sum "$carried/your-cloud" | cut -d' ' -f1)"
}

# --------------------------------------------------------------------------
# controller — the real Controller, serving, with the dispatcher attached.
# --------------------------------------------------------------------------
mount_controller() {
  local controller_address machine_address console_address
  controller_address=$(inventory "$controller_vm")
  machine_address=$(inventory "$machine_vm")
  console_address=$(inventory "$console_vm")
  [[ -s "$carried/your-cloud" ]] || fail "no product binary is carried; run the artifact phase first"

  announce "mounting the Controller on $controller_vm — $controller_address"
  deploy "$controller_vm" common install-controller
  "$labctl" ssh "$controller_vm" -- "install -d -m 0700 $remote_origin"
  "$labctl" copy-to "$controller_vm" "$harness/serve-origin" "$remote_origin/serve-origin" >/dev/null
  "$labctl" ssh "$controller_vm" -- "chmod 0700 $remote_origin/serve-origin"
  "$labctl" copy-to "$controller_vm" "$carried/your-cloud" "$remote_harness/your-cloud" >/dev/null

  local identifiers
  identifiers=$("$labctl" ssh "$controller_vm" -- \
    "$remote_harness/install-controller init $remote_harness/your-cloud")
  echo "$identifiers"
  local controller_id infrastructure_id
  controller_id=$(printf '%s' "$identifiers" | sed -n 's/^CONTROLLER_ID=//p')
  infrastructure_id=$(printf '%s' "$identifiers" | sed -n 's/^INFRASTRUCTURE_ID=//p')
  [[ -n "$controller_id" && -n "$infrastructure_id" ]] \
    || fail "the Controller minted no identity of its own"
  printf '%s' "$infrastructure_id" >"$carried/infrastructure-id"

  # The run's PKI, generated on the machine that carries Go, *after* the
  # identity above: a reader manifest naming another installation is refused,
  # and rightly. Only the Controller's three leaves ever leave that machine.
  "$labctl" copy-to "$machine_vm" "$root/tests/lab/v0.0.3/generate-runtime-pki.go" \
    "$remote_build/labpki-main.go" >/dev/null
  "$labctl" ssh "$machine_vm" -- "
set -e
export PATH=\$PATH:/usr/local/go/bin LC_ALL=C.UTF-8
cd $remote_build && install -d labpki && mv labpki-main.go labpki/main.go
rm -rf $remote_build/pki
go run ./labpki -output $remote_build/pki \
  -controller-id $controller_id -infrastructure-id $infrastructure_id"
  install -d -m 0700 "$workdir/creds"
  local leaf
  for leaf in controller-reader.crt controller-reader.key relay-reader-ca.crt; do
    "$labctl" copy-from "$machine_vm" "$remote_build/pki/controller/$leaf" "$workdir/creds/$leaf" >/dev/null
    "$labctl" copy-to "$controller_vm" "$workdir/creds/$leaf" "$remote_harness/creds-$leaf" >/dev/null
  done
  "$labctl" ssh "$controller_vm" -- "
set -e
install -d -m 0700 $remote_harness/creds
for leaf in controller-reader.crt controller-reader.key relay-reader-ca.crt; do
  mv $remote_harness/creds-\$leaf $remote_harness/creds/\$leaf
done"

  # The command identity of the machine, struck by the product's own binary.
  # Only the public half is carried; the private one never leaves that machine.
  "$labctl" ssh "$controller_vm" -- "$remote_harness/install-controller mint $machine_vm" \
    | tee "$workdir/minted"
  sed -n 's/^PUBLIC_KEY=//p' "$workdir/minted" | awk '{print $1, $2}' >"$carried/command-public-key"
  [[ -s "$carried/command-public-key" ]] || fail "the Controller minted no public half to carry"

  # The endpoint sheet. Its host key is read through the managed LAB channel and
  # pinned; no side of this harness ever trusts a first answer on the wire.
  "$labctl" copy-from "$machine_vm" /etc/ssh/ssh_host_ed25519_key.pub "$workdir/host.pub" >/dev/null
  local host_key
  host_key=$(awk '$1 == "ssh-ed25519" {print $2; exit}' "$workdir/host.pub")
  [[ -n "$host_key" ]] || fail "no ed25519 host key could be read from $machine_vm"
  "$labctl" ssh "$controller_vm" -- "
set -e
install -d -m 0700 /etc/your-cloud/command-endpoints
printf '%s' '{\"schema_version\":1,\"machine_id\":\"$machine_vm\",\"host\":\"$machine_address\",\"port\":22,\"account\":\"your-cloud-auxiliary\",\"host_key\":\"$host_key\"}' \
  >/etc/your-cloud/command-endpoints/$machine_vm.json
chmod 0600 /etc/your-cloud/command-endpoints/$machine_vm.json"

  # The allowed source is one exact address, and the product refuses anything
  # wider: the Console's own, and nothing else on this network.
  printf '%s' "$controller_address" >"$carried/controller-address"
  serve_controller open
  echo "  the Controller's one-time sheet is carried, and it expires by itself"
}

# --------------------------------------------------------------------------
# console — the candidate, built and installed on the human's machine.
# --------------------------------------------------------------------------
mount_console() {
  local console_address
  console_address=$(inventory "$console_vm")
  announce "syncing the console sources to $console_vm — $console_address"
  # `-m` re-stamps every file to now, so the build caches that survive under
  # `target/` can never mistake an older synced file for an already-built one.
  tar czf "$workdir/console.tgz" -C "$root" \
    --exclude=console/node_modules \
    --exclude=console/dist \
    --exclude=console/dist-reflow \
    --exclude=console/src-tauri/target \
    --exclude=console/src-tauri/binaries \
    console
  "$labctl" ssh "$console_vm" -- "install -d -m 0700 /root/your-cloud-console-build"
  "$labctl" copy-to "$console_vm" "$workdir/console.tgz" /root/your-cloud-console-build/console.tgz >/dev/null
  "$labctl" ssh "$console_vm" -- "
set -e
tar xzf /root/your-cloud-console-build/console.tgz -C /root/your-cloud-console-build -m --strip-components=1
rm -f /root/your-cloud-console-build/console.tgz"

  announce "building and installing the candidate on $console_vm (offline, one job)"
  # The swap this build needs does not come back by itself after a boot, and a
  # release build of the Tauri stack without it ends in the OOM reaper rather
  # than in a candidate.
  "$labctl" ssh "$console_vm" -- "swapon /swapfile 2>/dev/null || true"
  deploy "$console_vm" common run inside console-oracle.py build
  "$labctl" ssh "$console_vm" -- "$remote_harness/build"
}

# --------------------------------------------------------------------------
# associate — the real Console, driven, against that real Controller.
# --------------------------------------------------------------------------
associate() {
  local console_address controller_address infrastructure_id
  console_address=$(inventory "$console_vm")
  [[ -s "$carried/window.json" ]] || fail "no enrolment sheet is carried; run the controller phase first"
  controller_address=$(cat "$carried/controller-address")
  infrastructure_id=$(cat "$carried/infrastructure-id")

  # The LAB carries no resolver, and the origins the Controller writes into its
  # own sheet are names. The name is pointed at the machine that really serves
  # it; nothing of the product is changed to fit the LAB.
  announce "pointing the Controller's own names at $controller_address"
  "$labctl" ssh "$console_vm" -- "
set -e
name=controller.$infrastructure_id.your-cloud.test
sed -i \"/ \$name\$/d\" /etc/hosts
printf '%s %s\n' '$controller_address' \"\$name\" >>/etc/hosts
getent hosts \"\$name\""

  # The sheet the Controller wrote when it was started with a window open. It
  # is carried the way a human carries it, and it expires by itself.
  "$labctl" copy-to "$console_vm" "$carried/window.json" "$remote_harness/window.json" >/dev/null

  announce "driving the installed Console to its association"
  "$labctl" ssh "$console_vm" -- "$remote_harness/run associate $remote_harness/window.json"

  # And the window closes behind it. This is not tidiness: a Controller holding
  # an active device refuses to open a second enrolment window and exits, so a
  # perimeter left with `--window` cannot be restarted at all afterwards.
  announce "closing the enrolment window: one Console, one association"
  serve_controller closed
}

# serve_controller <open|closed> — the two shapes the product really has.
serve_controller() {
  local window=$1 controller_address machine_address console_address
  controller_address=$(inventory "$controller_vm")
  machine_address=$(inventory "$machine_vm")
  console_address=$(inventory "$console_vm")
  "$labctl" ssh "$controller_vm" -- "$remote_harness/install-controller serve \
    $remote_harness/creds $console_address/32 $controller_address $machine_address $window"
  if [[ "$window" == open ]]; then
    "$labctl" copy-from "$controller_vm" "$remote_state/window.json" "$carried/window.json" >/dev/null
    chmod 0600 "$carried/window.json"
  fi
}

# --------------------------------------------------------------------------
# relay — the gate a machine enters the inventory through.
# --------------------------------------------------------------------------
mount_relay() {
  local controller_address
  controller_address=$(inventory "$controller_vm")
  announce "standing the Relay and the Daemon up on $machine_vm"
  deploy "$machine_vm" common install-machine
  "$labctl" ssh "$machine_vm" -- "
set -e
install -d -m 0755 /usr/local/lib/your-cloud
install -m 0755 $remote_build/your-cloud /usr/local/lib/your-cloud/your-cloud
install -d -m 0700 $remote_build/relay-credentials
cp $remote_build/pki/relay/relay.crt $remote_build/pki/relay/relay.key \
   $remote_build/pki/relay/relay-reader.crt $remote_build/pki/relay/relay-reader.key \
   $remote_build/pki/relay/relay-reader.json $remote_build/pki/relay/enrollment.json \
   $remote_build/pki/relay/daemon-ca.crt $remote_build/pki/relay/controller-reader-ca.crt \
   $remote_build/relay-credentials/
cp $remote_build/pki/machine-1/daemon.crt $remote_build/pki/machine-1/daemon.key \
   $remote_build/pki/machine-1/relay-ca.crt $remote_build/relay-credentials/"
  "$labctl" ssh "$machine_vm" -- \
    "$remote_harness/install-machine relay $remote_build/relay-credentials $controller_address"
}

# --------------------------------------------------------------------------
# enrol — the anchor carries the real approval key of the real Console, which
# is why this phase can only run after the association.
# --------------------------------------------------------------------------
enrol_machine() {
  local infrastructure_id human_key public
  infrastructure_id=$(cat "$carried/infrastructure-id")

  announce "reading the approval key the real Console published to this Controller"
  human_key=$("$labctl" ssh "$controller_vm" -- \
    "python3 -c 'import json;print(json.load(open(\"/var/lib/private/your-cloud-controller/identity.json\"))[\"active\"][\"human_public_key\"])'" \
    | tr -d '\r\n')
  [[ -n "$human_key" ]] || fail "this Controller holds no active device: the Console never associated"
  echo "  the machine will accept approvals from this key, and no other"

  # The anchor is composed here from the Controller's own device record. In
  # production the Assistant writes it during the enrolment; that path is
  # `#126`'s and is proven by `machine-identity`. It is upstream of the command
  # path rather than on it, and the report says so.
  printf '{"schema_version":1,"infrastructure_id":"%s","machine_id":"%s","approval_epoch":1,"approval_public_key":"%s"}' \
    "$infrastructure_id" "$machine_vm" "$human_key" >"$workdir/anchor.json"

  # The forced-command entry and the elevation rule are rendered by the
  # product's own module, through the contract-test binary that exposes it —
  # never composed by this harness. It is built from this run's sources.
  announce "rendering the entry and the elevation rule with the product's own module"
  "$labctl" ssh "$console_vm" -- "
set -e
. /root/.cargo/env
cd /root/your-cloud-console-build/src-tauri
export CARGO_BUILD_JOBS=1 LC_ALL=C.UTF-8
cargo +1.94.1 build --locked --offline -j 1 -p your-cloud-native-bootstrap-assistant \
  --features machine-identity-contract-test --bin your-cloud-machine-identity-fixture >/dev/null 2>&1
install -m 0700 target/debug/your-cloud-machine-identity-fixture $remote_harness/identity-fixture"

  public=$(cat "$carried/command-public-key")
  "$labctl" ssh "$console_vm" -- \
    "$remote_harness/identity-fixture render-entry $public" >"$workdir/entry"
  "$labctl" ssh "$console_vm" -- \
    "$remote_harness/identity-fixture render-elevation" >"$workdir/sudoers"
  [[ -s "$workdir/entry" && -s "$workdir/sudoers" ]] \
    || fail "the product's own module rendered no entry or no elevation rule"

  announce "enrolling $machine_vm in the order the contract fixes"
  local file
  for file in anchor.json entry sudoers; do
    "$labctl" copy-to "$machine_vm" "$workdir/$file" "$remote_harness/$file" >/dev/null
  done
  "$labctl" ssh "$machine_vm" -- "$remote_harness/install-machine enrol \
    $remote_harness/anchor.json $remote_harness/entry $remote_harness/sudoers"
}

# --------------------------------------------------------------------------
# attach — from the Console's own Parc view, through the Relay's snapshot.
# --------------------------------------------------------------------------
attach_machine() {
  announce "attaching $machine_vm to the inventory, from the Console"
  "$labctl" ssh "$console_vm" -- \
    "$remote_harness/run attach $remote_harness/window.json $machine_vm"
}

# --------------------------------------------------------------------------
# origin — this run's image, its origin, and the ground a user service needs.
#
# Everything here is the environment rather than the product, and it is the
# apparatus `v0.1.1` already proved rather than a second one. What is kept is
# what a user service really uses: rootless Podman, the Quadlet unit the
# Auxiliary writes, the digest it verifies, and a service that answers.
# --------------------------------------------------------------------------
mount_origin() {
  local controller_address
  controller_address=$(inventory "$controller_vm")

  announce "building this run's application, its image and the authority that signs the origin"
  "$labctl" copy-to "$machine_vm" "$root/tests/lab/v0.1.1/user-service/_fixture/main.go" \
    "$remote_build/labfixture-main.go" >/dev/null
  "$labctl" copy-to "$machine_vm" "$root/tests/lab/v0.1.1/user-service/_app/main.go" \
    "$remote_build/labapp-main.go" >/dev/null
  "$labctl" ssh "$machine_vm" -- "
set -e
export PATH=\$PATH:/usr/local/go/bin LC_ALL=C.UTF-8
cd $remote_build
install -d labfixture labapp bin
mv labfixture-main.go labfixture/main.go
mv labapp-main.go labapp/main.go
# The binaries go under bin/ and not beside the packages: `go build -o` onto a
# path a source directory already occupies fails « is a directory », and this
# module root already holds the packages named after them.
go build -o $remote_build/bin/labfixture ./labfixture
CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o $remote_build/bin/synthetic-app ./labapp
rm -rf authority issued image
./bin/labfixture -authority -authority-directory $remote_build/authority
chmod 0700 authority
./bin/labfixture -issue -authority-directory $remote_build/authority -out $remote_build/issued \
  -route-host $origin_host
./bin/labfixture -image-build -binary $remote_build/bin/synthetic-app -out $remote_build/image >/dev/null
cat $remote_build/image/manifest.digest"
  "$labctl" copy-from "$machine_vm" "$remote_build/image/manifest.digest" "$carried/image-digest" >/dev/null
  local digest
  digest=$(tr -d '\r\n' <"$carried/image-digest")
  [[ "$digest" == sha256:* ]] || fail "the image build reported no digest"
  echo "  the image this run pins: $origin_repository@$digest"

  announce "serving the origin from $controller_vm, and grounding $machine_vm for it"
  tar_from_machine origin.tgz "image issued authority/authority.crt"
  "$labctl" ssh "$controller_vm" -- "install -d -m 0700 $remote_origin"
  "$labctl" copy-to "$controller_vm" "$workdir/origin.tgz" "$remote_origin/origin.tgz" >/dev/null
  "$labctl" copy-from "$machine_vm" "$remote_build/bin/labfixture" "$workdir/labfixture" >/dev/null
  "$labctl" copy-to "$controller_vm" "$workdir/labfixture" "$remote_origin/fixture" >/dev/null
  "$labctl" ssh "$controller_vm" -- "
set -e
cd $remote_origin
tar xzf origin.tgz && rm -f origin.tgz
chmod 0700 fixture
cp issued/$origin_host.crt origin.crt
cp issued/$origin_host.key origin.key
$remote_origin/serve-origin start"

  "$labctl" copy-from "$machine_vm" "$remote_build/authority/authority.crt" "$carried/authority.crt" >/dev/null
  "$labctl" copy-to "$machine_vm" "$carried/authority.crt" "$remote_harness/authority.crt" >/dev/null
  "$labctl" ssh "$machine_vm" -- \
    "$remote_harness/install-machine ground $controller_address $remote_harness/authority.crt"

  # The fetch is read before any plan depends on it: a pull that fails later
  # would otherwise be indistinguishable from a machine that refused.
  "$labctl" ssh "$machine_vm" -- "
code=\$(curl -sS -o /dev/null -w '%{http_code}' \
  'https://$origin_host/v2/lab/synthetic-app/manifests/$digest' \
  -H 'Accept: application/vnd.oci.image.manifest.v1+json')
[ \"\$code\" = 200 ] || { echo \"FAILED: the origin answered \$code for this run's digest\" >&2; exit 1; }
echo '  the machine reaches this run'\''s image by digest, over the run'\''s own TLS'"
}

# tar_from_machine <name> <paths> — carry a tree off the machine that built it.
tar_from_machine() {
  local name=$1 paths=$2
  "$labctl" ssh "$machine_vm" -- "tar -C $remote_build -czf $remote_build/$name $paths"
  "$labctl" copy-from "$machine_vm" "$remote_build/$name" "$workdir/$name" >/dev/null
}

# --------------------------------------------------------------------------
# journey — the whole path, twice.
#
# The failure comes first and it is deliberate rather than incidental: a
# digest no origin serves proves the path reaches the machine, that the
# Auxiliary refuses what it cannot verify, that it rolls back, and that its
# report climbs back through the channel the Controller opened. A success
# alone could not tell « the machine applied » from « nothing was checked ».
# --------------------------------------------------------------------------
run_journey() {
  local digest absent
  digest=$(tr -d '\r\n' <"$carried/image-digest")
  absent=sha256:$(printf 'a%.0s' {1..64})

  announce "the failure that reaches the machine and comes back"
  "$labctl" ssh "$console_vm" -- "$remote_harness/run journey $remote_harness/window.json \
    $machine_vm $absent journal-manquant"
  read_dispatch "rolled_back_after_controlled_failure" 1 "the controlled failure"

  announce "the success that really poses a service"
  "$labctl" ssh "$console_vm" -- "$remote_harness/run journey $remote_harness/window.json \
    $machine_vm $digest journal-de-bord"
  read_dispatch "applied" 2 "the applied deployment"
}

# read_dispatch <expected outcome> <expected sequence> <label> — the Controller's
# own record, read from the machine that holds it, never from what the Console
# displayed.
#
# The sequence is asserted as well as the outcome, and that is the anti-replay
# position made observable: the second journey may only be the **successor** of
# the position the machine itself reported consuming in the first.
read_dispatch() {
  local expected=$1 sequence=$2 label=$3 outcome
  # One line, deliberately: a multi-line program handed to `ssh` is re-split by
  # the remote shell, and a probe that breaks on quoting reads like a red.
  outcome=$("$labctl" ssh "$controller_vm" -- \
    "python3 -c \"import json,sys; r=json.load(open('/var/lib/private/your-cloud-controller/dispatches.json'))['records'][-1]; print(r['state'], r['reported_outcome'], r['sequence'])\"")
  echo "  the Controller's own record: $outcome"
  case "$outcome" in
    "reported $expected $sequence") ;;
    *) fail "$label concluded « $outcome » rather than « reported $expected $sequence »" ;;
  esac
}

# --------------------------------------------------------------------------
# verify — the service, read from outside the product.
# --------------------------------------------------------------------------
verify_service() {
  local digest
  digest=$(tr -d '\r\n' <"$carried/image-digest")
  announce "reading the posed service from outside the product"
  "$labctl" ssh "$machine_vm" -- "
set -e
unit=/var/lib/$service_account/.config/containers/systemd/$service_account.container
[ -f \$unit ] || { echo 'FAILED: the Auxiliary wrote no Quadlet unit' >&2; exit 1; }
grep -q 'Image=$origin_repository@$digest' \$unit \
  || { echo 'FAILED: the unit does not pin the digest the human approved' >&2; exit 1; }
grep -q 'PublishPort=127.0.0.1:$service_port:' \$unit \
  || { echo 'FAILED: the unit does not publish the port the plan named' >&2; exit 1; }
grep -q 'Tmpfs=$scratch_directory' \$unit \
  || { echo 'FAILED: the tmpfs of the frozen definition did not reach the unit' >&2; exit 1; }
echo '  the unit pins the approved digest, the named port and the declared tmpfs'
answer=\$(curl -sS --max-time 15 http://127.0.0.1:$service_port/)
printf '%s\n' \"\$answer\" | grep -q 'slug=$service_slug' \
  || { echo \"FAILED: the service answered without naming its slug: \$answer\" >&2; exit 1; }
# The application refuses to serve when the scratch its definition declares is
# absent, so this line is the definition arriving rather than a formality.
printf '%s\n' \"\$answer\" | grep -q 'scratch=writable' \
  || { echo \"FAILED: the service does not hold the scratch its definition declared: \$answer\" >&2; exit 1; }
echo '  the service answers, names its slug, and holds the scratch it was given'"
}

collect() {
  announce "collecting the structured results"
  install -d -m 0755 "$result_root/$run_id"
  "$labctl" copy-from "$console_vm" "$remote_harness/output" "$workdir/collected" >/dev/null 2>&1 || true
  local produced="$workdir/collected"
  [[ -d "$produced" ]] || produced="$workdir/collected/output"
  [[ -d "$produced" ]] && cp -a "$produced/." "$result_root/$run_id/" || true
  chmod -R u+rw "$result_root/$run_id" 2>/dev/null || true
  echo "  under: $result_root/$run_id/"
}

remove() {
  local status=0
  announce "removing the perimeter from the three machines"
  # The origin first, and by its own script rather than by a `pkill`: it is a
  # `setsid` listener that outlives the session that started it, so a pass that
  # forgot it would leave a machine serving an image to whatever comes next.
  # `stop` asserts the silence rather than reporting one it did not verify.
  "$labctl" ssh "$controller_vm" -- \
    "test -x $remote_origin/serve-origin && $remote_origin/serve-origin stop || true" || status=1
  "$labctl" ssh "$controller_vm" -- "
systemctl disable --now your-cloud-controller.service 2>/dev/null || true
rm -f /etc/systemd/system/your-cloud-controller.service
systemctl daemon-reload 2>/dev/null || true
# The private halves of the command identities are destroyed, not merely
# unlinked: they are the one secret this perimeter ever held.
if [ -d /etc/your-cloud/command-identities ]; then
  find /etc/your-cloud/command-identities -type f -exec shred -u {} + 2>/dev/null || true
fi
rm -rf /etc/your-cloud/command-identities /etc/your-cloud/command-endpoints \
  /etc/your-cloud/controller-reader.crt /etc/your-cloud/controller-reader.key \
  /etc/your-cloud/relay-reader-ca.crt /var/lib/private/your-cloud-controller \
  /var/lib/your-cloud-controller $remote_harness $remote_state $remote_origin" || status=1

  # The machine gives back everything: the Relay and the Daemon, the service
  # this run really posed, the two harness acts, and the enrolment.
  #
  # **This dismantling is the harness's, not the product's**, and the report
  # says so: returning a machine by an approved `remove_user_service` plan
  # would be a second journey and a stronger constat, and it is named as the
  # next one to write rather than quietly skipped. What is asserted here is
  # only that the machine is given back, not that the product knows how to
  # give it back — that belongs to `v0.1.1`, which proved it.
  "$labctl" ssh "$machine_vm" -- "
systemctl disable --now your-cloud-relay.service your-cloud-daemon.service 2>/dev/null || true
rm -f /etc/systemd/system/your-cloud-relay.service /etc/systemd/system/your-cloud-daemon.service
systemctl daemon-reload 2>/dev/null || true
if id $service_account >/dev/null 2>&1; then
  loginctl disable-linger $service_account 2>/dev/null || true
  pkill -9 -u $service_account 2>/dev/null || true
  sleep 2
  userdel -r -f $service_account 2>/dev/null || true
fi
/usr/sbin/nft delete table inet your-cloud-egress 2>/dev/null || true
rm -f /usr/local/share/ca-certificates/lab-command-path-authority.crt
update-ca-certificates --fresh >/dev/null 2>&1 || true
sed -i '/ $origin_host\$/d' /etc/hosts
rm -f /etc/ssh/sshd_config.d/60-your-cloud-command-path.conf
sshd -t >/dev/null 2>&1 && systemctl reload ssh >/dev/null 2>&1 || true
rm -rf /etc/your-cloud /var/lib/your-cloud-auxiliary /usr/lib/your-cloud \
  /usr/local/lib/your-cloud /etc/systemd/system/your-cloud-egress-rules.service \
  $remote_build $remote_build.tgz $remote_harness" || status=1
  # The candidate, the harness, and the name this run pointed at a Controller.
  #
  # The build tree is *shared* with the reflow proof at the same path and both
  # sync the same sources there, so it is not deleted: a cold release build of
  # the Tauri stack costs over an hour on this machine. What is deleted is the
  # part that is pure output and cheap to remake — the `.deb` bundle — and the
  # free space is printed, because the failure this hygiene exists for did not
  # look like a disk problem: on 12 August 2026 the build succeeded and the
  # install died on « No space left on device », an hour after the cause.
  "$labctl" ssh "$console_vm" -- "
dpkg --purge your-cloud >/dev/null 2>&1 || true
rm -rf $remote_harness
rm -rf /root/your-cloud-console-build/src-tauri/target/release/bundle
sed -i '/your-cloud.test\$/d' /etc/hosts
printf '  free space on the pilot after this pass: %s MiB\n' \"\$((\$(df --output=avail -k / | tail -1) / 1024))\"" || status=1
  rm -rf "$carried"
  local pair vm path
  for pair in "$controller_vm $remote_harness" "$controller_vm /etc/your-cloud/command-identities" \
    "$controller_vm $remote_origin" "$machine_vm $remote_build" \
    "$machine_vm /etc/your-cloud/approval-anchor.json" \
    "$machine_vm /var/lib/your-cloud-auxiliary" "$console_vm $remote_harness"; do
    read -r vm path <<<"$pair"
    "$labctl" ssh "$vm" -- "test ! -e $path" \
      || { echo "FAILED: $path is still present in $vm" >&2; status=1; }
  done
  [[ $status -eq 0 ]] || fail "the perimeter removal is not proven"
  echo "  perimeter removed from the three machines"
}

case "$command" in
  artifact) build_artifact ;;
  controller) mount_controller ;;
  console) mount_console ;;
  associate) associate ;;
  relay) mount_relay ;;
  enrol) enrol_machine ;;
  attach) attach_machine ;;
  origin) mount_origin ;;
  journey) run_journey ;;
  verify) verify_service ;;
  collect) collect ;;
  remove) remove ;;
  all)
    # The order is the order of authorities, and not one step of it is a
    # convenience: the Console cannot associate before a Controller serves with
    # a window, the anchor cannot be posed before the Console has published the
    # key it will carry, a machine cannot enter the inventory before the Relay
    # reports it, and no plan can be approved for a machine outside it.
    status=0
    step() {
      [[ $status -eq 0 ]] || return 0
      "$@" || status=$?
    }
    step build_artifact
    step mount_controller
    step mount_console
    step associate
    step mount_relay
    step enrol_machine
    step attach_machine
    step mount_origin
    step run_journey
    step verify_service
    collect || true
    # Removal always runs, red or green: a perimeter left behind is a machine
    # that lies to the next proof.
    remove || status=${status:-1}
    [[ $status -eq 0 ]] || fail "the command-path proof failed with $status"
    echo
    echo "PROVE_COMMAND_PATH_OK revision=$(revision)"
    ;;
esac
