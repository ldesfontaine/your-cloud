#!/usr/bin/env bash
# Open the virtual screen the Console really paints on, then hand over to
# `inside`.
#
# `-noreset` is not decoration. Without it the X server regenerates between two
# short-lived clients and a driver that reconnects mid-run finds a different
# display; the same string is used by the hosted gate, by the personal-access
# proof and by the reflow proof, and it is kept identical on purpose.
#
# The screen matters more here than in any earlier proof: the native approval
# window is a **second client** of this same server, and the only reason this
# harness can answer it at all is that both the Console and its helper paint on
# one display that outlives either of them.
set -euo pipefail
export LC_ALL=C.UTF-8

here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# The X server's own errors are kept: when it dies, `xvfb-run` tears the
# clients down by signal and nothing else survives to say why.
install -d -m 0755 "$here/output"

# Le bus de session est publié SUR LA RACINE X, et non posé en variable — la
# différence décide de cette preuve.
#
# Le produit efface l'environnement du helper et ne lui repasse qu'une liste
# blanche explicite, où `DBUS_SESSION_BUS_ADDRESS` ne figure pas : c'est une
# décision de sécurité, pas un oubli. Le helper ne peut donc trouver un bus que
# par l'autre voie, celle que GTK emprunte sur un poste réel — la propriété
# `_DBUS_SESSION_BUS_ADDRESS` de la fenêtre racine, publiée par `dbus-launch`.
#
# `dbus-run-session`, lui, ne publie rien sur X : il ne pose que la variable,
# précisément celle que le produit efface. Le helper autospawnait alors son
# propre `dbus-launch`, qui restait dans SON groupe de processus et lui
# survivait — et le produit refusait à raison un succès dont le groupe n'était
# pas vide. Mesuré le 19 août 2026 : un seul survivant, `dbus-launch
# --autolaunch`, pgid du helper.
#
# L'ordre compte donc : X d'abord, le bus publié dedans ensuite. Le harnais
# offre ainsi ce qu'une session graphique offre, et la garde du produit reste
# entière — un vrai enfant survivant échoue toujours.
exec xvfb-run -a -e "$here/output/xvfb-errors.log" \
  -s "-screen 0 1280x1024x24 -noreset" \
  env NO_AT_BRIDGE=1 dbus-launch --exit-with-session "$here/inside" "$@"
