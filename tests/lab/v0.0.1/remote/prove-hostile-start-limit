#!/usr/bin/env bash
# Prove fail-closed Relay restart exhaustion and explicit systemd recovery.
set -euo pipefail

[[ $# -eq 0 ]] || { echo "usage: prove-hostile-start-limit" >&2; exit 2; }
[[ $(id -u) -eq 0 ]] || { echo "prove-hostile-start-limit must run as root" >&2; exit 1; }
[[ $(hostname) == lab-coordinateur ]] || { echo "start-limit proof requires lab-coordinateur" >&2; exit 1; }

unit=your-cloud-relay.service
candidate=/etc/your-cloud/relay-candidate.json
valid_candidate='{"schema":1,"role":"relay-candidate"}'
failed=1
cursor_file=$(mktemp)

recover() {
  local status=$?
  trap - EXIT
  if [[ $failed -ne 0 ]]; then
    printf '%s\n' "$valid_candidate" | install -o root -g root -m 0644 /dev/stdin "$candidate" || status=1
    systemctl reset-failed "$unit" >/dev/null 2>&1 || status=1
    systemctl restart "$unit" >/dev/null 2>&1 || status=1
  fi
  rm -f "$cursor_file"
  exit "$status"
}
trap recover EXIT

install -o root -g root -m 0666 /dev/null "$candidate"
printf '%s\n' "$valid_candidate" >"$candidate"
systemctl reset-failed "$unit"
journalctl -u "$unit" -n 0 --show-cursor --no-pager \
  | sed -n 's/^-- cursor: //p' >"$cursor_file"
[[ -s "$cursor_file" ]] || { echo "journal cursor was not produced" >&2; exit 1; }

start_limit_hit=0
for _ in $(seq 1 8); do
  systemctl restart "$unit" >/dev/null 2>&1 || true
  if journalctl -u "$unit" --after-cursor "$(cat "$cursor_file")" -o cat --no-pager \
    | grep -Fq 'Start request repeated too quickly'; then
    start_limit_hit=1
    break
  fi
done
[[ $start_limit_hit -eq 1 ]] || {
  echo "Relay did not reach the systemd start-limit-hit boundary" >&2
  exit 1
}
[[ $(systemctl show "$unit" --property=ActiveState --value) == failed ]] \
  || { echo "Relay is not failed after start-limit-hit" >&2; exit 1; }
[[ -z $(ss -H -ltn 'sport = :8443') ]] \
  || { echo "Relay listener survived the invalid manifest" >&2; exit 1; }
[[ $(systemctl show your-cloud-daemon.service --property=ActiveState --value) == active ]] \
  || { echo "colocated Daemon did not remain active" >&2; exit 1; }

printf '%s\n' "$valid_candidate" | install -o root -g root -m 0644 /dev/stdin "$candidate"
if systemctl start "$unit" >/dev/null 2>&1; then
  echo "Relay restarted without reset-failed after start-limit-hit" >&2
  exit 1
fi
systemctl reset-failed "$unit"
systemctl restart "$unit"

for _ in $(seq 1 8); do
  [[ $(systemctl show "$unit" --property=ActiveState --value) != active ]] || break
  sleep 1
done
[[ $(systemctl show "$unit" --property=ActiveState --value) == active ]] \
  || { echo "Relay did not recover after reset-failed" >&2; exit 1; }

failed=0
printf 'PASS: invalid candidate reached start-limit-hit; reset-failed restored the Relay\n'
