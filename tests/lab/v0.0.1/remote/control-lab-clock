#!/usr/bin/env bash
# Apply and transactionally restore one bounded LAB wall-clock change.
set -euo pipefail

[[ $# -ge 1 ]] || { echo "usage: control-lab-clock <apply|restore|restore-if-active|verify-restored> [epoch] [reference-epoch]" >&2; exit 2; }
action=$1
[[ $(id -u) -eq 0 ]] || { echo "control-lab-clock must run as root" >&2; exit 1; }
case $(hostname) in
  lab-machine-1|lab-coordinateur) ;;
  *) echo "clock control requires lab-machine-1 or lab-coordinateur" >&2; exit 1 ;;
esac
command -v timeout >/dev/null || { echo "timeout is required" >&2; exit 1; }

state=/run/your-cloud-v0.0.1-proof-clock-state
saved_host=
saved_ntp=
saved_synchronized=
saved_wall_epoch=
saved_monotonic_seconds=

monotonic_seconds() {
  local value
  read -r value _ </proc/uptime || return 1
  value=${value%%.*}
  [[ "$value" =~ ^[0-9]+$ ]] || { echo "cannot read monotonic uptime" >&2; return 1; }
  printf '%s\n' "$value"
}

read_epoch() {
  timeout --signal=TERM --kill-after=2s 5s date -u +%s
}

timedate_value() {
  local property=$1
  timeout --signal=TERM --kill-after=2s 5s \
    timedatectl show --property="$property" --value
}

set_ntp() {
  timeout --signal=TERM --kill-after=2s 10s timedatectl set-ntp "$1"
}

set_epoch() {
  timeout --signal=TERM --kill-after=2s 10s date -u --set="@$1" >/dev/null
}

load_state() {
  local path=${1:-$state} owner_mode current_host
  local -a lines
  saved_host=
  saved_ntp=
  saved_synchronized=
  saved_wall_epoch=
  saved_monotonic_seconds=
  [[ -f "$path" && ! -L "$path" ]] || { echo "controlled clock state is missing or unsafe" >&2; return 1; }
  owner_mode=$(stat -c '%U:%G:%a:%h' "$path") || return 1
  [[ "$owner_mode" == root:root:600:1 ]] \
    || { echo "controlled clock state metadata is unsafe" >&2; return 1; }
  mapfile -t lines <"$path" || return 1
  [[ ${#lines[@]} -eq 5 ]] || { echo "controlled clock state schema is not exact" >&2; return 1; }
  [[ "${lines[0]}" == HOST=* && "${lines[1]}" == NTP=yes \
    && ( "${lines[2]}" == NTPSYNCHRONIZED=yes || "${lines[2]}" == NTPSYNCHRONIZED=no ) \
    && "${lines[3]}" == WALL_EPOCH=* \
    && "${lines[4]}" == MONOTONIC_SECONDS=* ]] \
    || { echo "controlled clock state fields are invalid or out of order" >&2; return 1; }
  saved_host=${lines[0]#HOST=}
  saved_ntp=${lines[1]#NTP=}
  saved_synchronized=${lines[2]#NTPSYNCHRONIZED=}
  saved_wall_epoch=${lines[3]#WALL_EPOCH=}
  saved_monotonic_seconds=${lines[4]#MONOTONIC_SECONDS=}
  current_host=$(hostname)
  [[ "$saved_host" == "$current_host" ]] || { echo "controlled clock state belongs to another host" >&2; return 1; }
  [[ "$saved_ntp" == yes && ( "$saved_synchronized" == yes || "$saved_synchronized" == no ) ]] \
    || { echo "controlled clock state lost its NTP precondition" >&2; return 1; }
  [[ "$saved_wall_epoch" =~ ^[0-9]{10}$ && "$saved_monotonic_seconds" =~ ^[0-9]+$ ]] \
    || { echo "controlled clock state trajectory is invalid" >&2; return 1; }
}

write_state_atomically() {
  local host=$1 synchronized=$2 wall=$3 monotonic=$4 temporary
  temporary=$(mktemp /run/.your-cloud-v0.0.1-proof-clock-state.XXXXXX) || return 1
  if ! chmod 0600 "$temporary" \
    || ! chown root:root "$temporary" \
    || ! printf 'HOST=%s\nNTP=yes\nNTPSYNCHRONIZED=%s\nWALL_EPOCH=%s\nMONOTONIC_SECONDS=%s\n' \
      "$host" "$synchronized" "$wall" "$monotonic" >"$temporary" \
    || ! load_state "$temporary"; then
    /bin/rm -f "$temporary"
    return 1
  fi
  # A hard link publishes the fully validated inode only if the fixed state
  # path does not already exist. Unlike a check followed by mv, it cannot
  # replace a concurrent proof's restoration trajectory.
  if [[ -e "$state" || -L "$state" ]] || ! /bin/ln -- "$temporary" "$state"; then
    /bin/rm -f "$temporary"
    echo "cannot publish controlled clock state" >&2
    return 1
  fi
  if ! /bin/rm -f "$temporary" || ! load_state "$state"; then
    /bin/rm -f "$state" "$temporary"
    echo "cannot finalize controlled clock state" >&2
    return 1
  fi
}

wait_for_synchronization() {
  local attempt ntp synchronized
  for attempt in $(seq 1 12); do
    ntp=$(timedate_value NTP) || ntp=unknown
    synchronized=$(timedate_value NTPSynchronized) || synchronized=unknown
    if [[ "$ntp" == yes && "$synchronized" == yes ]]; then
      return 0
    fi
    [[ $attempt -eq 12 ]] || sleep 1
  done
  echo "NTP did not return to the synchronized state within the fixed window" >&2
  return 1
}

epoch_is_close() {
  local actual=$1 expected=$2 tolerance=$3 difference
  [[ "$actual" =~ ^[0-9]{10}$ && "$expected" =~ ^[0-9]{10}$ ]] || return 1
  difference=$((actual - expected))
  (( difference < 0 )) && difference=$((-difference))
  (( difference <= tolerance ))
}

restore_clock() {
  local current_monotonic elapsed target restored_epoch restored_ntp verification_monotonic expected_now
  if ! load_state; then return 1; fi
  if ! current_monotonic=$(monotonic_seconds); then return 1; fi
  if (( current_monotonic < saved_monotonic_seconds )); then
    echo "monotonic clock moved backwards" >&2
    return 1
  fi
  elapsed=$((current_monotonic - saved_monotonic_seconds))
  target=$((saved_wall_epoch + elapsed))
  if ! set_ntp false; then return 1; fi
  if ! set_epoch "$target"; then return 1; fi
  if ! set_ntp true; then return 1; fi
  if ! restored_ntp=$(timedate_value NTP) || [[ "$restored_ntp" != yes ]]; then
    echo "NTP was not re-enabled during restoration" >&2
    return 1
  fi
  if [[ "$saved_synchronized" == yes ]] && ! wait_for_synchronization; then return 1; fi
  if ! verification_monotonic=$(monotonic_seconds); then return 1; fi
  if (( verification_monotonic < saved_monotonic_seconds )); then
    echo "monotonic clock moved backwards during restoration" >&2
    return 1
  fi
  expected_now=$((saved_wall_epoch + verification_monotonic - saved_monotonic_seconds))
  if ! restored_epoch=$(read_epoch) || ! epoch_is_close "$restored_epoch" "$expected_now" 10; then
    echo "original wall-clock trajectory was not restored" >&2
    return 1
  fi
  if ! /bin/rm -f "$state" || [[ -e "$state" || -L "$state" ]]; then
    echo "controlled clock state could not be removed after verified restoration" >&2
    return 1
  fi
}

apply_clock() {
  local target=$1 reference=$2 host original_ntp original_synchronized original_wall
  local original_monotonic delta current_ntp applied_epoch
  [[ "$target" =~ ^[0-9]{10}$ ]] || { echo "apply requires a target epoch" >&2; return 2; }
  [[ "$reference" =~ ^[0-9]{10}$ ]] || { echo "apply requires an independent reference epoch" >&2; return 2; }
  [[ ! -e "$state" && ! -L "$state" ]] \
    || { echo "a controlled clock change is already active or unsafe" >&2; return 1; }
  host=$(hostname)
  original_ntp=$(timedate_value NTP) || return 1
  original_synchronized=$(timedate_value NTPSynchronized) || return 1
  [[ "$original_ntp" == yes && ( "$original_synchronized" == yes || "$original_synchronized" == no ) ]] \
    || { echo "clock proof requires NTP to be enabled before mutation" >&2; return 1; }
  original_wall=$(read_epoch) || return 1
  epoch_is_close "$original_wall" "$reference" 15 \
    || { echo "local clock differs from the independent LAB reference" >&2; return 1; }
  original_monotonic=$(monotonic_seconds) || return 1
  delta=$((target - original_wall))
  (( delta < 0 )) && delta=$((-delta))
  (( delta >= 172700 && delta <= 172900 )) \
    || { echo "requested clock change is outside the controlled two-day bound" >&2; return 1; }
  write_state_atomically "$host" "$original_synchronized" "$original_wall" "$original_monotonic" || return 1

  if ! set_ntp false \
    || ! current_ntp=$(timedate_value NTP) \
    || [[ "$current_ntp" != no ]] \
    || ! set_epoch "$target" \
    || ! applied_epoch=$(read_epoch) \
    || ! epoch_is_close "$applied_epoch" "$target" 2; then
    echo "clock change failed; attempting immediate restoration" >&2
    if ! restore_clock; then
      echo "immediate clock restoration failed; state retained for outer cleanup" >&2
    fi
    return 1
  fi
}

verify_restored() {
  local reference=$1 current ntp
  [[ "$reference" =~ ^[0-9]{10}$ ]] || { echo "verify-restored requires a reference epoch" >&2; return 2; }
  [[ ! -e "$state" && ! -L "$state" ]] || { echo "controlled clock state remains after restoration" >&2; return 1; }
  ntp=$(timedate_value NTP) || return 1
  [[ "$ntp" == yes ]] || { echo "restored clock does not have NTP enabled" >&2; return 1; }
  current=$(read_epoch) || return 1
  epoch_is_close "$current" "$reference" 15 \
    || { echo "restored clock differs from the independent LAB reference" >&2; return 1; }
}

case "$action" in
  apply)
    [[ $# -eq 3 ]] || { echo "apply requires target and independent reference epochs" >&2; exit 2; }
    apply_clock "$2" "$3"
    ;;
  restore)
    [[ $# -eq 1 ]] || { echo "restore takes no epoch" >&2; exit 2; }
    restore_clock
    ;;
  restore-if-active)
    [[ $# -eq 1 ]] || { echo "restore-if-active takes no epoch" >&2; exit 2; }
    if [[ -e "$state" || -L "$state" ]]; then restore_clock; fi
    ;;
  verify-restored)
    [[ $# -eq 2 ]] || { echo "verify-restored requires a reference epoch" >&2; exit 2; }
    verify_restored "$2"
    ;;
  *)
    echo "unknown clock action: $action" >&2
    exit 2
    ;;
esac

printf 'PASS: controlled LAB clock action=%s host=%s\n' "$action" "$(hostname)"
