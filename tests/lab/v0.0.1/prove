step controlled-clock-skew assertion "Skew emitter and Relay wall clocks while keeping freshness reception-owned"
reference_epoch=$(remote lab-console date -u +%s) \
  || fail "cannot read independent clock reference before emitter skew"
[[ "$reference_epoch" =~ ^[0-9]{10}$ ]] || fail "lab-console returned an invalid reference epoch"
emitter_apply_status=0
if remote lab-machine-1 "$remote_tests/control-lab-clock" apply \
  "$((reference_epoch - 172800))" "$reference_epoch"; then
  emitter_clock_dirty=1
else
  emitter_apply_status=$?
  emitter_clock_dirty=1
  emitter_state_status=0
  remote lab-machine-1 test -e "$remote_clock_state" || emitter_state_status=$?
  if [[ $emitter_state_status -eq 1 ]]; then
    emitter_link_status=0
    remote lab-machine-1 test -L "$remote_clock_state" || emitter_link_status=$?
    if [[ $emitter_link_status -eq 1 ]]; then
      emitter_clock_dirty=0
    fi
  fi
  echo "FAILED: emitter clock apply failed" >&2
  exit "$emitter_apply_status"
fi
