  transfer_host_key_type[$target]=$host_key_type
  transfer_host_key_blob[$target]=$host_key_blob
  lab_ssh "$target" /bin/bash "$remote_transfer_helper" target-prepare "$target_transfer_state" "$target" "$target_address" "$transfer_source_ipv6" "$artifact_sha" "$artifact_size" "$transfer_client_key_type" "$transfer_client_key_blob"
