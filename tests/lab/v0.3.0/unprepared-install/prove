#!/usr/bin/env bash
# La preuve de la milestone `v0.3.0` : une machine cible vierge et un compte
# Debian ORDINAIRE, non préparé, menés jusqu'au Controller actif.
#
# Ce que cette preuve ajoute à celle de `v0.1.3` tient en deux faits, et les
# deux étaient impossibles il y a un jour :
#
#   1. le compte est celui que l'installateur Debian produit — membre du groupe
#      `sudo`, un mot de passe, et AUCUNE ligne de sudoers écrite pour lui.
#      Lire sa politique coûte le mot de passe, ce que le produit refusait
#      jusqu'à #218 ;
#   2. l'humain approuve DEUX fois au lieu de trois (#219), et la seconde
#      fenêtre nomme ses deux actes.
#
# CE QUI EST DÉLÉGUÉ, ET POURQUOI. La construction du candidat, le périmètre
# d'accès personnel et l'écran virtuel appartiennent au harnais de `v0.1.3` et
# à celui de `v0.1.0` : les dupliquer ici donnerait deux définitions du même
# montage, et deux définitions divergent. Ce pilote n'apporte que ce qui lui
# est propre — le compte visé, l'état vierge de la cible, et les relevés que
# la machine rend d'elle-même.
set -euo pipefail
export LC_ALL=C.UTF-8

usage() {
  cat <<'USAGE'
usage: prove <phase>

  build       sources → lab-app puis candidat construit et installé
              (délégué à tests/lab/v0.1.3/controller-install/prove)
  perimeter   monte le périmètre d'accès personnel sur lab-machine-1
              (délégué à tests/lab/v0.1.0/personal-access/prove)
  journey     le parcours à l'écran sur le compte Debian NON PRÉPARÉ :
              deux consentements, jusqu'au Controller actif
  constats    relevés indépendants sur la cible, par des outils qui ne sont
              pas le produit
  remove      rend la cible à son état initial et asserte l'absence
  all         tout, dans cet ordre, remove garanti rouge ou vert
USAGE
}

command=${1:-all}
[[ $# -eq 0 ]] || shift
case "$command" in
  build | perimeter | journey | constats | remove | all) ;;
  *) usage; exit 2 ;;
esac

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../../.." && pwd)
labctl="$root/tools/labctl"
model="$root/tests/lab/v0.1.3/controller-install"
personal_access="$root/tests/lab/v0.1.0/personal-access"
app_vm=lab-app
machine_vm=lab-machine-1
# Le MÊME répertoire distant que le harnais modèle : `inside` y attend son
# écran, son état d'App et sa sortie. Un second répertoire obligerait à
# recopier `inside`, donc à en tenir deux versions.
remote_harness=/root/your-cloud-lab-controller-install
# Le compte que l'installateur Debian produit. Son nom vient du périmètre
# d'accès personnel, qui le monte ; il n'est pas inventé ici.
account=ycpasudg
# Le fichier local qui porte le secret de contrôle le temps du relevé.
secret_local=$(mktemp)
trap 'rm -f "$secret_local"' EXIT

announce() { printf '\n== %s\n' "$*"; }
fail() { echo "FAILED: $*" >&2; exit 1; }

# La garde d'inventaire obligatoire : jamais de mutation sans relire ce que la
# machine est, et refuser tout ce qui n'est pas la topologie de ce dépôt.
inventory() {
  local name="$1" line
  line=$("$labctl" list --format=tsv | awk -F'\t' -v n="$name" '$1 == n') ||
    fail "labctl list n'a pas rendu $name"
  [[ -n "$line" ]] || fail "$name absente de l'inventaire"
  awk -F'\t' '{
    if ($2 != "running") { exit 1 }
    if ($5 != "quick") { exit 2 }
    if ($6 != "your-cloud/labctl") { exit 3 }
    print $3
  }' <<<"$line" || fail "$name n'est pas la VM attendue (état/topologie/origine)"
}

# La posture du compte, VÉRIFIÉE plutôt que supposée — c'est la prémisse de
# toute cette milestone, et une preuve qui la suppose ne prouve rien.
assert_unprepared() {
  announce "la posture du compte $account, vérifiée avant tout parcours"
  "$labctl" ssh "$machine_vm" -- "
set -e
id -nG $account | tr ' ' '\n' | grep -qx sudo \
  || { echo 'FAILED: $account n'\''est pas dans le groupe sudo' >&2; exit 1; }
ls /etc/sudoers.d/ | grep -q '$account\$' \
  && { echo 'FAILED: une ligne de sudoers a été écrite pour $account' >&2; exit 1; }
passwd -S $account | awk '\$2 != \"P\" { print \"FAILED: \" \$1 \" n'\''a pas de mot de passe\"; exit 1 }'
echo '  groupe sudo : oui — sudoers dédié : aucun — mot de passe : oui'
runuser -u $account -- env LC_ALL=C /usr/bin/sudo -N -n -l -l >/dev/null 2>&1 </dev/null \
  && { echo 'FAILED: la politique se lit SANS secret — ce n'\''est pas la posture visée' >&2; exit 1; }
echo '  le prévol non secret ne peut pas lire sa politique : c'\''est bien la posture de #218'"
}

require_pristine_target() {
  "$labctl" ssh "$machine_vm" -- "
set -e
if dpkg-query -W your-cloud-server >/dev/null 2>&1; then
  echo 'FAILED: your-cloud-server est déjà installé sur la cible' >&2
  exit 1
fi
rm -rf /home/$account/.your-cloud-bootstrap
echo '  la cible est vierge'"
}

do_build() { "$model/prove" sync && "$model/prove" build; }

do_perimeter() {
  inventory "$machine_vm" >/dev/null
  announce "périmètre d'accès personnel sur $machine_vm"
  "$personal_access/prove" setup
}

do_journey() {
  inventory "$app_vm" >/dev/null
  assert_unprepared
  require_pristine_target
  announce "le parcours à l'écran — compte $account, deux consentements"
  local machine_address host_key
  machine_address=$(inventory "$machine_vm")
  host_key=$("$labctl" ssh "$app_vm" -- \
    "ssh-keygen -lf /root/your-cloud-lab-personal-access/server-host-key.pub" | awk '{print $2}')
  [[ "$host_key" == SHA256:* ]] || fail "l'empreinte de la clé d'hôte est illisible : $host_key"
  local file
  "$labctl" ssh "$app_vm" -- "install -d -m 0700 $remote_harness"
  for file in run inside app-oracle.py; do
    "$labctl" copy-to "$app_vm" "$model/$file" "$remote_harness/$file" >/dev/null
    "$labctl" ssh "$app_vm" -- "chmod 0700 $remote_harness/$file"
  done
  # **`TARGET_SUDO_PASSWORD_FILE` est ce qui distingue cette preuve de celle du
  # palier `v0.1.3`**, et son absence a coûté deux passes. Le parcours du
  # palier prête un compte `NOPASSWD` : aucune fenêtre de mot de passe ne
  # s'ouvre, et l'oracle laisse l'option absente. Ici le compte est celui que
  # Debian crée, sa politique ne renonce à rien, et le produit DEMANDE le
  # secret — une feuille de cible qui ne le nomme pas laisse cette fenêtre sans
  # réponse jusqu'à ce que la session expire. Le fichier est celui que le
  # périmètre d'accès personnel écrit, jamais une valeur recopiée ici.
  "$labctl" ssh "$app_vm" -- "cat > $remote_harness/target.env <<TARGET
TARGET_HOST=ycpa-target.test
TARGET_PORT=22
TARGET_USERNAME=$account
TARGET_HOST_KEY=$host_key
TARGET_LISTEN=$machine_address:9443
TARGET_ALLOWED_SOURCE=192.168.240.9/32
TARGET_RELAY_ENDPOINT=192.168.240.9:8444
TARGET_SUDO_PASSWORD_FILE=/root/lab-personal-access/needle/sudo-password
TARGET"
  "$labctl" ssh "$app_vm" -- "$remote_harness/run journey"
}

do_constats() {
  inventory "$machine_vm" >/dev/null
  announce "les relevés indépendants sur $machine_vm"
  # Le secret synthétique du périmètre est déposé sur la CIBLE le temps de la
  # recherche, puis détruit : le chercher depuis le poste obligerait à le poser
  # sur une ligne de commande distante, c'est-à-dire à créer la fuite même que
  # ce relevé existe pour réfuter.
  "$labctl" ssh "$app_vm" -- 'cat /root/lab-personal-access/needle/sudo-password' \
    >"$secret_local"
  "$labctl" copy-to "$machine_vm" "$secret_local" /root/yc-controle-secret >/dev/null
  # Ce que la machine dit d'elle-même, par des outils qui ne sont pas le
  # produit. Un succès annoncé par la partie qui agit n'est pas un constat.
  "$labctl" ssh "$machine_vm" -- '
set -e
echo "--- le paquet, vu par dpkg ---"
dpkg -l your-cloud-server | tail -1
echo "--- l unite, vue par systemd ---"
systemctl is-enabled your-cloud-controller
systemctl is-active your-cloud-controller
echo "--- le repertoire d attente : dette CONNUE, nommee et non masquee ---"
# Une pose reussie laisse son repertoire d attente : c est le defaut n°156,
# ouvert et suivi. Ce releve le NOMME au lieu d echouer dessus — echouer
# ferait porter a cette preuve un defaut qui a deja son issue, et le masquer
# ferait mentir le rapport. Ce qui reste exige est ailleurs, ci-dessous.
if [ -d /home/ycpasudg/.your-cloud-bootstrap ]; then
  echo "  DETTE n°156 — repertoire d attente survivant :"
  ls -la /home/ycpasudg/.your-cloud-bootstrap | tail -n +2 | sed "s/^/    /"
else
  echo "  aucun repertoire d attente (n°156 serait donc corrigee)"
fi
echo "--- ce qui reste EXIGE : aucun secret survivant ---"
# Le mot de passe sudo a voyage deux fois pendant ce parcours. Rien de ce que
# la cible conserve ne doit le porter. Le temoin de controle vient d abord :
# une recherche qui ne trouve pas son propre secret la ou il EST ne prouve
# rien de son absence ailleurs.
secret=$(cat /root/yc-controle-secret)
[ -n "$secret" ] || { echo "FAILED: le secret de controle est vide" >&2; exit 1; }
grep -qF "$secret" /root/yc-controle-secret \
  || { echo "FAILED: la recherche ne trouve pas le secret la ou il est — temoin casse" >&2; exit 1; }
echo "  temoin : la recherche trouve bien le secret quand il est present"
if grep -rqF "$secret" /home/ycpasudg /etc/your-cloud /var/lib/private 2>/dev/null; then
  echo "FAILED: le mot de passe sudo survit sur la cible" >&2; exit 1
fi
echo "  le mot de passe sudo n est nulle part sous les chemins du parcours"
echo "CONSTATS_OK"'
  "$labctl" ssh "$machine_vm" -- 'rm -f /root/yc-controle-secret'
  rm -f "$secret_local"
}

do_remove() {
  announce "la cible rendue à son état initial"
  "$labctl" ssh "$machine_vm" -- "
set -e
if dpkg-query -W your-cloud-server >/dev/null 2>&1; then
  systemctl stop your-cloud-controller 2>/dev/null || true
  systemctl disable your-cloud-controller 2>/dev/null || true
  dpkg --purge your-cloud-server
fi
rm -rf /home/$account/.your-cloud-bootstrap /etc/your-cloud /var/lib/private/your-cloud-controller
dpkg-query -W your-cloud-server >/dev/null 2>&1 \
  && { echo 'FAILED: le paquet survit au démontage' >&2; exit 1; }
echo 'REMOVE_TARGET_OK'"
}

case "$command" in
  build) do_build ;;
  perimeter) do_perimeter ;;
  journey) do_journey ;;
  constats) do_constats ;;
  remove) do_remove ;;
  all)
    status=0
    # Le sous-shell est une instruction NUE, encadrée de `set +e` : à gauche
    # d'un `||`, `errexit` serait supprimé jusqu'à l'intérieur, et une phase
    # rouge n'arrêterait pas les suivantes. Mesuré le 22 août 2026 sur le
    # pilote des bornes d'enrôlement.
    set +e
    (
      set -e
      do_perimeter
      do_journey
      do_constats
    )
    status=$?
    set -e
    do_remove || status=$?
    [[ $status -eq 0 ]] || exit "$status"
    echo
    echo "PROVE_UNPREPARED_INSTALL_OK compte=$account consentements=2"
    ;;
esac
