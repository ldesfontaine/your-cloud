[Unit]
Description=Your Cloud Controller
Documentation=https://github.com/ldesfontaine/your-cloud
After=network-online.target
Wants=network-online.target

[Service]
# `notify` : « actif » est une déclaration du service — émise par `serve` une
# fois ses écouteurs liés — jamais un instantané pris pendant qu'un démarrage
# qui va échouer ne l'a pas encore fait. Un `serve` qui refuse sa
# configuration sort avant de déclarer : `systemctl start` échoue, et le
# constat d'activation de l'Assistant lit un état vrai (#153).
Type=notify
# The account is allocated by systemd for the lifetime of the service. No
# persistent account with a shell, a password or a home is ever created, and
# the Daemon's and the Relay's units name different ones.
DynamicUser=yes
User=your-cloud-controller
StateDirectory=your-cloud-controller
StateDirectoryMode=0700
RuntimeDirectory=your-cloud-controller
RuntimeDirectoryMode=0700
UMask=0077
# Machine-specific, non-secret, root-owned and written by the Assistant. The
# package carries no configuration of its own: this file is what makes the same
# package usable on any machine without the package knowing any of them.
EnvironmentFile=/etc/your-cloud/controller.env
# The operational keys stay root-owned on disk and are handed to this one
# service at start. They never travel through the command line, the environment
# or the App. The Controller's own identity is required hard: it is minted
# by a named act of the approved plan, before the first activation, and a
# Controller without it is not a Controller.
LoadCredential=controller-reader.crt:/etc/your-cloud/controller-credentials/controller-reader.crt
LoadCredential=controller-reader.key:/etc/your-cloud/controller-credentials/controller-reader.key
# The Relay anchor arrives through the same directory pattern as the command
# sheets below: on a freshly created infrastructure no Relay exists yet, the
# directory is empty, and an empty directory source loads zero credentials
# without failing — which is the true state, not a tolerance. The journey that
# poses a Relay deposits `relay-reader-ca.crt` here; a service restart picks it
# up. Nothing is durably optional: the reader is dormant exactly while its
# component is absent.
LoadCredential=relay-anchor:/etc/your-cloud/relay-anchor
# The command identities and the endpoint sheets, one entry per machine inside
# two directories. Directories rather than a line per machine because the
# package is what delivers this unit and the package knows no machine: a unit
# naming sixty-four of them would carry machine-specific configuration, which
# this package never does. Each entry is named by a machine identifier, copied
# into the service's private credential directory at start, and gone with it.
# The private half of an identity never leaves this Controller and enters no
# document, report, observation or process argument.
LoadCredential=command-identities:/etc/your-cloud/command-identities
LoadCredential=command-endpoints:/etc/your-cloud/command-endpoints
ExecStart=/usr/lib/your-cloud/your-cloud controller serve -state-dir=/var/lib/private/your-cloud-controller -listen=${CONTROLLER_LISTEN} -allowed-source=${CONTROLLER_ALLOWED_SOURCE} -relay-endpoint=${CONTROLLER_RELAY_ENDPOINT}
# The Controller is what must still be there when the laptop is closed, so it
# restarts on failure rather than waiting for someone to notice.
Restart=on-failure
RestartSec=1s
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# The budgets. They are here rather than in a drop-in so that the package
# delivers them and the LAB can read them back off the running service.
TasksMax=128
MemoryMax=384M

[Install]
WantedBy=multi-user.target
