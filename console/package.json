{
  "name": "your-cloud-console",
  "private": true,
  "version": "0.1.4",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "build:reflow-fixture": "vite build --config tests/reflow/vite.config.ts",
    "build:native-assistant": "node tools/prepare-native-bootstrap-assistant.mjs release",
    "build:native-assistant:dev": "node tools/prepare-native-bootstrap-assistant.mjs debug",
    "build:server-bundle": "node tools/prepare-server-bundle.mjs",
    "check:source": "node tests/check-source-contract.mjs",
    "check:visual": "node tests/check-visual-contract.mjs",
    "dev": "vite",
    "test": "npm run check:source && npm run check:visual",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/inter": "5.2.8",
    "@tauri-apps/api": "2.11.1",
    "lucide-react": "1.25.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  }
}
