{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Your Cloud",
  "version": "0.0.3",
  "identifier": "fr.your-cloud.console",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Your Cloud",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "capabilities": ["main-capability"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "shortDescription": "Console cliente privée Your Cloud",
    "longDescription": "Console cliente installée pour consulter une infrastructure Your Cloud privée."
  }
}
